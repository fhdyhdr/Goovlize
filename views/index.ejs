function toggleSidebar(forceExpand) {
    const wrapper = document.getElementById("navbar-wrapper");
    const navbar = document.getElementById("navbar");
    const bottomControls = document.getElementById(
      "navbar-bottom-controls"
    );
    const icon = document.querySelector(".sidebar-toggle i");
    const emptyLibrary = document.querySelector(".empty-library-section");

    // Tambahkan transition
    wrapper.style.transition = "width 0.5s ease";
    navbar.style.transition = "width 0.5s ease";
    bottomControls.style.transition = "width 0.5s ease";

    sidebarExpanded =
      typeof forceExpand === "boolean" ? forceExpand : !sidebarExpanded;

    wrapper.classList.toggle("expanded", sidebarExpanded);
    navbar.classList.toggle("expanded", sidebarExpanded);
    bottomControls.classList.toggle("expanded", sidebarExpanded);

    wrapper.style.width = sidebarExpanded
      ? NAVBAR_MAX_WIDTH + "px"
      : NAVBAR_MIN_WIDTH + "px";
    navbar.style.width = sidebarExpanded
      ? NAVBAR_MAX_WIDTH + "px"
      : NAVBAR_MIN_WIDTH + "px";
    bottomControls.style.width = sidebarExpanded
      ? NAVBAR_MAX_WIDTH + "px"
      : NAVBAR_MIN_WIDTH + "px";

    icon.classList.toggle("fa-angle-double-left", sidebarExpanded);
    icon.classList.toggle("fa-angle-double-right", !sidebarExpanded);

    if (emptyLibrary) {
      if (sidebarExpanded) {
        setTimeout(() => {
          emptyLibrary.style.display = "flex";
        }, 350);
      } else {
        emptyLibrary.style.display = "none";
      }
    }

    saveState();
}

function loadSidebar(forceExpand) {
    const wrapper = document.getElementById("navbar-wrapper");
    const navbar = document.getElementById("navbar");
    const icon = document.querySelector(".sidebar-toggle i");
    const emptyLibrary = document.querySelector(".empty-library-section");

    sidebarExpanded =
      typeof forceExpand === "boolean" ? forceExpand : !sidebarExpanded;

    wrapper.classList.toggle("expanded", sidebarExpanded);
    navbar.classList.toggle("expanded", sidebarExpanded);
    wrapper.style.width = sidebarExpanded
      ? NAVBAR_MAX_WIDTH + "px"
      : NAVBAR_MIN_WIDTH + "px";

    icon.classList.toggle("fa-angle-double-left", sidebarExpanded);
    icon.classList.toggle("fa-angle-double-right", !sidebarExpanded);

    if (emptyLibrary) {
      if (sidebarExpanded) {
        emptyLibrary.style.display = "flex";
      } else {
        emptyLibrary.style.display = "none";
      }
    }

    saveState();
}

function setupNavbarResize() {
    const wrapper = document.getElementById("navbar-wrapper");

    wrapper.addEventListener("mousedown", function (e) {
      if (window.innerWidth <= 1160) return;
      if (e.offsetX > wrapper.offsetWidth - 15) {
        isResizingNavbar = true;
        startX = e.clientX;
        startWidth = wrapper.offsetWidth;
        document.addEventListener("mousemove", handleNavbarResize);
        document.addEventListener("mouseup", stopNavbarResize);
        e.preventDefault();
      }
    });

    function handleNavbarResize(e) {
      if (!isResizingNavbar) return;

      const delta = e.clientX - startX;
      const threshold = 50;

      if (delta > threshold && !sidebarExpanded) {
        toggleSidebar(true);
        stopNavbarResize();
      } else if (delta < -threshold && sidebarExpanded) {
        toggleSidebar(false);
        stopNavbarResize();
      }
    }

    function stopNavbarResize() {
      isResizingNavbar = false;
      document.removeEventListener("mousemove", handleNavbarResize);
      document.removeEventListener("mouseup", stopNavbarResize);
    }
}

function loadContentNav(forceExpand) {
    const nav = document.getElementById("content-navigator");
    const icon = document.querySelector(".library-toggle .library-icon");
    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    const isLandscape = window.matchMedia(
      "(orientation: landscape)"
    ).matches;
    const savedMusic = localStorage.getItem("currentlyPlaying_");

    // Jika forceExpand tidak ditentukan, tentukan berdasarkan kondisi default
    if (typeof forceExpand !== "boolean") {
      // Default behavior: expanded jika mobile landscape dengan musik
      forceExpand = isMobile && isLandscape && savedMusic;
    }

    contentNavExpanded = forceExpand;
    let targetWidth = isMobile ? 200 : 280;

    if (contentNavExpanded) {
      nav.classList.remove("collapsed");
      nav.style.width = contentNavWidth + "px" || targetWidth + "px";
      nav.style.minWidth = targetWidth + "px";
      nav.style.transform = "translateX(0)";
    } else {
      nav.classList.add("collapsed");
      nav.style.width = "0";
      nav.style.transform = "translateX(-100%)";
    }

    icon.style.opacity = contentNavExpanded ? "1" : "0.7";
    saveState();
}

let userHasManuallyToggled = false;
function toggleContentNav(forceExpand) {
    userHasManuallyToggled = true;
    const nav = document.getElementById("content-navigator");
    const icon = document.querySelector(".library-toggle .library-icon");
    const contentArea = document.getElementById("content-area");

    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    const targetWidth = isMobile ? 200 : 280;

    contentNavExpanded =
      typeof forceExpand === "boolean" ? forceExpand : !contentNavExpanded;

    // CSS untuk transisi konten utama
    contentArea.style.flex = "1";
    contentArea.style.transition =
      "margin-left 0.5s cubic-bezier(0.2, 0.8, 0.4, 1)";
    contentArea.style.willChange = "margin-left";

    if (contentNavExpanded) {
      nav.classList.remove("collapsed");
      nav.style.width = contentNavWidth + "px";
      nav.style.minWidth = targetWidth + "px";
      nav.style.transform = "translateX(0)";
      contentNavWidth = targetWidth;
    } else {
      contentNavWidth = parseInt(nav.style.width) || targetWidth;
      nav.classList.add("collapsed");
      nav.style.width = "0";
      nav.style.transform = "translateX(-100%)";
    }

    icon.style.opacity = contentNavExpanded ? "1" : "0.7";

    saveState();
}

function setupContentNavResize() {
    const nav = document.getElementById("content-navigator");

    nav.addEventListener("mousedown", function (e) {
      if (e.offsetX > nav.offsetWidth - 15) {
        isResizingContentNav = true;
        startX = e.clientX;
        startWidth = nav.offsetWidth;
        document.addEventListener("mousemove", handleContentNavResize);
        document.addEventListener("mouseup", stopContentNavResize);
        e.preventDefault();
      }
    });

    function handleContentNavResize(e) {
      if (!isResizingContentNav) return;

      const newWidth = startWidth + (e.clientX - startX);

      if (
        newWidth < CONTENT_NAV_MIN_WIDTH - CLOSE_THRESHOLD &&
        contentNavExpanded
      ) {
        toggleContentNav(false);
        stopContentNavResize();
      } else if (
        newWidth >= CONTENT_NAV_MIN_WIDTH &&
        newWidth <= CONTENT_NAV_MAX_WIDTH
      ) {
        nav.style.width = newWidth + "px";
        contentNavWidth = newWidth;
      }
    }

    function stopContentNavResize() {
      isResizingContentNav = false;
      document.removeEventListener("mousemove", handleContentNavResize);
      document.removeEventListener("mouseup", stopContentNavResize);

      const nav = document.getElementById("content-navigator");
      const currentWidth = parseInt(nav.style.width);

      if (currentWidth < CONTENT_NAV_MIN_WIDTH) {
        nav.style.width = CONTENT_NAV_MIN_WIDTH + "px";
        contentNavWidth = CONTENT_NAV_MIN_WIDTH;
      } else {
        contentNavWidth = currentWidth;
      }

      saveState();
    }
}

function toggle() {
    const itemsContainer = document.getElementById("direct-messages-items");
    const toggleButton = document.getElementById(
      "direct-messages-add-button"
    );
    const userInfos = document.querySelectorAll(
      ".direct-messages-item-user-info"
    );

    // Cek apakah tombol ada (hanya ada jika ada items)
    if (!toggleButton) return;

    viewMode = (viewMode + 1) % 3;

    // Reset all classes first
    itemsContainer.classList.remove("grid-view", "compact-view");
    userInfos.forEach((info) => (info.style.display = ""));

    if (viewMode === 0) {
      // List View (default)
      toggleButton.innerHTML =
        '<i class="fa-solid fa-list"></i><div class="tooltip top"><p>Grid View</p></div>';
    } else if (viewMode === 1) {
      // Grid View with info
      itemsContainer.classList.add("grid-view");
      toggleButton.innerHTML =
        '<i class="fa-solid fa-border-all"></i><div class="tooltip top"><p>Compact View</p></div>';
    } else if (viewMode === 2) {
      // Grid View Compact (tanpa info)
      itemsContainer.classList.add("grid-view", "compact-view");
      userInfos.forEach((info) => (info.style.display = "none"));
      toggleButton.innerHTML =
        '<i class="fa-solid fa-grip"></i><div class="tooltip top"><p>List View</p></div>';
    }

    saveState();
}

