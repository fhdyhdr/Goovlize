    <style>
  
      #active-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #101010;
        overflow-y: auto;
      }

      #content-area {
        flex: 1;
        overflow: hidden; 
        position: relative; 
        position: static;
      }

      .main-content {
        color: white;
        flex: 1;
        position: relative;
      }





      @media only screen and (orientation: landscape) {


        :root[style*="--device: mobile"] #active-content {
          height: 100vh;
        }

        
        :root[style*="--device: mobile"] #content-area {
            border-radius: 8px;
            margin-top: 10px;
        }

      }


   

    
    :root[style*="--device: desktop"] #active-content {
          height: 100vh;
        }

    :root[style*="--device: desktop"]      
        #active-content.player-visible {
          height: calc(100vh - 60px);

        }

      @media (min-width: 769px) {
        #header {
          position: sticky;
          top: 0;
          z-index: 100;
        }
 

        :root[style*="--device: mobile"]
          #content-navigator.collapsed
          ~ #content-area {
          margin-left: -200px !important;
        }

        :root[style*="--device: desktop"]
          #content-navigator.collapsed
          ~ #content-area {
          margin-left: -280px !important;
        }

        #content-navigator.no-transition {
          transition: none !important;
        }

      .nav-icons {
        margin-left: 50px;
      }


      
      }

      

      @media (max-width: 768px) {
        #content-navigator {
          display: none;
        }
        #content-area {
          margin-left: 0 !important;
        }
        #header {
          position: relative;
        }
        .page_home {
          padding: 20px;
        }

        .carousel__headline {
          font-size: 1.1em;
          letter-spacing: 0.7px;
        }

        .homeContent .svg-circle-wrapper {
          width: 40px;
          height: 40px;
          bottom: 15px;
        }

        .homeContent .svg-circle-wrapper .svg-icon {
          width: 25px;
          height: 25px;
        }

        .summary__img.custom_img {
          width: 180px !important;
          height: 180px !important;
        }

        #active-content {
          padding-bottom: 70px;
        }

        #active-content.player-visible {
           padding-bottom: 120px;
        }

        .bottom-navbar {
          display: flex !important;
        }

      }

        :root[style*="--device: mobile"] #navbar-wrapper{
          display: none;
        }



       @media only screen and (orientation: landscape) {

