// Fungsi untuk toggle loader show/hide
function toggleLoaderShow() {
  const isLoaderEnabled = localStorage.getItem('loaderEnabled');
  const newState = isLoaderEnabled === 'false' ? 'true' : 'false';
  
  localStorage.setItem('loaderEnabled', newState);
  updateToggleButton();
}

// Fungsi untuk update tampilan tombol
function updateToggleButton() {
  const btn = document.getElementById('toggleLoaderBtn');
  if (!btn) return;
  
  const isLoaderEnabled = localStorage.getItem('loaderEnabled') !== 'false';
  
  if (isLoaderEnabled) {
    btn.classList.add('active');
    btn.classList.remove('inactive');
    btn.title = 'Loader aktif - Klik untuk mematikan';
  } else {
    btn.classList.add('inactive');
    btn.classList.remove('active');
    btn.title = 'Loader mati - Klik untuk mengaktifkan';
  }
}

// Fungsi untuk memeriksa apakah loader boleh ditampilkan
function canShowLoader() {
  return localStorage.getItem('loaderEnabled') !== 'false';
}

// Fungsi helper untuk show/hide loader
function showLoaderIfEnabled() {
  if (canShowLoader()) {
    $(".loader").show();
  }
}

function hideLoaderIfEnabled() {
  if (canShowLoader()) {
    $(".loader").hide();
  }
}

// Fungsi untuk memastikan toggle button ada
function ensureToggleButtonExists() {
  const header = document.getElementById("direct-messages-header");
  if (!header) return;
  
  // Cari placeholder yang dibuat oleh template EJS
  const placeholder = header.querySelector('div[style*="width: 40px"]');
  
  // Jika ada placeholder, ganti dengan button
  if (placeholder) {
    const toggleButton = document.createElement("button");
    toggleButton.id = "direct-messages-add-button";
    toggleButton.onclick = toggle;
    
    // Set icon berdasarkan viewMode saat ini
    const currentViewMode = viewMode || 0;
    if (currentViewMode === 0) {
      toggleButton.innerHTML = '<i class="fa-solid fa-list"></i><div class="tooltip top"><p>Grid View</p></div>';
    } else if (currentViewMode === 1) {
      toggleButton.innerHTML = '<i class="fa-solid fa-border-all"></i><div class="tooltip top"><p>Compact View</p></div>';
    } else if (currentViewMode === 2) {
      toggleButton.innerHTML = '<i class="fa-solid fa-grip"></i><div class="tooltip top"><p>List View</p></div>';
    }
    
    // Ganti placeholder dengan button
    placeholder.parentNode.replaceChild(toggleButton, placeholder);
  }
  
  // Pastikan button ditampilkan
  const toggleButton = document.getElementById("direct-messages-add-button");
  if (toggleButton) {
    toggleButton.style.display = "flex";
  }
}
