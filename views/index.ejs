document.addEventListener('DOMContentLoaded', function() {
    // Elements
    const filterButtons = document.querySelectorAll('.filter-button:not(.search-filter-button)');
    const searchFilterButton = document.querySelector('.search-filter-button');
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const libraryItems = document.querySelectorAll('.direct-messages-item');
    const searchInput = document.getElementById('library-search-input');
    const STORAGE_KEY = 'libraryFilterState';
    
    // State
    let currentFilter = localStorage.getItem(STORAGE_KEY) || 'all';
    let isSearching = false;

    // Fuzzy match function
    function fuzzyMatch(search, target) {
        search = search.toLowerCase();
        target = target.toLowerCase();
        
        if (search === '') return true;
        if (target.includes(search)) return true;
        
        let searchIndex = 0;
        for (let i = 0; i < target.length; i++) {
            if (target[i] === search[searchIndex]) {
                searchIndex++;
                if (searchIndex === search.length) return true;
            }
        }
        return false;
    }

    function applyFilter(filterType) {
        currentFilter = filterType;
        isSearching = false;
        localStorage.setItem(STORAGE_KEY, filterType);
        applySearchAndFilter();

        // ✅ Tampilkan item yang baru ditambahkan jika filter cocok
        newlyAddedLibraryItems.forEach(item => {
            const itemType = item.dataset.filterType;
            item.style.display = (filterType === 'all' || filterType === itemType) ? 'flex' : 'none';
        });
    }

    // Apply search
    function applySearch() {
        const searchTerm = searchInput.value.trim();
        isSearching = searchTerm.length > 0;
        applySearchAndFilter();
    }

    // Combined filter and search - MODIFIED TO SHOW ALL TYPES DURING SEARCH
    function applySearchAndFilter() {
        const searchTerm = searchInput.value.trim();
        
        libraryItems.forEach(item => {
            const itemName = item.querySelector('.direct-messages-item-username').textContent;
            const itemType = item.dataset.filterType;
            
            // When searching, ignore current filter and show all matches
            if (isSearching) {
                item.style.display = fuzzyMatch(searchTerm, itemName) ? 'flex' : 'none';
            } 
            // When not searching, respect the current filter
            else {
                item.style.display = (currentFilter === 'all' || itemType === currentFilter) ? 'flex' : 'none';
            }
        });
        
        updateFilterUI();
    }

    function updateFilterUI() {
        if (isSearching) {
            filterButtons.forEach(btn => btn.style.display = 'none');
            searchFilterButton.style.display = 'inline-flex';
            searchFilterButton.classList.add('active');
        } else {
            filterButtons.forEach(btn => {
                btn.style.display = 'inline-flex';
                btn.classList.remove('active');
                if (btn.dataset.filter === currentFilter) {
                    btn.classList.add('active');
                }
            });
            searchFilterButton.style.display = 'none';
        }
    }

    function clearSearch() {
        searchInput.value = '';
        applyFilter(localStorage.getItem(STORAGE_KEY) || 'all');
    }

    // Initialize
    applyFilter(currentFilter);
    
    // Event listeners
    filterButtons.forEach(button => {
        button.addEventListener('click', () => applyFilter(button.dataset.filter));
    });
    
    searchFilterButton.addEventListener('click', clearSearch);
    clearSearchBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        clearSearch();
    });
    
    let searchTimeout;
    searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(applySearch, 300);
    });
    
    console.log('Library search initialized. Current filter:', currentFilter);
});

