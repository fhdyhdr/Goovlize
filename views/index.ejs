<script>
window.addEventListener("DOMContentLoaded", () => {
    const savedMusic = localStorage.getItem("currentlyPlaying_");
    const userControl = document.getElementById("current-user-control");
    const navbarBottomControls = document.querySelector(
      ':root[style*="--device: desktop"] #navbar-bottom-controls'
    );
    const navbar = document.querySelector(
      ':root[style*="--device: desktop"] #navbar'
    );
    const librarytoggle = document.querySelector(
      ':root[style*="--device: desktop"] .library-toggle'
    );

    if (savedMusic) {
      if (userControl) userControl.style.bottom = "80px";
      if (navbarBottomControls) navbarBottomControls.style.bottom = "80px";
      if (navbar) navbar.style.height = "calc(100% - 230px)";
      if (librarytoggle) librarytoggle.style.marginBottom = "40px";
    } else {
      if (userControl) userControl.style.bottom = "0";
      if (navbarBottomControls) navbarBottomControls.style.bottom = "0";
      if (navbar) navbar.style.height = "calc(100% - 110px)";
    }
});

// Tambahkan event listener untuk menangani perubahan ukuran layar
window.addEventListener("resize", () => {
    const savedMusic = localStorage.getItem("currentlyPlaying_");
    const contentLoader = document.querySelector(".main-content .loader");

    if (savedMusic && contentLoader) {
      if (window.matchMedia("(max-width: 768px)").matches) {
        contentLoader.style.top = "-110px";
      } else {
        contentLoader.style.top = "0"; // Kembalikan ke default jika lebar layar >= 400px
      }
    }
});

document.addEventListener("DOMContentLoaded", function () {
    loadStartTime = Date.now();

    loadState();

    // Start checking when everything is loaded
    if (document.readyState === "complete") {
      handlePageLoad();
    } else {
      window.addEventListener("load", handlePageLoad);
    }
});

let minimumLoadTime = 1000; // 1 second minimum load time
let loadStartTime = Date.now();

function handlePageLoad() {
    // Calculate remaining time to meet minimum load time
    const elapsed = Date.now() - loadStartTime;
    const remaining = Math.max(0, minimumLoadTime - elapsed);

    // Hide loaders after the remaining time or when everything is loaded
    setTimeout(() => {
      // Hide full page loader
      const fullPageLoader = document.getElementById("full-page-loader");
      if (fullPageLoader) {
        fullPageLoader.style.opacity = "0";
        setTimeout(() => {
          fullPageLoader.style.display = "none";
        }, 500); // Match the transition duration
      }

      document.body.classList.remove("preload");
      const contentNav = document.getElementById("content-navigator");
      const activeContent = document.getElementById("active-content");
      const contentArea = document.getElementById("content-area");

      if (contentNav) contentNav.classList.remove("no-transition");
      if (activeContent) activeContent.classList.remove("no-transition");
      if (contentArea) contentArea.classList.remove("no-transition");
    }, remaining);
}

const NAVBAR_MIN_WIDTH = 72;
const NAVBAR_MAX_WIDTH = 280;
const CONTENT_NAV_MIN_WIDTH = 180;
const CONTENT_NAV_MAX_WIDTH = 400;
const CLOSE_THRESHOLD = 30;
const STORAGE_KEY = "discordSideNavState";
const newlyAddedLibraryItems = []; // Untuk simpan item baru

let activeContent = "Home";
let sidebarExpanded = true; // Default navbar terbuka
let contentNavExpanded = false; // Default content-navigator tertutup
let contentNavWidth = 280;
let isResizingNavbar = false;
let isResizingContentNav = false;
let isGridView = false;
let startX, startWidth;
let viewMode = 0; // 0 = list view, 1 = grid view with info, 2 = grid view without info

function saveState() {
    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

    const state = {
      sidebarExpanded,
      contentNavExpanded,
      contentNavWidth:
        parseInt(
          document.getElementById("content-navigator").style.width
        ) || (isMobile ? 200 : 280),
      viewMode,
      userHasManuallyToggled, // Simpan state interaksi user
    };

    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

function loadState() {
    const savedState = localStorage.getItem(STORAGE_KEY);
    if (savedState) {
      const state = JSON.parse(savedState);
      userHasManuallyToggled = state.userHasManuallyToggled || false;
      sidebarExpanded =
        state.sidebarExpanded !== undefined ? state.sidebarExpanded : false;
      contentNavExpanded =
        state.contentNavExpanded !== undefined
          ? state.contentNavExpanded
          : true;
      contentNavWidth = state.contentNavWidth || 280;
      viewMode = state.viewMode !== undefined ? state.viewMode : 0;

      updateActiveNavItems();
      loadSidebar(sidebarExpanded);
      loadContentNav(contentNavExpanded);
      document.getElementById("content-navigator").style.width =
        contentNavWidth + "px";

      const itemsContainer = document.getElementById(
        "direct-messages-items"
      );
      const toggleButton = document.getElementById(
        "direct-messages-add-button"
      );
      const userInfos = document.querySelectorAll(
        ".direct-messages-item-user-info"
      );

      // Hanya update jika ada tombol (ada items)
      if (toggleButton) {
        // Reset all classes first
        itemsContainer.classList.remove("grid-view", "compact-view");
        userInfos.forEach((info) => (info.style.display = ""));

        if (viewMode === 0) {
          toggleButton.innerHTML =
            '<i class="fa-solid fa-list"></i><div class="tooltip top"><p>Grid View</p></div>';
        } else if (viewMode === 1) {
          itemsContainer.classList.add("grid-view");
          toggleButton.innerHTML =
            '<i class="fa-solid fa-border-all"></i><div class="tooltip top"><p>Compact View</p></div>';
        } else if (viewMode === 2) {
          itemsContainer.classList.add("grid-view", "compact-view");
          userInfos.forEach((info) => (info.style.display = "none"));
          toggleButton.innerHTML =
            '<i class="fa-solid fa-grip"></i><div class="tooltip top"><p>List View</p></div>';
        }
      }
    } else {
      updateActiveNavItems();
      loadSidebar(true); // Navbar default terbuka
      loadContentNav(false); // Content navigator default tertutup
      var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
      if (isMobile) {
        document.getElementById("content-navigator").style.width = "200px";
      } else {
        document.getElementById("content-navigator").style.width = "280px";
      }
    }
}

function setActiveContent(contentId) {
  // Simpan state tombol sebelumnya sebelum berubah
  if (activeContent !== contentId) {
    previousActiveContent = activeContent;
  }

  activeContent = contentId;
  updateActiveNavItems();
  saveState();
}

function updateActiveNavItems() {
  document.querySelectorAll(".navbar-item").forEach((item) => {
    item.classList.remove("active");
    const onclickAttr = item.getAttribute("onclick");
    if (onclickAttr && onclickAttr.includes(`'${activeContent}'`)) {
      item.classList.add("active");
    }
  });
}

