<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sign in & Sign up Form</title>
    <link rel="stylesheet" href="/css/login.css" />
    <link href='https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css' rel='stylesheet'>
    <script src="/js/login.js" defer></script>
  </head>
  <body>
    <main>
      <div class="box">
        <div class="inner-box">
          <div class="forms-wrap">
            <form onsubmit="return validateLogin()" action="" method="POST" autocomplete="" class="sign-in-form">
              <div class="logo">
                <img src="/uploads/goovlize.jpeg"  alt="easyclass" />
                <h4>Goovlize</h4>
              </div>

              <div class="heading">
                <h2>Welcome Back</h2>
              </div>

              <div style="display: none;" id="alert-container"></div>


              <div class="actual-form">
                <div class="input-wrap">
                  <input
                    type="text"
                    class="input-field email-input"
                    autocomplete="off"
                    name="email"
                  />
                  <label>Email</label>


              

                </div>

                <div class="input-wrap">
                  <input
                    type="password"
                    class="input-field password-input"
                    autocomplete="off"
                    name="password"
                  />
                  <label>Password</label>

                  <i class='bx bx-hide eye-icon' onclick="togglePassword()"></i>
                </div>

                <input type="submit" value="Sign In" class="sign-btn" />


                <div class="google-login-button" onclick="window.location.href='/auth/google'">
                  <svg class="google-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12
                      c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4
                      C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039
                      l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36
                      c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571
                      l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                  </svg>
                  <span>Log in with Google</span>
                </div>
                
                



                <div class="heading btm">
                  <h6>Not registred yet?</h6>
                  <a href="#" class="toggle">Sign up</a>
                </div>
          

             



                <p class="text">
                  Trouble signing in? <a href="/forgot">Reset your password</a>
                </p>
                

       


              </div>
            </form>

            <form id="registerForm" onsubmit="return validateRegister()" autocomplete="" class="sign-up-form">
              <div class="logo">
                <img src="/uploads/goovlize.jpeg" alt="easyclass" />
                <h4>Goovlize</h4>
              </div>

              <div class="heading">
                <h2>Get Started</h2>
              </div>

              <div style="display: none;" id="danger-alert"></div>

              <div class="actual-form">
                <div class="input-wrap">
                  <input
                    type="text"
                    name="username"
                    class="input-field username-input"
                    autocomplete="off"
                 
                  />
                  <label>Name</label>
                </div>

                <div class="input-wrap">
                  <input
                    type="text"
                    name="email"
                    class="input-field email2-input"
                    autocomplete="off"
         
                  />
                  <label>Email</label>
                </div>

                <div class="input-wrap">
                  <input
                    type="password"
                    name="password"
                    class="input-field password2-input"
                    autocomplete="off"
              
                  />
                  <label>Password</label>

                  <i class='bx bx-hide eye-icon' onclick="togglePassword()"></i>
                  
                </div>

                <input type="submit" value="Sign Up" class="sign-btn" />

                
                <div class="google-login-button" onclick="window.location.href='/auth/google'">
                  <svg class="google-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12
                      c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4
                      C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039
                      l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36
                      c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571
                      l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                  </svg>
                  <span>Log in with Google</span>
                </div>

                <div class="heading btm">
                  <h6>Already have an account?</h6>
                <a href="#" class="toggle">Sign in</a>
                </div>

                <p class="text">
                  By signing up, I agree to the
                  <a href="#">Terms of Services</a> and
                  <a href="#">Privacy Policy</a>
                </p>
              </div>
            </form>
          </div>

          <div class="carousel">
            <div class="images-wrapper">
              <img src="/uploads/slide1.gif" class="image img-1 show" alt="" />
            </div>

       
          </div>
        </div>
      </div>
    </main>

  </body>
</html>
