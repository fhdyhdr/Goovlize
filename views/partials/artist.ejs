<!DOCTYPE html>
<html lang="en">
  <head>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta charset="UTF-8" />
    <title>Music Player Redesign</title>
    <link rel="stylesheet" href="/css/n.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      /* Styles sama seperti playlist */
      .dropdown-container {
        position: relative;
        display: inline-block;
      }
      .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background-color: #2a292f;
        min-width: 180px;
        z-index: 1;
        border-radius: 6px;
      }
      .dropdown-content a {
        color: #fff;
        padding: 10px 14px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
      }
      .dropdown-content i {
        font-size: 15px;
      }
      .dropdown-content a:hover {
        background-color: #1b1b1b;
      }
      .show {
        display: block;
      }
      .dropdown-submenu {
        position: relative;
      }
      .dropdown-submenu > a {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        color: #fff;
        font-size: 14px;
        gap: 10px;
      }
      .dropdown-submenu > a:hover {
        background-color: #1b1b1b;
      }
      .arrow {
        margin-left: auto;
        font-size: 20px;
        opacity: 0.7;
      }
      .submenu-content {
        display: none;
        position: absolute;
        top: 0;
        right: 100%;
        background-color: #37353e;
        min-width: 160px;
        border-radius: 6px;
        z-index: 2;
      }
      .submenu-content a {
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #fff;
        font-size: 14px;
      }
      .submenu-content a:hover {
        background-color: #1b1b1b;
      }
      .dropdown-submenu:hover .submenu-content {
        display: block;
      }
      .playlist-name {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2em;
        max-height: calc(1.2em * 3);
      }

      /* PERBAIKAN: Track album hover area */
      .track-album {
        font-size: 0.875rem;
        color: var(--text_muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: left;
        position: relative;
        display: block; /* PERUBAHAN: dari inline-block ke block */
        cursor: pointer;
        width: 100%; /* PERUBAHAN: agar memenuhi container */
      }

      /* Hover hanya pada teks, bukan seluruh area */
      :root[style*="--device: desktop"] .track-album:hover {
        text-decoration: underline;
      }

      /* PERBAIKAN: Container untuk track-album agar benar-benar rata kiri */
      .track-album-container {
        flex: 1;
        display: block; /* PERUBAHAN: dari flex ke block */
        padding: 0 1rem;
        text-align: left; /* PERUBAHAN: pastikan rata kiri */
        min-width: 0; /* PERUBAHAN: penting untuk text ellipsis */
      }

      /* PERBAIKAN: Track number dengan width tetap untuk alignment */
      .track-number {
        margin-right: 10px;
        min-width: 25px; /* PERUBAHAN: Lebar sedikit lebih besar untuk angka 2 digit */
        text-align: center;
        display: inline-block;
        font-variant-numeric: tabular-nums; /* Agar angka memiliki lebar yang konsisten */
        flex-shrink: 0; /* PERUBAHAN: agar tidak mengecil */
      }

      .banner-artist .banner-img-container {
        border-radius: 50%;
        width: clamp(160px, 20cqi, 279px);
        height: clamp(160px, 20cqi, 279px);
      }
      
      
      .banner-artist .banner-img-container img {
        border-radius: 50%;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }









      



#btn-message {
  --text-color: rgb(255, 255, 255);
  --bg-color-sup: #404040;
  --bg-color: linear-gradient(135deg, #2c3e50 0%, #34495e 50%, #2c3e50 100%);
  --bg-hover-color: linear-gradient(135deg, #34495e 0%, #2c3e50 50%, #34495e 100%);
  --online-status: #1abc9c;
  --font-size: 16px;
  --btn-transition: all 0.3s ease-out;
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.button-message {
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 2.17382px rgba(0,0,0,.049),0 1.75px 6.01034px rgba(0,0,0,.07),0 3.63px 14.4706px rgba(0,0,0,.091),0 22px 48px rgba(0,0,0,.14);
  background-color: var(--bg-color);
  border-radius: 68px;
  cursor: pointer;
  width: fit-content;
  border: 0;
  overflow: hidden;
  position: relative;
}

.button-message:active {
  transform: scale(0.99);
}

.content-avatar {
  margin: 0;
  transition: var(--btn-transition);
  position: relative;
}


.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--bg-color-sup);
}

.user-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.status-user {
  position: absolute;
  width: 6px;
  height: 6px;
  right: 1px;
  bottom: 1px;
  border-radius: 50%;
  outline: solid 2px var(--bg-color);
  background-color: var(--online-status);
  transition: var(--btn-transition);
}

.notice-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 0 11px;
  text-align: initial;
  color: var(--text-color);
}




@container music-container (min-width: 0) {



.button-message {
  padding: clamp(4px, 1cqi, 8px) clamp(6px, 2cqi, 10px);
  height: clamp(48px, 5cqi, 55px);
}

.content-avatar {
  width: clamp(15px, 5cqi, 40px);
  height: clamp(15px, 5cqi, 40px);
}

.lable-message {
  font-size: clamp(0.85em, 1cqi, 1.2em);
}


}

      @media only screen and (orientation: landscape) {
        :root[style*="--device: mobile"] .banner-text-content {
          gap: clamp(0.01rem, 0.4cqi, 1rem);
        }
      }


    </style>
  </head>
  <body>
    <header class="playlist-header artist-head">
      <div class="header-content">
        <button class="back-button" onclick="backLeft()">
        <i class="fa-solid fa-circle-chevron-left"></i>
        </button>

        <div class="header-text-container">
        <h1 class="header-title"><%= artist.artist_name %></h1>
        <p class="header-subtitle muted">Artist</p>
        </div>
      </div>
    </header>

    <div class="banner">
      <div class="banner-img-wrapper banner-artist">
        <div class="nav-icons">
          <i onclick="backLeft()" class="fa-solid fa-circle-chevron-left"></i>
          <i onclick="backRight()" class="fa-solid fa-circle-chevron-right"></i>
        </div>

        <div class="banner-content">
          <div class="banner-img-container">
            <img
              src="<%= artist.artist_profile || '/uploads/undefine_artist.png' %>"
              class="banner-img artist-img"
            />
          </div>
          <div class="banner-text">
            <div class="banner-text-content">
              <h3><%= artist.artist_name %></h3>
              <p class="muted">Artist</p>
              <p class="playlist-description">
                <%= artist.artist_bio || 'Tidak ada deskripsi artist.' %>
              </p>
            </div>
            <div class="playlist-stats">
              <% if (artist.tracks && artist.tracks.length > 0) { %>
              <div onclick="buttonArtist()" class="stat-item artist-btn">
                <svg
                  class="svg-icon playlist-play"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5 21V3c0-.79116579.87524596-1.26900738 1.54075759-.84117848L20.5407576 11.1588215c.6123232.3936364.6123232 1.2887206 0 1.682357l-14.00000001 9C5.87524596 22.2690074 5 21.7911658 5 21zm2-1.8316655L18.1507426 12 7 4.8316655v14.336669z"
                  />
                </svg>
              </div>
              <% } %>

              <div onclick="share()" class="stat-item">
                <i class="fa-solid fa-share"></i>
              </div>

            <button id="btn-message" class="button-message" onclick="toggleFollowArtist(this, '<%= artist.id_artist %>')" >
              <div class="content-avatar">
                <div class="status-user"></div>
                <div class="avatar">
                  <svg class="user-img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,12.5c-3.04,0-5.5,1.73-5.5,3.5s2.46,3.5,5.5,3.5,5.5-1.73,5.5-3.5-2.46-3.5-5.5-3.5Zm0-.5c1.66,0,3-1.34,3-3s-1.34-3-3-3-3,1.34-3,3,1.34,3,3,3Z"></path></svg>
                </div>
              </div>
              <div class="notice-content <%= isArtistFollowed ? 'following' : '' %>" >
                <div class="lable-message"><%= isArtistFollowed ? 'Following' : 'Follow' %></div>
              </div>
            </button>



            </div>
          </div>
        </div>
      </div>
    </div>

<div class="tracks">
   <% artist.tracks.forEach(function(track, index) { %>
<div class="track-container listmusic"
    onclick="trackClicked(this)"
    data-id="<%= track.id_music %>"
    data-src="<%= track.audio_file %>"
    data-lyric="<%= track.lyric %>"
    data-line-durations="<%= track.line_durations %>"
    data-cover="<%= track.cover_music %>"
    data-title="<%= track.title_music %>"
    data-artist-ids="<%= track.artist_ids || '' %>"
    data-artist-hashids="<%= track.artists.map(a => a.hashid).join(',') || '' %>"
    data-artist="<%= track.artist_names || 'Unknown Artist' %>"
    data-playlist="<%= track.playlist_hashid || artist.hashid %>"
    data-playlist-original="<%= artist.id_artist || '' %>" 
    data-album-id="<%= track.albums[0]?.id_al %>"
    data-album-hashid="<%= track.album_hashid || track.albums[0]?.hashid || '' %>"
    data-track-hashid="<%= track.hashid %>"
    data-playlist_name="<%= artist.artist_name %>"
    data-item="artist" 
>
        <div class="track-info">
            <!-- PERBAIKAN: Track number dengan width tetap -->
            <span class="track-number"><%= index + 1 %></span>
            <img src="<%= track.cover_music %>" class="track-image" />
            <div class="track-details">
                <p class="track-title"><%= track.title_music %></p>
                <p class="track-artist">
                    <% if (track.artists && track.artists.length > 0) { %>
                        <% track.artists.forEach(function(artist, idx) { %>
                            <span class="clickable-artist" onclick="showArtist('<%= artist.hashid %>')">
                                <%= artist.name %>
                            </span><%= (idx < track.artists.length - 1) ? ', ' : '' %>
                        <% }); %>
                    <% } else { %>
                        <span>Unknown Artist</span>
                    <% } %>
                </p>
            </div>
        </div>

        <!-- PERBAIKAN: Tambahkan container untuk track-album dengan album.album_name -->
        <div class="track-album-container">
          <% if (track.albums && track.albums.length) { %> 
              <% track.albums.forEach(function(album) { %>
                  <% if (album.hashid && album.hashid !== 'AL0') { %>
                      <span 
                          class="track-album clickable" 
                          onclick="showAlbum('<%= album.hashid %>')"
                      >
                          <%= album.album_name || album.name || 'Unknown Album' %>
                      </span>
                  <% } else { %>
                      <span class="track-album">
                          <%= album.album_name || album.name || 'Unknown Album' %>
                      </span>
                  <% } %>
              <% }); %> 
          <% } else { %>
              <span class="track-album clickable" onclick="showMusic('<%= track.hashid %>')">
                  <%= track.title_music %>
              </span>
          <% } %>
        </div>

        <span class="track-time"><%= track.duration %></span>
        <div class="track-actions">
            <i onclick="event.stopPropagation(); event.preventDefault(); trackHeart(this)"
               class="<%= track.isFavorite ? 'fas' : 'far' %> fa-heart fav_playlist"
               style="<%= track.isFavorite ? 'color:#ffff;' : '' %>"></i>

            <div class="dropdown-container" onclick="event.stopPropagation();">
                <i class="fa-solid fa-ellipsis track-menu" onclick="handleEllipsisClick(this)"></i>
                <div class="dropdown-content">
                    <li class="favDropdown" onclick="trackHeartDropdown(this)">
                        <a href="javascript:void(0);">
                            <i class="<%= track.isFavorite ? 'fas' : 'far' %> fa-heart" style="<%= track.isFavorite ? 'color:#ffff;' : '' %>"></i>
                            <span>Favorites</span>
                        </a>
                    </li>

                    <!-- PERBAIKAN: Menu Artist dengan struktur yang sama seperti playlist -->
                    <% if (track.artists && track.artists.length === 1) { %>
                      <a href="javascript:void(0);" onclick="showArtist('<%= track.artists[0].hashid %>')">
                          <i class="fa-solid fa-user"></i>Artist
                      </a>
                    <% } else if (track.artists && track.artists.length > 1) { %>
                      <div class="dropdown-submenu">
                          <a href="javascript:void(0);">
                              <i class="fa-solid fa-user"></i>
                              <span>Artist</span>
                              <span class="arrow">▸</span>
                          </a>
                          <div class="submenu-content">
                              <% track.artists.forEach(function(artist, index) { %>
                              <a href="javascript:void(0);" onclick="showArtist('<%= artist.hashid %>')">
                                  <%= artist.name %>
                              </a>
                              <% }); %>
                          </div>
                      </div>
                    <% } else { %>
                      <a href="javascript:void(0);">
                          <i class="fa-solid fa-user"></i>Unknown Artist
                      </a>
                    <% } %>

                    <!-- PERBAIKAN: Menu Album dengan struktur yang sama -->
                    <% if (track.albums && track.albums.length) { %> 
                      <% track.albums.forEach(function(album) { %>
                        <a href="javascript:void(0);" onclick="showAlbum('<%= album.hashid %>')"><i class="fa-solid fa-compact-disc"></i>Album</a>
                      <% }); %> 
                    <% } else { %>
                      <a href="javascript:void(0);" onclick="showMusic('<%= track.hashid %>')"><i class="fa-solid fa-compact-disc"></i>Music</a>
                    <% } %>

                    <div class="dropdown-submenu">
                        <a href="javascript:void(0);">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add To Playlist</span>
                            <span class="arrow">▸</span>
                        </a>
                        <div class="submenu-content">
                            <% if (track.custom_playlists && track.custom_playlists.length > 0) { %> 
                                <% track.custom_playlists.forEach(function(pl) { %>
                                    <li class="sub-addplaylist" data-playlist-id="<%= pl.id_cus %>" data-music-id="<%= track.id_music %>" onclick="addCusDesk('<%= pl.id_cus %>', '<%= track.id_music %>')">
                                        <a href="javascript:void(0);">
                                            <% if (pl.exists) { %>
                                                <i class="fa-solid fa-circle-check" style="color: #4caf50; margin-right: 5px"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-circle-check" style="color: #b0b0b0; margin-right: 5px"></i>
                                            <% } %>
                                            <span class="playlist-name"><%= pl.playlist_name %></span>
                                        </a>
                                    </li>
                                <% }); %> 
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% }); %>
</div>

    <footer class="row center"></footer>
  </body>
</html>



<div style="display: none;" class="popup listMo">
  <div class="popup-overlay"></div>
  <div class="popup-content">

    <div class="drag-handle">
          <div class="drag-handle-line"></div>
    </div>

    <div class="album-page__track">
      <img id="popupimage"
        src=""
        alt=""
        class="__image" 
      />
      <div class="album-page__track__info">
        <div id="popuptitle" class="info-name"></div>
        <div id="popupartist" class="info-artist"></div>
      </div>
    </div>

    <div class="grid">
      <div onclick="popupHeartt(this)" class="grid-item" data-id="">
        <i id="popupfavorite" class="far fa-heart"></i>
        <span id="popupfavorite-text">Favorite</span>
      </div>

      <div onclick="toggleContent('artist')" class="grid-item">
        <i class="fa-regular fa-address-book"></i><span>Artist</span>
      </div>
      
      <div onclick="toggleContent('playlist')" class="grid-item">
        <i class="fa-regular fa-square-plus"></i><span>Add Playlist</span>
      </div>

      <!-- PERBAIKAN: Button album/music yang dinamis -->
      <div id="albumMobileButton" class="grid-item" data-hashid="">
        <i class="fa-solid fa-compact-disc"></i>
        <span>Album</span>
      </div>

      <div class="playlistCus">
        <div class="playlist-wrapper"></div>
      </div>
    </div>

    <i onclick="closePopup()" class="fa-solid fa-xmark"></i>
  </div>
</div>