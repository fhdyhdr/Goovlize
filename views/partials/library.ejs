function createSearchItemElement(item, query) {
    const itemElement = document.createElement('div');
    itemElement.className = 'mobile-library-item';
    itemElement.setAttribute('data-id', item.id);
    itemElement.setAttribute('data-type', item.type);
    
    // Determine cover type
    let coverHTML = '';
    const isPlaylist = item.type === 'playlist' || item.type === 'fav_playlist';
    const hasMultipleTracks = item.track_count > 1;
    
    // Process track covers - ensure we have an array of unique covers
    let processedCovers = [];
    if (item.track_covers && Array.isArray(item.track_covers)) {
        // Remove duplicates and empty values
        processedCovers = [...new Set(item.track_covers)].filter(cover => 
            cover && cover.trim() !== '' && cover !== 'null' && cover !== 'undefined'
        );
    }
    
    const hasTrackCovers = processedCovers.length > 0;
    
    // For playlists with multiple tracks AND multiple unique covers, show collage
    if (isPlaylist && hasMultipleTracks && hasTrackCovers && processedCovers.length > 1) {
        // Render collage cover for playlists with multiple tracks
        const covers = processedCovers.slice(0, 4);
        const gridRows = covers.length > 2 ? 'repeat(2, 1fr)' : '1fr';
        
        coverHTML = `
            <div class="mobile-library-item-cover collage-cover">
                <div class="collage-grid" style="grid-template-columns: repeat(2, 1fr); grid-template-rows: ${gridRows};">
                    ${covers.map((cover, index) => {
                        // Handle special case for 3 covers
                        const span2 = covers.length === 3 && index === 2 ? 'grid-column: span 2;' : '';
                        return `<div class="collage-item" style="background-image: url('${cover}'); ${span2}"></div>`;
                    }).join('')}
                </div>
            </div>
        `;
    } else {
        // Render single cover for other items
        const coverClass = item.type === 'artist' 
            ? 'mobile-library-item-cover rounded' 
            : 'mobile-library-item-cover';
        
        // Use first track cover if available, or item.cover, or default
        let displayCover = '';
        
        if (hasTrackCovers) {
            displayCover = processedCovers[0];
        } else if (item.cover && item.cover !== 'null' && item.cover !== 'undefined') {
            displayCover = item.cover;
        } else {
            // Default covers based on type
            displayCover = item.type === 'artist' 
                ? '/images/default-artist.png' 
                : '/images/default-playlist.png';
        }
        
        coverHTML = `<div class="${coverClass}" style="background-image: url('${displayCover}')"></div>`;
    }
    
    const highlightMatches = (text) => {
        if (!query || !text) return text;
        
        const normalizedText = text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const normalizedQuery = query.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        
        // Split query into individual words
        const queryWords = normalizedQuery.split(/\s+/).filter(w => w.length > 0);
        
        // Create a copy of the original text to work with
        let resultText = text;
        let workingText = text; // This will track the current state with HTML tags
        
        queryWords.forEach(word => {
            if (word.length < 2) return;
            
            // Find all matches in the normalized text (without HTML tags)
            const regex = new RegExp(escapeRegExp(word), 'gi');
            let match;
            const matches = [];
            
            while ((match = regex.exec(normalizedText)) !== null) {
                matches.push({
                    index: match.index,
                    length: word.length
                });
            }
            
            // Apply highlights from end to beginning to preserve positions
            matches.reverse().forEach(match => {
                const before = workingText.substring(0, match.index);
                const matchText = workingText.substring(match.index, match.index + match.length);
                const after = workingText.substring(match.index + match.length);
                
                resultText = before + 
                           `<span class="search-highlight">${matchText}</span>` + 
                           after;
                
                // Update workingText to account for the added HTML tags
                workingText = before + matchText + after;
            });
        });
        
        return resultText;
    }

    function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // Determine click handler based on type and playlist_type
    let clickHandler = '';
    if (item.type === 'fav_playlist') {
        if (item.playlist_type === 'custom') {
            clickHandler = `showCustomPlaylist('${item.hashid}')`;
        } else {
            clickHandler = `showplaylist('${item.hashid}')`;
        }
    } else if (item.type === 'playlist') {
        clickHandler = `showCustomPlaylist('${item.hashid}')`;
    } else if (item.type === 'artist') {
        clickHandler = `viewArtist('${item.hashid}')`;
    } else if (item.type === 'album') {
        clickHandler = `showAlbumMobile('${item.hashid}')`;
    }
    
    itemElement.setAttribute('onclick', clickHandler);
    
    itemElement.innerHTML = `
        ${coverHTML}
        <div class="mobile-library-item-info">
            <h3 class="mobile-library-item-title">${highlightMatches(item.title)}</h3>
            <p class="mobile-library-item-subtitle">${highlightMatches(item.subtitle)}</p>
        </div>
        <button class="mobile-library-item-more">
            <i class="fas fa-ellipsis-h"></i>
        </button>
    `;

    return itemElement;
}

