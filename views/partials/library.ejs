<div class="mobile-library-container gradient-bg">
    <!-- Header -->
    <div class="mobile-library-header">
        <div class="mobile-library-header-content">
            <button class="mobile-library-back-btn" onclick="history.back()">
                <i class="fas fa-chevron-left"></i>
            </button>
            <h1 class="mobile-library-title">Your Library</h1>
            <button class="mobile-library-search-btn" onclick="toggleSearch()">
                <i class="fas fa-search"></i>
            </button>
        </div>
        
        <!-- Search Bar (Hidden by default) -->
        <div class="mobile-library-search-container" id="searchContainer">
            <div class="mobile-library-search-box">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="librarySearchInput" class="mobile-library-search-input" 
                       placeholder="Search in your library..." oninput="performSearch()">
                <button class="mobile-library-clear-search" id="clearSearchBtn" onclick="clearSearch()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <button class="mobile-library-cancel-search" onclick="closeSearch()">
                Close
            </button>
        </div>
        
        <!-- Library Tabs -->
        <div class="mobile-library-tabs" id="libraryTabs">
            <button class="mobile-library-tab" onclick="switchTab('all')">All</button>
            <button class="mobile-library-tab" onclick="switchTab('playlists')">Playlists</button>
            <button class="mobile-library-tab" onclick="switchTab('artists')">Artists</button>
            <button class="mobile-library-tab" onclick="switchTab('albums')">Albums</button>
        </div>
        
        <!-- View Controls -->
        <div class="mobile-library-view-controls" id="viewControls">
            <button class="mobile-library-add-btn" onclick="showCustom()">
                <i class="fas fa-plus"></i> New
            </button>
            <button class="mobile-library-view-toggle" id="viewToggle" onclick="toggleViewMode()">
                <i class="fas fa-list"></i> List View
            </button>
            <button class="mobile-library-group-toggle" id="groupToggle" onclick="toggleGroupView()">
                <i class="fas fa-layer-group"></i> Grouped
            </button>
        </div>
    </div>

    <!-- Library Content -->
    <div class="mobile-library-content">
        <!-- Search Results (Hidden by default) -->
        <div class="mobile-library-search-results" id="searchResults">
            <div class="mobile-library-search-empty">
                <i class="fas fa-search search-empty-icon"></i>
                <h3>Search in your library</h3>
                <p>Find your playlists, artists, and albums</p>
            </div>
            
            <div class="mobile-library-search-items" id="searchItemsContainer">
                <!-- Search results will be dynamically inserted here -->
            </div>
        </div>
        
        <!-- All Tab Content -->
        <div class="mobile-library-tab-content" id="all-content">
            <% if (libraryData.playlists.length > 0 || 
                   libraryData.artists.length > 0 || 
                   libraryData.albums.length > 0 || 
                   libraryData.favPlaylists.length > 0) { %>
                
                <!-- Grouped View -->
                <div class="grouped-view">
                    <!-- Custom Playlists Section -->
                    <% if (libraryData.playlists.length > 0) { %>
                        <div class="mobile-library-section">
                            <h3 class="library-subtitle">Your Playlists</h3>
                            <div class="mobile-library-items list-view">
                                <% libraryData.playlists.forEach((item, index) => { %>
                                    <div class="mobile-library-item" 
                                          data-id="<%= item.id %>" 
                                          data-type="playlist" 
                                          data-created="<%= item.created_at %>"
                                          data-track-count="<%= item.track_count || 0 %>"
                                          data-track-covers="<%= JSON.stringify(item.track_covers || []) %>"
                                          onclick="showCustomPlaylist('<%= item.hashid %>')">
                                        <% if (item.track_count > 1 && item.track_covers && item.track_covers.length > 0) { %>
                                            <!-- Collage cover for playlists with multiple tracks -->
                                            <div class="mobile-library-item-cover collage-cover">
                                                <div class="collage-grid" style="grid-template-columns: repeat(2, 1fr); grid-template-rows: <%= item.track_covers.length > 2 ? 'repeat(2, 1fr)' : '1fr' %>;">
                                                    <% 
                                                        // Get unique covers for collage
                                                        const covers = item.track_covers.slice(0, 4);
                                                    %>
                                                    <% covers.forEach((cover, index) => { %>
                                                        <div 
                                                            class="collage-item" 
                                                            style="background-image: url('<%= cover %>'); <%= 
                                                                covers.length === 3 && index === 2 ? 'grid-column: span 2;' : '' 
                                                            %>"
                                                        ></div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <!-- Single cover for playlists with one track -->
                                            <div class="mobile-library-item-cover" style="background-image: url('<%= item.cover || '/images/default-playlist.png' %>')"></div>
                                        <% } %>
                                        <div class="mobile-library-item-info">
                                            <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                            <p class="mobile-library-item-subtitle">Playlist</p>
                                        </div>
                                        <button class="mobile-library-item-more">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Favorite Playlists Section -->
                    <% if (libraryData.favPlaylists && libraryData.favPlaylists.length > 0) { %>
                        <div class="mobile-library-section">
                            <h3 class="library-subtitle">Favorite Playlists</h3>
                            <div class="mobile-library-items list-view">
                                <% libraryData.favPlaylists.forEach((item) => { %>
                                    <div class="mobile-library-item" 
                                        data-id="<%= item.id %>" 
                                        data-type="fav_playlist" 
                                        data-created="<%= item.created_at %>"
                                        data-track-count="<%= item.track_count || 0 %>"
                                        data-track-covers="<%= JSON.stringify(item.track_covers || []) %>"
                                        onclick="<%= item.playlist_type === 'custom' ? 'showCustomPlaylist' : 'showplaylist' %>('<%= item.hashid %>')">
                                        <% if (item.track_count > 1 && item.track_covers && item.track_covers.length > 0) { %>
                                            <!-- Collage cover for playlists with multiple tracks -->
                                            <div class="mobile-library-item-cover collage-cover">
                                                <div class="collage-grid" style="grid-template-columns: repeat(2, 1fr); grid-template-rows: <%= item.track_covers.length > 2 ? 'repeat(2, 1fr)' : '1fr' %>;">
                                                    <% 
                                                        // Get unique covers for collage
                                                       const covers = item.track_covers.slice(0, 4);
                                                    %>
                                                    <% covers.forEach((cover, index) => { %>
                                                        <div 
                                                            class="collage-item" 
                                                            style="background-image: url('<%= cover %>'); <%= 
                                                                covers.length === 3 && index === 2 ? 'grid-column: span 2;' : '' 
                                                            %>"
                                                        ></div>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <!-- Single cover for playlists with one track -->
                                            <div class="mobile-library-item-cover" style="background-image: url('<%= item.cover || '/images/default-playlist.png' %>')"></div>
                                        <% } %>
                                        <div class="mobile-library-item-info">
                                            <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                            <p class="mobile-library-item-subtitle">
                                                <%= item.playlist_type === 'custom' ? 'Custom Playlist' : 'Favorite Playlist' %>
                                            </p>
                                        </div>
                                        <button class="mobile-library-item-more">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Followed Artists Section -->
                    <% if (libraryData.artists.length > 0) { %>
                        <div class="mobile-library-section">
                            <h3 class="library-subtitle">Followed Artists</h3>
                            <div class="mobile-library-items list-view">
                                <% libraryData.artists.forEach((item, index) => { %>
                                    <div class="mobile-library-item" 
                                         data-id="<%= item.id %>" 
                                         data-type="artist" 
                                         data-created="<%= item.created_at %>" 
                                         onclick="viewArtist('<%= item.hashid %>')">
                                        <div class="mobile-library-item-cover rounded" style="background-image: url('<%= item.cover %>')"></div>
                                        <div class="mobile-library-item-info">
                                            <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                            <p class="mobile-library-item-subtitle">Artist</p>
                                        </div>
                                        <button class="mobile-library-item-more">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Favorite Albums Section -->
                    <% if (libraryData.albums.length > 0) { %>
                        <div class="mobile-library-section">
                            <h3 class="library-subtitle">Favorite Albums</h3>
                            <div class="mobile-library-items list-view">
                                <% libraryData.albums.forEach((item, index) => { %>
                                    <div class="mobile-library-item" 
                                         data-id="<%= item.id %>" 
                                         data-type="album" 
                                         data-created="<%= item.created_at %>" 
                                         onclick="showAlbumMobile('<%= item.hashid %>')">
                                        <div class="mobile-library-item-cover" style="background-image: url('<%= item.cover %>')"></div>
                                        <div class="mobile-library-item-info">
                                            <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                            <p class="mobile-library-item-subtitle">Album</p>
                                        </div>
                                        <button class="mobile-library-item-more">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Recent View (initially hidden) -->
                <div class="recent-view" style="display: none;">
                    <div class="mobile-library-section">
                        <h3 class="library-subtitle">Recently Added</h3>
                        <div class="mobile-library-items list-view" id="recent-items-container">
                            <!-- Items will be dynamically inserted here -->
                        </div>
                    </div>
                </div>

            <% } else { %>
                <!-- Empty state -->
                <div class="mobile-library-empty-state">
                    <div class="mobile-library-empty-icon">
                        <i class="fas fa-compact-disc"></i>
                    </div>
                    <h3 class="mobile-library-empty-title">Your Library is Empty</h3>
                    <p class="mobile-library-empty-description">
                        You haven't added any items to your library yet. Start by exploring music.
                    </p>
                    <button class="mobile-library-empty-button" onclick="exploreMusic()">
                        <i class="fas fa-music"></i> Explore Music
                    </button>
                </div>
            <% } %>
        </div>
        
        <!-- Playlists Tab Content -->
        <div class="mobile-library-tab-content" id="playlists-content">
            <% 
                // Combine all playlists and sort by created_at (descending)
                const allPlaylists = [...libraryData.playlists, ...(libraryData.favPlaylists || [])]
                .sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            %>
            
            <% if (allPlaylists.length > 0) { %>
                <div class="mobile-library-section">
                    <h2 class="mobile-library-section-title">All Playlists</h2>
                    <div class="mobile-library-items list-view">
                        <% allPlaylists.forEach((item) => { %>
                            <div class="mobile-library-item" 
                                data-id="<%= item.id %>"
                                data-type="<%= item.type === 'fav_playlist' ? 'fav_playlist' : 'playlist' %>"
                                data-created="<%= item.created_at %>"
                                data-track-count="<%= item.track_count || 0 %>"
                                data-track-covers="<%= JSON.stringify(item.track_covers || []) %>"
                                onclick="<%= item.type === 'fav_playlist' && item.playlist_type === 'custom' ? 'showCustomPlaylist' : (item.type === 'fav_playlist' ? 'showplaylist' : 'showCustomPlaylist') %>('<%= item.hashid %>')">
                                <% 
                                // Get unique covers
                                const uniqueCovers = item.track_covers ? [...new Set(item.track_covers)] : [];
                                const showCollage = item.track_count > 1 && uniqueCovers.length > 1;
                                const displayCovers = uniqueCovers.slice(0, 4);
                                const effectiveCover = item.track_covers && item.track_covers.length > 0 ? 
                                                    item.track_covers[0] : 
                                                    item.cover || '/images/default-playlist.png';
                                %>
                                
                                <% if (showCollage) { %>
                                    <!-- Collage cover for playlists with multiple tracks AND different covers -->
                                    <div class="mobile-library-item-cover collage-cover">
                                        <div class="collage-grid" style="grid-template-columns: repeat(2, 1fr); grid-template-rows: <%= displayCovers.length > 2 ? 'repeat(2, 1fr)' : '1fr' %>;">
                                            <% displayCovers.forEach((cover, index) => { %>
                                                <div 
                                                class="collage-item" 
                                                style="background-image: url('<%= cover %>'); <%= 
                                                    displayCovers.length === 3 && index === 2 ? 'grid-column: span 2;' : '' 
                                                %>"
                                                ></div>
                                            <% }); %>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <!-- Single cover for playlists -->
                                    <div class="mobile-library-item-cover" style="background-image: url('<%= effectiveCover %>')"></div>
                                <% } %>
                                
                                <div class="mobile-library-item-info">
                                    <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                    <p class="mobile-library-item-subtitle">
                                        <%= item.type === 'fav_playlist' ? 
                                            (item.playlist_type === 'custom' ? 'Custom Playlist' : 'Favorite Playlist') : 
                                            'Playlist' %>
                                    </p>
                                </div>
                                <button class="mobile-library-item-more">
                                    <i class="fas fa-ellipsis-h"></i>
                                </button>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } else { %>
                <div class="mobile-library-empty-state">
                    <div class="mobile-library-empty-icon">
                        <i class="fas fa-list"></i>
                    </div>
                    <h3 class="mobile-library-empty-title">No Playlists Yet</h3>
                    <p class="mobile-library-empty-description">
                        You haven't created or saved any playlists yet.
                    </p>
                    <button class="mobile-library-empty-button" onclick="createNewPlaylist()">
                        <i class="fas fa-plus"></i> Create Playlist
                    </button>
                </div>
            <% } %>
        </div>

        <!-- Artists Tab Content -->
        <div class="mobile-library-tab-content" id="artists-content">
            <% 
                // Sort artists by created_at (descending)
                const sortedArtists = [...libraryData.artists].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            %>
            <% if (sortedArtists.length > 0) { %>
                <div class="mobile-library-section">
                    <h2 class="mobile-library-section-title">Followed Artists</h2>
                    <div class="mobile-library-items list-view">
                        <% sortedArtists.forEach((item) => { %>
                            <div class="mobile-library-item" 
                                 data-id="<%= item.id %>" 
                                 data-type="artist" 
                                 data-created="<%= item.created_at %>" 
                                 onclick="viewArtist('<%= item.hashid %>')">
                                <div class="mobile-library-item-cover rounded" style="background-image: url('<%= item.cover %>')"></div>
                                <div class="mobile-library-item-info">
                                    <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                    <p class="mobile-library-item-subtitle">Artist</p>
                                </div>
                                <button class="mobile-library-item-more">
                                    <i class="fas fa-ellipsis-h"></i>
                                </button>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } else { %>
                <div class="mobile-library-empty-state">
                    <div class="mobile-library-empty-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3 class="mobile-library-empty-title">No Followed Artists</h3>
                    <p class="mobile-library-empty-description">
                        You haven't followed any artists yet.
                    </p>
                    <button class="mobile-library-empty-button" onclick="exploreMusic()">
                        <i class="fas fa-music"></i> Discover Artists
                    </button>
                </div>
            <% } %>
        </div>
        
        <!-- Albums Tab Content -->
        <div class="mobile-library-tab-content" id="albums-content">
            <% 
                // Sort albums by created_at (descending)
                const sortedAlbums = [...libraryData.albums].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            %>
            <% if (sortedAlbums.length > 0) { %>
                <div class="mobile-library-section">
                    <h2 class="mobile-library-section-title">Favorite Albums</h2>
                    <div class="mobile-library-items list-view">
                        <% sortedAlbums.forEach((item) => { %>
                            <div class="mobile-library-item" 
                                 data-id="<%= item.id %>" 
                                 data-type="album" 
                                 data-created="<%= item.created_at %>" 
                                 onclick="showAlbumMobile('<%= item.hashid %>')">
                                <div class="mobile-library-item-cover" style="background-image: url('<%= item.cover %>')"></div>
                                <div class="mobile-library-item-info">
                                    <h3 class="mobile-library-item-title"><%= item.name %></h3>
                                    <p class="mobile-library-item-subtitle">Album</p>
                                </div>
                                <button class="mobile-library-item-more">
                                    <i class="fas fa-ellipsis-h"></i>
                                </button>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } else { %>
                <div class="mobile-library-empty-state">
                    <div class="mobile-library-empty-icon">
                        <i class="fas fa-compact-disc"></i>
                    </div>
                    <h3 class="mobile-library-empty-title">No Favorite Albums</h3>
                    <p class="mobile-library-empty-description">
                        You haven't saved any albums to your library yet.
                    </p>
                    <button class="mobile-library-empty-button" onclick="exploreMusic()">
                        <i class="fas fa-music"></i> Browse Albums
                    </button>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
// New functions for artist and album click handlers
function viewArtist(hashid) {
    alert("Artist Hashid: " + hashid);
    // Implementasi untuk membuka halaman artist
    // showArtist(hashid);
}

function showAlbumMobile(hashid) {
    alert("Album Hashid: " + hashid);
    // Implementasi untuk membuka halaman album
    // showAlbum(hashid);
}

const libraryState = {
    isListView: localStorage.getItem('viewMode') === null ? true : localStorage.getItem('viewMode') === 'list',
    isGroupedView: localStorage.getItem('groupView') === null ? false : localStorage.getItem('groupView') === 'true',
    libraryItems: [],
    initialized: false,
    currentTab: 'all',
    isSearchActive: false,
    searchResults: [],
    // Tambahkan flag untuk melacak apakah items sudah dikumpulkan
    itemsCollected: false
};

function initializeLibrary() {
    if (libraryState.initialized) return;
    
    console.log('Initializing library with saved state:', {
        viewMode: localStorage.getItem('viewMode'),
        groupView: localStorage.getItem('groupView')
    });

    // Reset collection flag
    libraryState.itemsCollected = false;
    
    // 1. Collect all library items (hanya sekali)
    if (!libraryState.itemsCollected) {
        collectLibraryItems();
        libraryState.itemsCollected = true;
    }

    // 2. Set up initial tab state
    setupInitialTabState();

    // 3. Initialize all views
    initializeViews();

    libraryState.initialized = true;
    console.log('Library initialized with:', {
        viewMode: libraryState.isListView ? 'List' : 'Grid',
        groupView: libraryState.isGroupedView ? 'Grouped' : 'Recent',
        itemCount: libraryState.libraryItems.length
    });
}

function collectLibraryItems() {
    // Kosongkan array items sebelum mengumpulkan yang baru
    libraryState.libraryItems = [];
    
    // Gunakan Set untuk menghindari duplikat
    const itemIds = new Set();
    
    // Get all items from ALL tabs, not just the visible ones
    const allItems = Array.from(document.querySelectorAll('.mobile-library-tab-content .mobile-library-item'));
    
    allItems.forEach(item => {
        const id = item.getAttribute('data-id') || '';
        const type = item.getAttribute('data-type') || '';
        
        // Skip jika item sudah ada
        if (itemIds.has(`${type}-${id}`)) {
            console.log('Skipping duplicate item:', id, type);
            return;
        }
        
        itemIds.add(`${type}-${id}`);
        
        let hashid = null;
        const onclickAttr = item.getAttribute('onclick');
        
        if (onclickAttr) {
            if (onclickAttr.includes('showplaylist')) {
                const match = onclickAttr.match(/showplaylist\(['"]([^'"]+)['"]\)/);
                if (match) hashid = match[1];
            } else if (onclickAttr.includes('showCustomPlaylist')) {
                const match = onclickAttr.match(/showCustomPlaylist\(['"]([^'"]+)['"]\)/);
                if (match) hashid = match[1];
            } else if (onclickAttr.includes('viewArtist')) {
                const match = onclickAttr.match(/viewArtist\(['"]([^'"]+)['"]\)/);
                if (match) hashid = match[1];
            } else if (onclickAttr.includes('showAlbumMobile')) {
                const match = onclickAttr.match(/showAlbumMobile\(['"]([^'"]+)['"]\)/);
                if (match) hashid = match[1];
            }
        }
        
        // Get track_count and track_covers from data attributes
        const trackCount = parseInt(item.getAttribute('data-track-count') || 0);
        let trackCovers = [];
        
        try {
            const coversAttr = item.getAttribute('data-track-covers');
            if (coversAttr) {
                // Parse and clean track covers
                const parsedCovers = JSON.parse(coversAttr);
                if (Array.isArray(parsedCovers)) {
                    // Remove duplicates and invalid values
                    trackCovers = [...new Set(parsedCovers)].filter(cover => 
                        cover && cover.trim() !== '' && cover !== 'null' && cover !== 'undefined'
                    );
                }
            }
        } catch (e) {
            console.error('Error parsing track covers:', e);
            trackCovers = [];
        }
        
        // Get cover from element style or default - khusus untuk single cover
        let coverUrl = '';
        const coverElement = item.querySelector('.mobile-library-item-cover:not(.collage-cover)');
        
        if (coverElement && !coverElement.classList.contains('collage-cover')) {
            const coverStyle = coverElement.style.backgroundImage || '';
            coverUrl = coverStyle.match(/url\(["']?(.*?)["']?\)/)?.[1] || '';
        } else {
            // Untuk collage cover, ambil cover pertama dari track_covers
            if (trackCovers.length > 0) {
                coverUrl = trackCovers[0];
            }
        }
        
        // Jika masih tidak ada cover, gunakan default berdasarkan type
        if (!coverUrl) {
            coverUrl = type === 'artist' 
                ? '/images/default-artist.png' 
                : '/images/default-playlist.png';
        }
        
        // Determine playlist type untuk fav_playlist
        let playlistType = '';
        if (type === 'fav_playlist') {
            // Cek dari onclick attribute untuk menentukan apakah custom atau global
            if (onclickAttr && onclickAttr.includes('showCustomPlaylist')) {
                playlistType = 'custom';
            } else {
                playlistType = 'global';
            }
        }
        
        libraryState.libraryItems.push({
            element: item,
            id: id,
            type: type,
            created: item.getAttribute('data-created') || '',
            title: item.querySelector('.mobile-library-item-title')?.textContent || '',
            subtitle: item.querySelector('.mobile-library-item-subtitle')?.textContent || '',
            cover: coverUrl,
            hashid: hashid,
            track_count: trackCount,
            track_covers: trackCovers,
            playlist_type: playlistType
        });
    });
    
    console.log('Collected items from all tabs:', libraryState.libraryItems.length);
}

function setupInitialTabState() {
    const activeTabs = document.querySelectorAll('.mobile-library-tab.active');
    const activeContents = document.querySelectorAll('.mobile-library-tab-content.active');
    
    if (activeTabs.length === 0 && activeContents.length === 0) {
        console.log('No active tabs found, setting default to "All"');
        setActiveTab('all');
    } else if (activeTabs.length > 0) {
        const activeTab = activeTabs[0];
        const tabName = activeTab.textContent.trim().toLowerCase();
        if (['all', 'playlists', 'artists', 'albums'].includes(tabName)) {
            libraryState.currentTab = tabName;
        }
    }
}

function initializeViews() {
    // Set up view mode first
    updateViewMode();
    updateViewToggleButton();
    
    // Then handle group view
    if (libraryState.currentTab === 'all') {
        updateGroupView();
        // Jika dalam mode recent, render konten recent
        if (!libraryState.isGroupedView) {
            renderRecentView();
        }
    }
    updateGroupToggleButton();
    updateGroupToggleVisibility();
}

// Helper function to set active tab
function setActiveTab(tabName) {
    if (!tabName) return;
    
    // Update tabs
    document.querySelectorAll(".mobile-library-tab").forEach(tab => {
        tab.classList.remove("active");
        if (tab.textContent.trim().toLowerCase() === tabName.toLowerCase()) {
            tab.classList.add("active");
        }
    });

    // Update content
    document.querySelectorAll(".mobile-library-tab-content").forEach(content => {
        content.classList.remove("active");
    });
    
    const content = document.getElementById(`${tabName}-content`);
    if (content) {
        content.classList.add("active");
        libraryState.currentTab = tabName;
    }

    // Update views
    updateViewMode();
    updateGroupToggleVisibility();
    
    // Ensure group view is correct for All tab
    if (tabName === 'all') {
        updateGroupView();
    }
}

// Tab switching functionality
function switchTab(tabName) {
    try {
        if (!tabName) return;
        
        // Collect items again when switching tabs to ensure all items are available for search
        collectLibraryItems();
        
        setActiveTab(tabName);
    } catch (error) {
        console.error('Error in switchTab:', error);
    }
}

// View mode functions
function updateViewMode() {
    try {
        const activeTabContent = document.querySelector('.mobile-library-tab-content.active');
        if (!activeTabContent) return;
        
        const itemsContainers = activeTabContent.querySelectorAll('.mobile-library-items');
        itemsContainers.forEach(container => {
            container.classList.remove(libraryState.isListView ? 'grid-view' : 'list-view');
            container.classList.add(libraryState.isListView ? 'list-view' : 'grid-view');
        });
    } catch (error) {
        console.error('Error in updateViewMode:', error);
    }
}

function toggleViewMode() {
    libraryState.isListView = !libraryState.isListView;
    localStorage.setItem('viewMode', libraryState.isListView ? 'list' : 'grid');
    updateViewMode();
    updateViewToggleButton();
}

function updateViewToggleButton() {
    const viewToggle = document.getElementById("viewToggle");
    if (viewToggle) {
        viewToggle.innerHTML = libraryState.isListView 
            ? '<i class="fas fa-list"></i> List View' 
            : '<i class="fas fa-th-large"></i> Grid View';
    }
}

function toggleGroupView() {
    libraryState.isGroupedView = !libraryState.isGroupedView;
    localStorage.setItem('groupView', libraryState.isGroupedView);
    
    // Selalu render Recent view ketika berpindah ke mode Recent
    if (!libraryState.isGroupedView) {
        renderRecentView();
    }
    
    updateGroupView();
    updateGroupToggleButton();
}

function updateGroupView() {
    try {
        const groupedView = document.querySelector('.grouped-view');
        const recentView = document.querySelector('.recent-view');
        
        if (groupedView && recentView) {
            // First hide both to prevent flickering
            groupedView.style.display = 'none';
            recentView.style.display = 'none';
            
            // Then show the correct one
            if (libraryState.isGroupedView) {
                groupedView.style.display = 'block';
            } else {
                recentView.style.display = 'block';
                // Selalu render ulang saat berpindah ke Recent view
                renderRecentView();
            }
        }
    } catch (error) {
        console.error('Error in updateGroupView:', error);
    }
}

function updateGroupToggleButton() {
    const groupToggle = document.getElementById("groupToggle");
    if (groupToggle) {
        groupToggle.innerHTML = libraryState.isGroupedView
            ? '<i class="fas fa-layer-group"></i> Grouped'
            : '<i class="fas fa-sort-amount-down"></i> Recent';
        groupToggle.classList.toggle('active', libraryState.isGroupedView);
        groupToggle.title = libraryState.isGroupedView ? 'Switch to Recent view' : 'Switch to Grouped view';
    }
}

function updateGroupToggleVisibility() {
    const groupToggle = document.getElementById("groupToggle");
    if (!groupToggle) return;
    
    groupToggle.style.display = libraryState.currentTab === 'all' ? "flex" : "none";
}

function renderRecentView() {  
    try {
        const container = document.getElementById('recent-items-container');
        if (!container) return;
        
        // Kosongkan container dengan cara yang lebih aman
        container.innerHTML = '';
        
        // Sort by creation date (newest first)
        const sortedItems = [...libraryState.libraryItems].sort((a, b) => {
            const dateA = a.created ? new Date(a.created) : new Date(0);
            const dateB = b.created ? new Date(b.created) : new Date(0);
            return dateB - dateA;
        });

        // Tambahkan flag untuk melacak item yang sudah dirender
        const renderedItems = new Set();
        
        // Add items (limit to 20)
        sortedItems.slice(0, 20).forEach(item => {
            if (!item.created || renderedItems.has(`${item.type}-${item.id}`)) {
                return;
            }
            
            renderedItems.add(`${item.type}-${item.id}`);
            
            const itemElement = document.createElement('div');
            itemElement.className = 'mobile-library-item';
            itemElement.setAttribute('data-id', item.id);
            itemElement.setAttribute('data-type', item.type);
            itemElement.setAttribute('data-track-count', item.track_count || 0);
            
            // Proses track covers untuk menghilangkan duplikat
            let processedCovers = [];
            if (item.track_covers && item.track_covers.length > 0) {
                // Gunakan Set untuk menghilangkan duplikat dan ambil maksimal 4 cover unik
                processedCovers = [...new Set(item.track_covers)].slice(0, 4);
            }
            itemElement.setAttribute('data-track-covers', JSON.stringify(processedCovers));
            
            // Determine cover type
            const isPlaylist = item.type === 'playlist' || item.type === 'fav_playlist';
            const hasMultipleTracks = item.track_count > 1;
            const hasUniqueCovers = processedCovers.length > 1;
            
            let coverHTML = '';
            
            if (isPlaylist && hasMultipleTracks && hasUniqueCovers) {
                // Render collage cover hanya jika ada multiple unique covers
                const gridRows = processedCovers.length > 2 ? 'repeat(2, 1fr)' : '1fr';
                
                coverHTML = `
                    <div class="mobile-library-item-cover collage-cover">
                        <div class="collage-grid" style="grid-template-columns: repeat(2, 1fr); grid-template-rows: ${gridRows};">
                            ${processedCovers.map((cover, index) => `
                                <div 
                                    class="collage-item" 
                                    style="background-image: url('${cover}'); ${
                                        processedCovers.length === 3 && index === 2 ? 'grid-column: span 2;' : ''
                                    }"
                                ></div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else {
                // Render single cover
                const coverClass = item.type === 'artist' 
                    ? 'mobile-library-item-cover rounded' 
                    : 'mobile-library-item-cover';
                
                // Gunakan cover pertama yang unik jika ada, atau gunakan item.cover, atau default
                const displayCover = processedCovers.length > 0 
                    ? processedCovers[0] 
                    : item.cover || '/images/default-playlist.png';
                
                coverHTML = `<div class="${coverClass}" style="background-image: url('${displayCover}')"></div>`;
            }
            
            // Determine click handler based on type and playlist_type
            let clickHandler = '';
            if (item.type === 'fav_playlist') {
                if (item.playlist_type === 'custom') {
                    clickHandler = `showCustomPlaylist('${item.hashid}')`;
                } else {
                    clickHandler = `showplaylist('${item.hashid}')`;
                }
            } else if (item.type === 'playlist') {
                clickHandler = `showCustomPlaylist('${item.hashid}')`;
            } else if (item.type === 'artist') {
                clickHandler = `viewArtist('${item.hashid}')`;
            } else if (item.type === 'album') {
                clickHandler = `showAlbumMobile('${item.hashid}')`;
            }
            
            itemElement.setAttribute('onclick', clickHandler);
            
            itemElement.innerHTML = `
                ${coverHTML}
                <div class="mobile-library-item-info">
                    <h3 class="mobile-library-item-title">${item.title}</h3>
                    <p class="mobile-library-item-subtitle">${item.subtitle}</p>
                </div>
                <button class="mobile-library-item-more">
                    <i class="fas fa-ellipsis-h"></i>
                </button>
            `;
            
            container.appendChild(itemElement);
        });

        // Apply current view mode
        container.classList.remove(libraryState.isListView ? 'grid-view' : 'list-view');
        container.classList.add(libraryState.isListView ? 'list-view' : 'grid-view');
        
        console.log('Rendered recent items:', renderedItems.size);
    } catch (error) {
        console.error('Error in renderRecentView:', error);
    }
}

function toggleSearch() {
    const container = document.querySelector('.mobile-library-container');
    const searchContainer = document.getElementById('searchContainer');
    const searchResults = document.getElementById('searchResults');
    const searchInput = document.getElementById('librarySearchInput');
    
    libraryState.isSearchActive = !libraryState.isSearchActive;
    
    if (libraryState.isSearchActive) {
        // Simpan state saat ini sebelum masuk search
        const currentState = {
            page: "library",
            tab: libraryState.currentTab,
            isGroupedView: libraryState.isGroupedView,
            isListView: libraryState.isListView
        };
        
        // Push search state to history
        history.pushState({ page: "searchlibrary", previousState: currentState }, "", window.location.pathname);
        
        container.classList.add('search-active');
        searchContainer.style.display = 'flex';
        searchResults.style.display = 'block';
        document.getElementById('searchItemsContainer').style.display = 'none';
        document.querySelector('.mobile-library-search-empty').style.display = 'block';
        
        // Focus on input field
        setTimeout(() => {
            searchInput.focus();
        }, 100);
    } else {
        // Tutup search dan kembali ke state sebelumnya
        resetSearchState();
        restoreLibraryState();
    }
}

function clearSearch() {
    const searchInput = document.getElementById('librarySearchInput');
    searchInput.value = '';
    performSearch();
}

function closeSearch() {
    if (libraryState.isSearchActive) {
        // Reset search state
        resetSearchState();
        
        // Restore previous state jika ada
        if (history.state?.previousState) {
            const prevState = history.state.previousState;
            libraryState.currentTab = prevState.tab;
            libraryState.isGroupedView = prevState.isGroupedView;
            libraryState.isListView = prevState.isListView;
        }
        
        // Kembali ke state sebelumnya
        if (history.state?.page === "searchlibrary") {
            history.back();
        } else {
            // Fallback jika tidak ada proper state
            restoreLibraryState();
        }
    }
}

function resetSearchState() {
    const container = document.querySelector('.mobile-library-container');
    const searchContainer = document.getElementById('searchContainer');
    const searchResults = document.getElementById('searchResults');
    const searchInput = document.getElementById('librarySearchInput');
    
    // Reset state
    libraryState.isSearchActive = false;
    
    // Reset UI
    container.classList.remove('search-active');
    searchContainer.style.display = 'none';
    searchResults.style.display = 'none';
    searchInput.value = '';
    
    // Clear search results
    const searchItemsContainer = document.getElementById('searchItemsContainer');
    if (searchItemsContainer) {
        searchItemsContainer.innerHTML = '';
    }
    
    console.log('Search state reset');
}

function restoreLibraryState() {
    // Pastikan tab content terlihat
    const tabContent = document.querySelector('.mobile-library-content');
    if (tabContent) {
        tabContent.style.display = 'block';
    }
    
    // Pastikan tab yang aktif ditampilkan dengan benar
    const activeTabContent = document.querySelector('.mobile-library-tab-content.active');
    if (!activeTabContent) {
        // Jika tidak ada tab aktif, set ke "All"
        setActiveTab('all');
    } else {
        // Pastikan konten tab aktif terlihat
        activeTabContent.style.display = 'block';
    }
    
    // Re-initialize views jika diperlukan
    if (libraryState.currentTab === 'all') {
        updateGroupView();
        if (!libraryState.isGroupedView) {
            renderRecentView();
        }
    }
    
    // Update view mode
    updateViewMode();
    
    console.log('Library state restored for tab:', libraryState.currentTab);
}

function performSearch() {
    const searchInput = document.getElementById('librarySearchInput');
    const query = searchInput.value.trim().toLowerCase();
    const clearBtn = document.getElementById('clearSearchBtn');
    const searchItemsContainer = document.getElementById('searchItemsContainer');
    const searchEmpty = document.querySelector('.mobile-library-search-empty');
    
    // Show/hide clear button
    clearBtn.style.display = query.length > 0 ? 'block' : 'none';
    
    if (query.length === 0) {
        searchItemsContainer.style.display = 'none';
        searchEmpty.style.display = 'block';
        searchEmpty.innerHTML = `
            <i class="fas fa-search search-empty-icon"></i>
            <h3>Search in your library</h3>
            <p>Find your playlists, artists, and albums</p>
        `;
        return;
    }
    
    // Filter items with enhanced fuzzy matching
    const uniqueResults = new Set();
    libraryState.searchResults = libraryState.libraryItems.filter(item => {
        // Normalize strings for better matching
        const title = item.title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const subtitle = item.subtitle.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const normalizedQuery = query.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        
        // Check for matches with enhanced fuzzy matching
        const titleMatch = fuzzyMatch(normalizedQuery, title);
        const subtitleMatch = fuzzyMatch(normalizedQuery, subtitle);
        
        if ((titleMatch || subtitleMatch) && !uniqueResults.has(item.id)) {
            uniqueResults.add(item.id);
            return true;
        }
        return false;
    });
    
    // Display results
    renderSearchResults();
}

// Enhanced fuzzy matching function
function fuzzyMatch(search, target) {
    if (!search || !target) return false;
    
    // Exact match
    if (target.includes(search)) return true;
    
    // Split search into individual words
    const searchWords = search.split(/\s+/).filter(w => w.length > 0);
    
    // If search is a single word, check for partial matches
    if (searchWords.length === 1) {
        const word = searchWords[0];
        
        // Check if any word in target starts with the search word
        const targetWords = target.split(/\s+/);
        if (targetWords.some(tw => tw.startsWith(word))) return true;
        
        // Check for character sequence match (e.g., "sbody" in "somebody")
        let searchIndex = 0;
        for (let i = 0; i < target.length; i++) {
            if (target[i] === word[searchIndex]) {
                searchIndex++;
                if (searchIndex === word.length) return true;
            }
        }
        
        // Check for similar sounding words using simple comparison
        if (word.length > 3) {
            const similar = targetWords.some(tw => 
                tw.length > 3 && 
                (tw.includes(word) || 
                word.includes(tw) || 
                getSimilarity(tw, word) > 0.7)
            );
            if (similar) return true;
        }
    } 
    // For multiple search words, check if all appear in any order
    else {
        const allWordsMatch = searchWords.every(sw => 
            target.split(/\s+/).some(tw => 
                tw.startsWith(sw) || 
                getSimilarity(tw, sw) > 0.7
            )
        );
        if (allWordsMatch) return true;
    }
    
    return false;
}

function getSimilarity(s1, s2) {
    const longer = s1.length > s2.length ? s1 : s2;
    const shorter = s1.length > s2.length ? s2 : s1;
    
    // Simple similarity check (can be replaced with more advanced algorithm)
    const matchingChars = [...shorter].filter((char, i) => longer.includes(char)).length;
    return matchingChars / longer.length;
}

