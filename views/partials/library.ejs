});

window.addEventListener('load', function() {
    if (!libraryState.initialized) {
        console.log('Window load - initializing library');
        setTimeout(initializeLibrary, 100);
    }
});

// Keyboard event for search
document.getElementById('librarySearchInput').addEventListener('keyup', function(e) {
    if (e.key === 'Enter') {
        performSearch();
    }
});

// Final fallback initialization
const initializationTimeout = setTimeout(() => {
    if (!libraryState.initialized) {
        console.warn('Fallback timeout - initializing library');
        initializeLibrary();
    }
    if (!document.querySelector('.mobile-library-tab.active')) {
        console.warn('No active tab found - setting to All');
        setActiveTab('all');
    }
}, 500);

// Clean up timeout if initialized earlier
if (libraryState.initialized) {
    clearTimeout(initializationTimeout);
}
</script>