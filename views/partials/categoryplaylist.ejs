<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<style>
.category-header {
  position: relative;
  padding: 60px 20px 40px;
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: white;
  margin-bottom: 30px;
  overflow: hidden;
}

.category-header__content {
  position: relative;
  z-index: 2;
  max-width: 95%;
  margin: 0 auto;
}

.category-title {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 10px;
}

.category-description {
  font-size: 1.2rem;
  opacity: 0.9;
  margin-bottom: 20px;
}

.category-stats {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.category-stats .head-stat-item{
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  opacity: 0.8;
}

.category-stats .stat-icon {
  width: 20px;
  height: 20px;
  fill: currentColor;
}

.category-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent 30%, rgba(130, 112, 112, 0.628) 50%, transparent 70%);
  z-index: 1;
}

.category-content {
  margin: 0 auto;
  padding: 0 80px 40px;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  padding: 20px 0;
}

.category-card {
  background: var(--card-bg);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

.category-card__visual {
  position: relative;
}

.genre-tags {
  position: absolute;
  bottom: 10px;
  left: 10px;
  right: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.genre-tag {
  background: rgba(0,0,0,0.7);
  color: white;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 0.7rem;
  backdrop-filter: blur(10px);
}

.category-card__meta {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-top: 8px;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.meta-icon {
  width: 14px;
  height: 14px;
  fill: currentColor;
}

.no-results {
  text-align: center;
  padding: 60px 20px;
}

.no-results__icon {
  width: 80px;
  height: 80px;
  fill: #ffff;
  margin-bottom: 20px;
  opacity: 0.5;
}

.no-results h3 {
  font-size: 1.5rem;
  margin-bottom: 10px;
  color: var(--text-primary);
}

.no-results p {
  color: var(--text-secondary);
  font-size: 1rem;
}

/* Styling khusus untuk Top Playlist */
.top-playlist-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: linear-gradient(45deg, #ff6b6b, #ff8e53);
  color: white;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: bold;
  z-index: 10;
  box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
}

.play-count-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: bold;
  z-index: 10;
  backdrop-filter: blur(10px);
}

.rank-number {
  font-size: 3rem;
  font-weight: 900;
  color: var(--primary-color);
  opacity: 0.1;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
}

@media (max-width: 768px) {
  .category-grid {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 15px;
  }
  
  .category-title {
    font-size: 2rem;
  }
  
  .category-content {
    padding: 0 20px 40px;
  }
}
</style>
<body>

<div class="category-header">
  <div class="category-header__content">
    <h1 class="category-title"><%= categoryName %></h1>
    <p class="category-description">
      <% if (isTopPlaylistPage) { %>
        Playlist dengan jumlah pemutaran terbanyak
      <% } else { %>
        Playlist yang cocok untuk <%= categoryName.toLowerCase() %>
      <% } %>
    </p>
    <div class="category-stats">
      <span class="head-stat-item">
        <svg class="stat-icon" viewBox="0 0 24 24">
          <path d="M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z"/>
        </svg>
        <%= playlists.length %> Playlists
      </span>
      <% if (isTopPlaylistPage && playlists.length > 0) { 
          const totalPlays = playlists.reduce((sum, p) => sum + (p.play_count || 0), 0);
      %>
        <span class="head-stat-item">
          <svg class="stat-icon" viewBox="0 0 24 24">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
          </svg>
          <%= totalPlays.toLocaleString() %> Total Plays
        </span>
      <% } %>
    </div>
  </div>
  <div class="category-gradient"></div>
</div>

<div class="category-content">
  <% if (playlists.length > 0) { %>
    <div class="category-grid">
      <% playlists.forEach((playlist, index) => { %>
        <div class="category-card">
          <!-- Card Container -->
          <div class="card-container">
            <!-- Visual Card -->
            <div
              class="visual-card category-card__visual"
              onclick="showplaylist('<%= playlist.hashid %>')"
            >
              <% if (isTopPlaylistPage) { %>
                <!-- Badge untuk Top Playlist -->
                <div class="top-playlist-badge">TOP <%= index + 1 %></div>
                
                <!-- Rank Number Background -->
                <div class="rank-number">#<%= index + 1 %></div>
                
                <!-- Play Count Badge -->
                <% if (playlist.play_count > 0) { %>
                  <div class="play-count-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" style="vertical-align: middle; margin-right: 4px;">
                      <path fill="currentColor" d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                    <%= playlist.play_count.toLocaleString() %>
                  </div>
                <% } %>
              <% } %>
              
              <div
                class="visual-image"
                style="background-image: url('<%= playlist.playlist_cover %>')"
              >
                <div class="text-background"></div>
                <div class="visual-overlay"></div>
              </div>

              <div
                class="svg-circle-wrapper"
                data-playlist-hashid="<%= playlist.hashid %>"
                onclick="playPlaylist('<%= playlist.hashid %>', this)"
              >
                <svg
                  class="svg-icon playlistCover-play"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5 21V3c0-.79116579.87524596-1.26900738 1.54075759-.84117848L20.5407576 11.1588215c.6123232.3936364.6123232 1.2887206 0 1.682357l-14.00000001 9C5.87524596 22.2690074 5 21.7911658 5 21zm2-1.8316655L18.1507426 12 7 4.8316655v14.336669z"
                  />
                </svg>
              </div>
              
              <!-- Genre Tags -->
              <div class="genre-tags">
                <% if (playlist.genres && playlist.genres.length > 0) { %>
                  <% playlist.genres.slice(0, 3).forEach(genre => { %>
                    <span class="genre-tag"><%= genre %></span>
                  <% }) %>
                  <% if (playlist.genres.length > 3) { %>
                    <span class="genre-tag">+<%= playlist.genres.length - 3 %></span>
                  <% } %>
                <% } %>
              </div>
            </div>
            
            <!-- Text Content Below Card -->
            <div class="card-text-content">
              <div class="visual-title"><%= playlist.playlist_name %></div>
             
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="no-results">
      <svg class="no-results__icon" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
      </svg>
      <h3>Tidak ada playlist yang ditemukan untuk kategori ini</h3>
      <p>Coba kategori lain</p>
    </div>
  <% } %>
</div>

</body>
</html>