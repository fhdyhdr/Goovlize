.playlist-description {
  font-size: clamp(0.8rem, 1.2cqi, 1rem);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
  color: #b3b3b3;
}

/* Container untuk link followers/following */
.followers-link,
.following-link {
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #fff;
}

.followers-link .follow-text,
.following-link .follow-text {
  position: relative;
  transition: color 0.2s ease;
}

.followers-link:hover .follow-text,
.following-link:hover .follow-text {
  color: #515151;
}

.followers-link:hover .follow-text::after,
.following-link:hover .follow-text::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 1px;
  background-color: #515151;
  animation: underlineAppear 0.2s ease forwards;
}

@keyframes underlineAppear {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 100%;
    opacity: 1;
  }
}

/* Angka tetap tanpa underline */
.followers-link #follower-count,
.following-link #following-count {
  font-weight: 600;
  color: #fff;
  transition: color 0.2s ease;
}

.followers-link:hover #follower-count,
.following-link:hover #following-count {
  color: #515151;
}
















/* CSS untuk follow popup */
.follow-tabs {
  display: flex;
  border-bottom: 1px solid #333;
  margin: 0 20px;
}

.follow-tab {
  flex: 1;
  padding: 15px;
  background: none;
  border: none;
  color: #aaa;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.follow-tab.active {
  color: #fff;
}

.follow-tab.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 3px;
  background: #1db954;
  border-radius: 3px 3px 0 0;
}

.follow-container {
  padding: 20px;
}

.search-follow {
  position: relative;
  margin-bottom: 20px;
}

.empty-state {
  text-align: center;
  padding: 40px 20px;
  color: #aaa;
}

.empty-state i {
  font-size: 48px;
  margin-bottom: 15px;
  opacity: 0.5;
}


.loading-state {
  text-align: center;
  padding: 40px 20px;
}

.spinner {
  border: 3px solid #333;
  border-top: 3px solid #1db954;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
  margin: 0 auto 15px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}


    </style>
  </head>

  <body>


<header class="playlist-header profile-head">
   <div class="header-content">
        <button class="back-button" onclick="backLeft()">
          <i class="fa-solid fa-circle-chevron-left"></i>
        </button>
        <div class="header-text-container">
          <h1 class="header-title"><%= userProfile.name_user %></h1>
          <p class="header-subtitle muted">User Profile</p>
        </div>
    </div>
</header>



    <div class="banner">
      <div class="banner-img-wrapper banner-profile">
        <div class="nav-icons">
          <i onclick="backLeft()" class="fa-solid fa-circle-chevron-left"></i>
          <i onclick="backRight()" class="fa-solid fa-circle-chevron-right"></i>
        </div>

        <div class="banner-content">
          <div class="banner-img-container">
            <img
              src="<%= userProfile.profile_user || '/uploads/profile/default/default_pp.jpg' %>"
              class="banner-img profile-img" referrerpolicy="no-referrer"
            />
          </div>
          <div class="banner-text">
            <div class="banner-text-content">

                <h3><%= userProfile.name_user %></h3>
                <p class="muted">Users Profile</p>



                <p class="playlist-description">
  <span class="followers-link" onclick="showFollowPopup('followers', '<%= userProfile.original_id %>')">
    <span id="follower-count"><%= userProfile.user_followers || 0 %></span> 
    <span class="follow-text">followers</span>
  </span> 
  | 
  <span class="following-link" onclick="showFollowPopup('following', '<%= userProfile.original_id %>')">
    <span id="following-count"><%= userProfile.total_following || 0 %></span> 
    <span class="follow-text">following</span>
  </span>
</p>

              
            </div>
            <div class="playlist-stats">
              <div onclick="share()" class="stat-item">
                <i class="fa-solid fa-share"></i>
              </div>

              <% if (isOwnProfile) { %>
             <button id="btn-button" class="button-profile" onclick="editProfile('<%= userProfile.hashid %>')">
                <div class="notice-content">
                  <div class="lable-button">Edit Profile</div>
                </div>
              </button>
              <% } else { %>
          <button id="btn-follow-user" class="button-profile" 
        onclick="toggleFollowUser(this, '<%= userProfile.original_id %>')">
  <div class="content-avatar">
    <div class="status-user"></div>
    <div class="avatar">
      <svg class="user-img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,12.5c-3.04,0-5.5,1.73-5.5,3.5s2.46,3.5,5.5,3.5,5.5-1.73,5.5-3.5-2.46-3.5-5.5-3.5Zm0-.5c1.66,0,3-1.34,3-3s-1.34-3-3-3-3,1.34-3,3,1.34,3,3,3Z"></path></svg>
    </div>
  </div>
  <div class="notice-content <%= isFollowing ? 'following' : '' %>">
    <div class="lable-button"><%= isFollowing ? 'Following' : 'Follow' %></div>
  </div>
</button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>









<!-- Tambahkan section ini di profile.ejs setelah banner profile -->
<div class="other-page">
  <div class="carousel__wrapper">
     <% if (userCustomPlaylists && userCustomPlaylists.length > 0) { %>
    <div class="carousel__header">
      <h2 class="carousel__headline">Playlist Custom</h2>
    </div>
     <% } %>
    <div class="carousel__content homeContent">
      <% if (userCustomPlaylists && userCustomPlaylists.length > 0) { %>
        <% userCustomPlaylists.forEach((playlist) => { %>
          <div class="card-container">
            <div class="visual-card carousel__item" onclick="showCustomPlaylist('<%= playlist.hashid %>')">
              <% 
                // Logic untuk menentukan tampilan cover
                const uniqueCovers = playlist.track_covers ? [...new Set(playlist.track_covers)] : [];
                const showCollage = playlist.track_count > 1 && uniqueCovers.length > 1;
                const displayCovers = uniqueCovers.slice(0, 4);
                const effectiveCover = playlist.track_covers && playlist.track_covers.length > 0 ? 
                                    playlist.track_covers[0] : 
                                    playlist.cover || '/images/default-playlist.png';
              %>
              
              <div class="visual-image" style="<%= showCollage ? '' : 'background-image: url(\'' + effectiveCover + '\')' %>">
                <% if (showCollage) { %>
                  <!-- Collage cover untuk playlist dengan multiple tracks DAN different covers -->
                  <div class="collage-grid" style="grid-template-columns: repeat(2, 1fr); grid-template-rows: <%= displayCovers.length > 2 ? 'repeat(2, 1fr)' : '1fr' %>;">
                    <% displayCovers.forEach((cover, index) => { %>
                      <div 
                        class="collage-item" 
                        style="background-image: url('<%= cover %>'); <%= 
                          displayCovers.length === 3 && index === 2 ? 'grid-column: span 2;' : '' 
                        %>"
                      ></div>
                    <% }); %>
                  </div>
                <% } %>
                <div class="text-background"></div>
                <div class="visual-overlay"></div>
              </div>
              
              <div class="svg-circle-wrapper" onclick="event.stopPropagation(); playPlaylist('<%= playlist.hashid %>', 'custom')">
                <svg class="svg-icon playlistCover-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M5 21V3c0-.79116579.87524596-1.26900738 1.54075759-.84117848L20.5407576 11.1588215c.6123232.3936364.6123232 1.2887206 0 1.682357l-14.00000001 9C5.87524596 22.2690074 5 21.7911658 5 21zm2-1.8316655L18.1507426 12 7 4.8316655v14.336669z"/>
                </svg>
              </div>
            </div>
            
            <div class="card-text-content">
              <div class="visual-title"><%= playlist.name %></div>
              <div class="visual-description">
                <%= playlist.track_count || 0 %> <%= playlist.track_count === 1 ? 'track' : 'tracks' %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <!-- Empty state jika user tidak memiliki playlist -->
        <div class="empty-playlist-state">
          <div class="empty-playlist-icon">
           <i class="fa-regular fa-circle-play"></i>
          </div>
          <h3 class="empty-playlist-title">No Playlists Yet</h3>
          <p class="empty-playlist-description">
            <%= userProfile.name_user %> hasn't created any playlists yet.
          </p>
        </div>
      <% } %>
    </div>
  </div>
</div>


<div style="display: none;" class="popup editProfile bigPopup">
  <div class="popup-overlay"></div>
  <div class="popup-content">
    <form id="profileForm" onsubmit="return submitEditProfile(event)" autocomplete="off" style="display: contents">
      <div class="drag-handle">
        <div class="drag-handle-line"></div>
      </div>

      <div class="popup-header">
        <h3>Edit Profile</h3>
        <i onclick="closePopup()" class="fa-solid fa-xmark"></i>
      </div>

      <div class="playlist-creator">
        <div class="playlist-cover-container">
          <div class="user-cover-preview" id="userCoverPreviewContainer">
            <img id="userCoverPreview" src="/uploads/undefine.jpg" alt="Profile picture" 
                 class="playlist-cover-image" referrerpolicy="no-referrer"
                 onerror="this.src='/uploads/undefine.jpg'">
            <div class="cover-upload-overlay" id="coverUploadOverlay">
              <div class="upload-options" id="uploadOptions">
                <div class="upload-option" onclick="handleChangePhoto()">
                  <i class="fas fa-camera"></i>
                  <span>Change Photo</span>
                </div>
                <div class="upload-option remove-photo-option" onclick="handleRemovePhoto()" style="display: flex;">
                  <i class="fa-solid fa-circle-minus"></i>
                  <span>Remove Photo</span>
                </div>
              </div>
            </div>
            <input type="file" id="userCoverUpload" name="cover" 
                   accept="image/jpeg,image/png,image/jpg,image/webp" 
                   style="display: none;">
          </div>
        </div>

        <div class="playlist-info">
          <div class="form-group">
            <label for="userName">Username</label>
            <input type="text" id="userName" name="name" maxlength="50" placeholder="Enter Username">
            <div class="error-message" id="errorusernm"></div>
          </div>
          
          <input type="hidden" id="userId" name="userId" value="">
          <!-- Tambahkan hidden input untuk menandai remove photo -->
          <input type="hidden" id="removePhotoFlag" name="removePhoto" value="0">
        </div>
      </div>

      <div class="popup-actions">
        <button type="button" onclick="closePopup()" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary">
          <span class="btn-text">Save Changes</span>
        </button>
      </div>
    </form>
  </div>
</div>





<!-- Popup untuk followers/following -->
<div style="display: none;" class="popup follow bigPopup">
  <div class="popup-overlay"></div>
  <div class="popup-content">
    <div class="drag-handle">
      <div class="drag-handle-line"></div>
    </div>

    <div class="popup-header">
      <h3 id="followPopupTitle">Followers</h3>
      <i onclick="closePopup()" class="fa-solid fa-xmark"></i>
    </div>

    <div class="follow-tabs">
      <button class="follow-tab active" onclick="switchFollowTab('followers')">Followers</button>
      <button class="follow-tab" onclick="switchFollowTab('following')">Following</button>
    </div>

    <div class="follow-container">
      <div class="search-follow">
        <input type="text" id="followSearch" placeholder="Search..." autocomplete="off">
        <i class="fas fa-search"></i>
      </div>
      
      <div class="follow-list" id="followersList">
        <!-- Data akan diisi oleh JavaScript -->
      </div>

      <div class="follow-list" id="followingList" style="display: none;">
        <!-- Data akan diisi oleh JavaScript -->
      </div>

      <div class="empty-state" id="emptyState" style="display: none;">
        <i class="fas fa-users"></i>
        <p>No data available</p>
      </div>

      <div class="loading-state" id="loadingState" style="display: none;">
        <div class="spinner"></div>
        <p>Loading...</p>
      </div>
    </div>
  </div>
</div>



    <footer class="row center"></footer>
    
  </body>
</html>
