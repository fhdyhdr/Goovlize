<!DOCTYPE html>
<html lang="en">
  <head>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta charset="UTF-8" />
    <title><%= userProfile.name_user %> - Profile</title>
    <link rel="stylesheet" href="/css/n.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      /* Styles sama seperti playlist */
      .dropdown-container {
        position: relative;
        display: inline-block;
      }
      .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background-color: #2a292f;
        min-width: 180px;
        z-index: 1;
        border-radius: 6px;
      }
      .dropdown-content a {
        color: #fff;
        padding: 10px 14px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
      }
      .dropdown-content i {
        font-size: 15px;
      }
      .dropdown-content a:hover {
        background-color: #1b1b1b;
      }
      .show {
        display: block;
      }
      .dropdown-submenu {
        position: relative;
      }
      .dropdown-submenu > a {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        color: #fff;
        font-size: 14px;
        gap: 10px;
      }
      .dropdown-submenu > a:hover {
        background-color: #1b1b1b;
      }
      .arrow {
        margin-left: auto;
        font-size: 20px;
        opacity: 0.7;
      }
      .submenu-content {
        display: none;
        position: absolute;
        top: 0;
        right: 100%;
        background-color: #37353e;
        min-width: 160px;
        border-radius: 6px;
        z-index: 2;
      }
      .submenu-content a {
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #fff;
        font-size: 14px;
      }
      .submenu-content a:hover {
        background-color: #1b1b1b;
      }
      .dropdown-submenu:hover .submenu-content {
        display: block;
      }
      .playlist-name {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2em;
        max-height: calc(1.2em * 3);
      }

      /* PERBAIKAN: Track album hover area */
      .track-album {
        font-size: 0.875rem;
        color: var(--text_muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: left;
        position: relative;
        display: block; /* PERUBAHAN: dari inline-block ke block */
        cursor: pointer;
        width: 100%; /* PERUBAHAN: agar memenuhi container */
      }

      /* Hover hanya pada teks, bukan seluruh area */
      :root[style*="--device: desktop"] .track-album:hover {
        text-decoration: underline;
      }

      /* PERBAIKAN: Container untuk track-album agar benar-benar rata kiri */
      .track-album-container {
        flex: 1;
        display: block; /* PERUBAHAN: dari flex ke block */
        padding: 0 1rem;
        text-align: left; /* PERUBAHAN: pastikan rata kiri */
        min-width: 0; /* PERUBAHAN: penting untuk text ellipsis */
      }

      /* PERBAIKAN: Track number dengan width tetap untuk alignment */
      .track-number {
        margin-right: 10px;
        min-width: 25px; /* PERUBAHAN: Lebar sedikit lebih besar untuk angka 2 digit */
        text-align: center;
        display: inline-block;
        font-variant-numeric: tabular-nums; /* Agar angka memiliki lebar yang konsisten */
        flex-shrink: 0; /* PERUBAHAN: agar tidak mengecil */
      }

      .banner-profile .banner-img-container {
        border-radius: 50%;
        width: clamp(160px, 20cqi, 279px);
        height: clamp(160px, 20cqi, 279px);
      }

      .banner-profile .banner-img-container img {
        border-radius: 50%;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      @media only screen and (orientation: landscape) {

        :root[style*="--device: mobile"] .banner-text-content {
          gap: clamp(0.01rem, 0.4cqi, 1rem);
        }
      }

      #btn-follow-user, #btn-button {
        --text-color: rgb(255, 255, 255);
        --bg-color-sup: #404040;
        --bg-color: linear-gradient(
          135deg,
          #2c3e50 0%,
          #34495e 50%,
          #2c3e50 100%
        );
        --bg-hover-color: linear-gradient(
          135deg,
          #34495e 0%,
          #2c3e50 50%,
          #34495e 100%
        );
        --online-status: #1abc9c;
        --font-size: 16px;
        --btn-transition: all 0.3s ease-out;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .button-profile {
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 0 2.17382px rgba(0, 0, 0, 0.049),
          0 1.75px 6.01034px rgba(0, 0, 0, 0.07),
          0 3.63px 14.4706px rgba(0, 0, 0, 0.091),
          0 22px 48px rgba(0, 0, 0, 0.14);
        background-color: var(--bg-color);
        border-radius: 68px;
        cursor: pointer;
        width: fit-content;
        border: 0;
        overflow: hidden;
        position: relative;
      }

      .button-profile:active {
        transform: scale(0.99);
      }

      .content-avatar {
        margin: 0;
        transition: var(--btn-transition);
        position: relative;
      }

      .avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        overflow: hidden;
        background-color: var(--bg-color-sup);
      }

      .user-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .status-user {
        position: absolute;
        width: 6px;
        height: 6px;
        right: 1px;
        bottom: 1px;
        border-radius: 50%;
        outline: solid 2px var(--bg-color);
        background-color: var(--online-status);
        transition: var(--btn-transition);
      }

      .notice-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 0 11px;
        text-align: initial;
        color: var(--text-color);
      }

      @container music-container (min-width: 0) {
        .button-profile {
          padding: clamp(4px, 1cqi, 8px) clamp(6px, 2cqi, 10px);
          height: clamp(48px, 5cqi, 55px);
        }

        .content-avatar {
          width: clamp(33px, 5cqi, 40px);
          height: clamp(33px, 5cqi, 40px);
        }

        .lable-button {
          font-size: clamp(0.95em, 1cqi, 1.2em);
        }
      }

      .followers{
        margin-right: 30px;
      }.other-page .carousel__wrapper {
  margin-bottom: 32px;
  padding: 0 50px;
}

.other-page .carousel__header {
  margin-bottom: 20px;
  padding: 0;
}

.other-page .carousel__controls {
  display: none;
}

.other-page .carousel__content {
  overflow: visible !important;
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 20px;
  cursor: default;
  padding: 0 !important;
  margin: 0 !important;
}

.other-page .card-container {
  width: 100% !important;
  /* Pastikan container tidak melebar karena content */
  min-width: 0; /* Penting untuk mencegah overflow */
}

.other-page .visual-card {
  width: 100% !important;
  /* Buat card persegi dengan aspect ratio 1:1 */
  aspect-ratio: 1 / 1;
  height: auto !important;
  /* Pastikan card tidak melebar */
  min-width: 0;
}

.other-page .card-text-content {
  min-height: 55px;
  padding: 0 4px;
  margin-top: 8px;
  /* Pastikan text content tidak melebar */
  min-width: 0;
  width: 100%;
}

.other-page .visual-title {
  font-size: 0.9em;
  margin-bottom: 4px;
  /* PERBAIKAN: Tambahkan text truncation */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  min-width: 0;
  line-height: 1.3;
}

.other-page .visual-description {
  font-size: 0.8em;
  line-height: 1.4;
  /* PERBAIKAN: Tambahkan text truncation untuk description juga */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  min-width: 0;
  color: #b3b3b3;
}

.other-page .svg-circle-wrapper {
  width: 2.8rem;
  height: 2.8rem;
}

.other-page .svg-circle-wrapper .svg-icon {
  width: 1.6rem;
  height: 1.6rem;
}

/* Collage Grid Styles - PERBAIKAN: Pastikan collage tidak overflow */
.visual-image {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 8px;
  overflow: hidden;
  /* Pastikan image container tidak melebar */
  min-width: 0;
}

.collage-grid {
  display: grid;
  width: 100%;
  height: 100%;
  gap: 2px;
  border-radius: 8px;
  overflow: hidden;
}

.collage-item {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  /* Pastikan collage item tidak overflow */
  min-width: 0;
}

/* Responsive adjustments */
@media (max-width: 1200px) {
  .other-page .carousel__content {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 18px;
  }
}

@media (max-width: 1000px) {
  .other-page .carousel__wrapper {
    padding: 0 30px;
  }
  
  .other-page .carousel__content {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
  
  .other-page .card-text-content {
    min-height: 50px;
  }
  
  .other-page .visual-title {
    font-size: 0.85em;
  }
}

@media (max-width: 768px) {
  .other-page .carousel__content {
    /* 3 kolom di tablet */
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  
  .other-page .card-text-content {
    min-height: 45px;
  }
  
  .other-page .visual-title {
    font-size: 0.85em;
  }
  
  .other-page .visual-description {
    font-size: 0.75em;
  }
  
  .other-page .svg-circle-wrapper {
    width: 2.5rem;
    height: 2.5rem;
  }
  
  .other-page .svg-circle-wrapper .svg-icon {
    width: 1.4rem;
    height: 1.4rem;
  }
}

@media (max-width: 480px) {
  .other-page .carousel__wrapper {
    padding: 0 20px;
  }
  
  .other-page .carousel__content {
    /* Tetap 3 kolom di mobile */
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  
  .other-page .card-text-content {
    min-height: 40px;
  }
  
  .other-page .visual-title {
    font-size: 0.8em;
  }
  
  .other-page .visual-description {
    font-size: 0.7em;
  }
  
  .other-page .svg-circle-wrapper {
    width: 2.2rem;
    height: 2.2rem;
  }
  
  .other-page .svg-circle-wrapper .svg-icon {
    width: 1.2rem;
    height: 1.2rem;
  }
}

/* Untuk layar sangat kecil, 2 kolom dengan text yang lebih ketat */
@media (max-width: 360px) {
  .other-page .carousel__content {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  
  .other-page .card-text-content {
    min-height: 35px;
    padding: 0 2px; /* Kurangi padding */
  }
  
  .other-page .visual-title {
    font-size: 0.75em;
    line-height: 1.2;
  }
  
  .other-page .visual-description {
    font-size: 0.65em;
    line-height: 1.2;
  }
  
  .other-page .svg-circle-wrapper {
    width: 2rem;
    height: 2rem;
  }
  
  .other-page .svg-circle-wrapper .svg-icon {
    width: 1rem;
    height: 1rem;
  }
}

/* Hover effects */
.other-page .visual-card:hover .svg-circle-wrapper,
.other-page .visual-card:active .svg-circle-wrapper,
.other-page .visual-card:focus .svg-circle-wrapper {
  transform: translateY(0);
  opacity: 1;
}

/* Empty state styles */
.empty-playlist-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 40px 20px;
  color: #b3b3b3;
}

.empty-playlist-icon {
  margin-bottom: 20px;
  opacity: 0.7;
}

.empty-playlist-title {
  margin-bottom: 8px;
  color: #ffffff;
}

.empty-playlist-description {
  line-height: 1.4;
}

#errorusernm{
  margin-top: 18px;
}




.user-cover-preview {
  border-radius: 50%;
  border: 3px solid #fff;
}

.user-cover-preview:hover .cover-upload-overlay {
  opacity: 1;
  visibility: visible;
}

.playlist-cover-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: all 0.3s ease;
}

.user-cover-preview:hover .playlist-cover-image {
  filter: brightness(0.7);
}

/* Overlay untuk upload options */
.cover-upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 10;
}

/* Container untuk kedua opsi */
.upload-options {
  display: flex;
  flex-direction: column;
  gap: 10px; /* Jarak antara kedua opsi */
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 10px;
}

/* Style untuk setiap opsi */
.upload-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  cursor: pointer;
  padding: 9px 10px;
  border-radius: 8px;
  transition: all 0.2s ease;
  width: 100%;
  max-width: 140px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(5px);
}




.upload-option i {
  font-size: 24px;
}

.upload-option span {
  font-size: 13px;
}

.upload-option:last-child i {
  color: #ff6b6b;
}

.upload-option:last-child:hover {
  background: rgba(255, 107, 107, 0.15);
}

.upload-option:last-child:hover i {
  color: #ff5252;
}
.upload-option:hover {
  background: rgba(255, 255, 255, 0.2);
}

:root[style*="--device: mobile"] .user-cover-preview{
  width: 190px;
  height: 190px;
}
:root[style*="--device: mobile"] .upload-option i{
font-size: 20px;
}

:root[style*="--device: mobile"] .upload-option span{
font-size: 10px;
}
:root[style*="--device: mobile"]  .upload-option {
  padding: 6px 6px;
  max-width: 90px;
}


@media only screen and (orientation: landscape) {
  :root[style*="--device: mobile"] .upload-option span{
      display: none;
  }
  :root[style*="--device: mobile"]  .upload-option {
    max-width: 50px;
    padding: 5px;
  }
  :root[style*="--device: mobile"] .upload-options {
    gap: 5px;
  }
  :root[style*="--device: mobile"] .upload-option i{
    margin-top:4px;
  }

}





