}

.search-follow input:focus {
  outline: none;
  border-color: #515151;
  background-color: #333;
}

.search-follow .fa-search {
  position: absolute;
  left: 32px;
  top: 50%;
  transform: translateY(-50%);
  color: #888;
  font-size: 14px;
}

/* Follow list */
