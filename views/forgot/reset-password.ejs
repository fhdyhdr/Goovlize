<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Forgot</title>
    <link rel="stylesheet" href="/css/login.css" />
    <link
      href="https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css"
      rel="stylesheet"
    />
    <script src="/js/login.js" defer></script>
  </head>
  <body>
    <main>
      <div class="box">
    
         
        <form id="resetPass"
        onsubmit="return validateReset()"
        action="/reset-password"
        method="POST"
        autocomplete="off"
        class="sign-in-form">
  
              <div class="logo">
                <img
                   src="/uploads/goovlize.jpeg"
                  alt="easyclass"
                />
                <h4>Goovlize</h4>
              </div>

              <div class="heading">
                <h2 style="font-size: 1.8rem">Reset Password</h2>

                <p style="margin-top: 20px" class="text">
                  Please enter and confirm your new password to continue
                </p>
                <div style="display: none" id="alert-container"></div>
              </div>

             

              <div class="actual-form">
                <div class="input-wrap">
                  <input
                    type="text"
                    class="input-field pass1-input"
                    autocomplete="off"
                    name="password1"
                  />
                  <label>Password</label>

                  
                </div>

                <div style="margin-bottom: 70px;" class="input-wrap">
                  <input
                    type="password"
                    class="input-field pass2-input"
                    autocomplete="off"
                    name="password2"
                  />
                  <label>Confirm Password</label>

                  <i class='bx bx-hide eye-icon' onclick="togglePassword()"></i>

                </div>



                <input type="submit" value="Change Password" class="sign-btn" />

                <div class="heading btm">
                  <h6>© 2026 Goovlize. All rights reserved</h6>
                  <h6>Committed to your security and convenience</h6>
                  
                </div>
              </div>
            </form>


   

  
     
      </div>
    </main>
    
  </body>
</html>
