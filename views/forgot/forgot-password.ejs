<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Forgot</title>
    <link rel="stylesheet" href="/css/login.css" />
    <link
      href="https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css"
      rel="stylesheet"
    />
    <script src="/js/login.js" defer></script>
  </head>
  <body>
    <main>
      <div class="box">
        <div class="inner-box">
          <div class="forms-wrap">
            <form id="emailSend"
              onsubmit="return validateSendEmail()"
              action=""
              method="POST"
              autocomplete=""
              class="sign-in-form"
            >
              <div class="logo">
                <img
                  src="/uploads/goovlize.jpeg"
                  alt="easyclass"
                />
                <h4>Goovlize</h4>
              </div>

              <div class="heading">
                <h2 style="font-size: 1.8rem">Forgot Password</h2>

                <p style="margin-top: 20px" class="text">
                  Enter your registered email address to receive a one-time
                  password (OTP) and reset your account password
                </p>
                <div style="display: none" id="alert-container"></div>
              </div>

             

              <div class="actual-form">
                <div class="input-wrap">
                  <input
                    type="text"
                    class="input-field email-input"
                    autocomplete="off"
                    name="email"
                  />
                  <label>Email</label>
                </div>

                <input type="submit" value="Send Email" class="sign-btn" />

                <div class="heading btm">
                  <h6>Back to</h6>
                  <a href="/login" class="resendBtn">Login</a>
                </div>
              </div>
            </form>

            <form
              id="registerForm"
              onsubmit="return validateOTP()"
              autocomplete=""
              class="sign-up-form"
            >
              <div class="logo">
                <img
                   src="/uploads/goovlize.jpeg"
                  alt="easyclass"
                />
                <h4>Goovlize</h4>
              </div>

              <div class="heading">
                <h2 style="font-size: 1.8rem">OTP Verification</h2>

                <p style="font-size: 0.9rem; margin-top: 20px">
                  Enter the OTP you received to <span id="useremail"></span>
                </p>

                <div style="display: none" id="danger-container"></div>
                
              </div>


              <div class="actual-form">
                <div class="container">
                  <p><span id="email"></span></p>
                  <div class="otp-input">
                    <input type="number" min="0" max="9" />
                    <input type="number" min="0" max="9" />
                    <input type="number" min="0" max="9" />
                    <input type="number" min="0" max="9" />
                    <input type="number" min="0" max="9" />
                  </div>
                </div>

                <input type="submit" value="Submit" class="sign-btn" />

       

                <p style="font-size:0.7rem; margin-top: 20px;" class="text">
                  Didn't receive the code? You can request a new one in <span id="countdown">30</span> seconds
                  <a href="#" id="resend-btn" onclick="resendOTP()" disabled class="resendBtn">Resend Code</a>
                </p>
              </div>
            </form>
          </div>

          <div class="carousel">
            <div class="images-wrapper">
              <img
                src="/uploads/forget.jpeg"
                class="image img-1 show"
                alt=""
              />
            
            </div>

            
          </div>
        </div>
      </div>
    </main>
    
  </body>
</html>
