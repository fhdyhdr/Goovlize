            </div>

            <!-- Artist Management Content -->
            <div class="artist-management-container">
                <!-- Header dengan Actions -->
                <div class="artist-header">
                    <h1><i class="fas fa-user"></i> Artist Library</h1>
                    <div class="header-actions">
                        <button class="btn-primary" onclick="addArtist()">
                            <i class="fas fa-plus"></i>
                            Add Artist
                        </button>
                    </div>
                </div>

                <!-- Filters -->
                <div class="artist-filters">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label><i class="fas fa-search"></i> Search Artists</label>
                            <div class="search-container" style="position: relative;">
                                <input type="text" class="filter-input" placeholder="Search artists..." id="quickSearch" onkeyup="applyFilters()">
                                <button class="clear-search" onclick="clearSearch()" style="display: none;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Loading indicator -->
                    <div id="filterLoading" class="filter-loading" style="display: none;">
                        <i class="fas fa-spinner fa-spin"></i> Loading...
                    </div>
                </div>

                <!-- Artist List -->
                <div class="artist-list-container">
                    <!-- Body -->
                    <div class="artist-list-body" id="artistList">
                        <% if (artistList && artistList.length > 0) { %>
                            <% artistList.forEach((artist, index) => { %>
                                <div class="artist-item" data-id="<%= artist.id_artist %>">
                                    <div class="artist-header-info">
                                        <div class="artist-profile">
                                            <img src="<%= artist.artist_profile || '/uploads/undefine.jpg' %>" 
                                                 alt="<%= artist.artist_name %>"
                                                 onerror="this.src='/uploads/undefine.jpg'">
                                            <div class="artist-profile-overlay">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        </div>
                                        <div class="artist-details">
                                            <h4><%= artist.artist_name %></h4>
                                            <p><i class="fas fa-calendar"></i> Joined <%= artist.formatted_date %></p>
                                        </div>
                                    </div>
                                    
                                    <div class="artist-content">
                                        <div class="artist-stats">
                                            <div class="stat-item">
                                                <div class="stat-value"><%= artist.total_songs %></div>
                                                <div class="stat-label">Songs</div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-value"><%= artist.total_playlists %></div>
                                                <div class="stat-label">Playlists</div>
                                            </div>
                                        </div>
                                        
                                        <div class="artist-description">
                                            <% if (artist.total_songs > 0) { %>
                                                <%= artist.artist_name %> has <%= artist.total_songs %> songs in <%= artist.total_playlists %> playlists
                                            <% } else { %>
                                                No songs yet
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="artist-footer">
                                        <div class="artist-date">
                                            <i class="fas fa-clock"></i>
                                            <%= artist.formatted_date %>
                                        </div>
                                        <div class="artist-actions">
                                            <button class="action-btn action-edit" title="Edit" onclick="editArtist('<%= artist.id_artist %>')">
                                                <i class="fas fa-edit"></i>
                                                <span class="btn-tooltip">Edit</span>
                                            </button>
                                            <button class="action-btn action-delete" title="Delete" onclick="deleteArtist('<%= artist.id_artist %>', '<%= artist.artist_name %>')">
                                                <i class="fas fa-trash"></i>
                                                <span class="btn-tooltip">Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
