    <!-- Edit Artist Popup -->
    <div style="display: none;" class="popup editArtistPopup bigPopup">
        <div class="popup-overlay"></div>
        <div class="popup-content">
            <form id="editArtistForm" onsubmit="return submitEditArtist(event)" autocomplete="off" style="display: contents" enctype="multipart/form-data">
                <div class="drag-handle">
                    <div class="drag-handle-line"></div>
                </div>

                <div class="popup-header">
