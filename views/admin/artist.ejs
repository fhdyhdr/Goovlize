                                <i class="fas fa-user"></i>
                                <h3>No Artists Found</h3>
                                <p>
                                    <% if (currentFilters.search) { %>
                                        No artists found for "<%= currentFilters.search %>"
                                    <% } else { %>
                                        Start by adding your first artist!
                                    <% } %>
                                </p>
                                <button class="btn btn-primary" onclick="addArtist()">
                                    Add Artist
                                </button>
                            </div>
                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <div class="artist-pagination">
                        <div class="pagination-info">
                            <% if (artistList && artistList.length > 0) { %>
                                Showing <span id="startItem"><%= (currentPage - 1) * 20 + 1 %></span>-<span id="endItem"><%= Math.min(currentPage * 20, totalArtists) %></span> 
                                of <span id="totalItems"><%= totalArtists %></span> artists
                            <% } else { %>
                                Showing 0-0 of 0 artists
                            <% } %>
                        </div>
                        
                        <% if (totalPages > 1) { %>
                            <div class="pagination-controls">
                                <!-- Previous Button -->
                                <button class="pagination-btn <%= currentPage === 1 ? 'disabled' : '' %>" 
                                        id="prevPage" 
                                        onclick="<%= currentPage > 1 ? 'changePage(' + (currentPage - 1) + ')' : '' %>"
                                        <%= currentPage === 1 ? 'disabled' : '' %>>
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                
                                <!-- Page Numbers -->
                                <div class="page-numbers" id="pageNumbers">
                                    <% 
                                    let startPage = Math.max(1, currentPage - 2);
                                    let endPage = Math.min(totalPages, startPage + 4);
                                    
                                    if (endPage - startPage < 4) {
                                        startPage = Math.max(1, endPage - 4);
                                    }
                                    
                                    for (let i = startPage; i <= endPage; i++) { 
                                    %>
                                        <button class="page-number <%= i === currentPage ? 'active' : '' %>" 
                                                onclick="changePage(<%= i %>)">
                                            <%= i %>
                                        </button>
                                    <% } %>
                                </div>
                                
                                <!-- Next Button -->
                                <button class="pagination-btn <%= currentPage === totalPages ? 'disabled' : '' %>" 
                                        id="nextPage" 
                                        onclick="<%= currentPage < totalPages ? 'changePage(' + (currentPage + 1) + ')' : '' %>"
                                        <%= currentPage === totalPages ? 'disabled' : '' %>>
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Artist Popup -->
