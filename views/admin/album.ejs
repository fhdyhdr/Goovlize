            // Edit artist search
            document.getElementById('editArtistSearch')?.addEventListener('input', function(e) {
                filterArtistOptions('editArtistOptions', e.target.value);
            });

            document.getElementById('editArtistSearch')?.addEventListener('focus', function() {
                closeOtherDropdowns('editArtistOptions');
                document.getElementById('editArtistOptions').classList.add('active');
            });
        }

        function showNewArtistInputForEdit() {
            document.getElementById('editArtistOptions').classList.remove('active');
            document.getElementById('editAddNewArtist').style.display = 'flex';
            document.getElementById('editNewArtistName').focus();
            hideEditArtistMessage();
        }

        function cancelNewArtistForEdit() {
            document.getElementById('editAddNewArtist').style.display = 'none';
            document.getElementById('editNewArtistName').value = '';
            hideEditArtistMessage();
        }

        async function addNewArtistForEdit() {
            const newName = document.getElementById('editNewArtistName').value.trim();
            
            if (!newName) {
                showEditArtistErrorMessage('Please enter artist name');
                return;
            }
            
            if (newName.length > 30) {
                showEditArtistErrorMessage('Artist name must be 30 characters or less');
                return;
            }
            
            try {
                showEditArtistLoadingMessage('Adding artist...');
                
                const response = await fetch('/admin/album/add-artist', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ artist_name: newName })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Clear and hide input
                    cancelNewArtistForEdit();
                    
                    // Refresh artists data for edit
                    await refreshArtistsDataForEdit();
                    
                    // Select the new artist
                    selectEditArtist(result.artist.id_artist, result.artist.artist_name);
                    
                    // Show success message
                    showEditArtistSuccessMessage('Artist added successfully!');
                    
                    // Hide message after 3 seconds
                    setTimeout(() => {
                        hideEditArtistMessage();
                    }, 3000);
                } else {
                    showEditArtistErrorMessage(result.message || 'Failed to add artist');
                }
            } catch (error) {
                console.error('Error adding artist:', error);
                showEditArtistErrorMessage('Failed to add artist. Please try again.');
            }
        }

        async function refreshArtistsDataForEdit() {
            try {
                const response = await fetch('/admin/album/get-artists', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                if (!response.ok) {
                    throw new Error('Failed to refresh artists');
                }
                
                const data = await response.json();
                
                if (data.success) {
                    editArtistsData = data.artists || [];
                    populateEditArtistOptions();
                }
            } catch (error) {
                console.error('Error refreshing artists for edit:', error);
            }
        }

