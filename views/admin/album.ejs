    <script src="/admin/js/dashboard.js"></script>
    <script>
        // Global variables
        let artistsData = [];
        let selectedArtist = null;
        let editArtistsData = [];
        let editSelectedArtist = null;
        let albumToDelete = null;

        // Filter variables
        let currentFilters = {
            search: '',
            artist: 'all',
            page: 1
        };
        let filterTimeout = null;
        let isFiltering = false;

        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            initializeFilters();
            setupEventListeners();
        });

        function setupEventListeners() {
            // Character counter for album name
            const albumNameInput = document.getElementById('albumName');
            if (albumNameInput) {
                albumNameInput.addEventListener('input', function() {
                    document.getElementById('albumNameCounter').textContent = this.value.length;
                });
            }

            // Edit album name character counter
            const editAlbumNameInput = document.getElementById('editAlbumName');
            if (editAlbumNameInput) {
                editAlbumNameInput.addEventListener('input', function() {
                    document.getElementById('editAlbumNameCounter').textContent = this.value.length;
                });
            }

            // Cover image upload
            const coverUpload = document.getElementById('albumCoverUpload');
            const coverPreview = document.getElementById('albumCoverPreview');
            const coverUploadOverlay = document.querySelector('.addAlbumPopup .cover-upload-overlay');
            
            if (coverUpload && coverPreview && coverUploadOverlay) {
                coverUploadOverlay.addEventListener('click', () => coverUpload.click());
                
                coverUpload.addEventListener('change', function(e) {
                    if (e.target.files.length) {
                        const file = e.target.files[0];
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                coverPreview.src = e.target.result;
                            };
                            reader.readAsDataURL(file);
                        }
                    }
                });
            }

            // Edit cover image upload
            const editCoverUpload = document.getElementById('editAlbumCoverUpload');
            const editCoverPreview = document.getElementById('editAlbumCoverPreview');
            const editCoverUploadOverlay = document.querySelector('.editAlbumPopup .cover-upload-overlay');
            
            if (editCoverUpload && editCoverPreview && editCoverUploadOverlay) {
                editCoverUploadOverlay.addEventListener('click', () => editCoverUpload.click());
                
                editCoverUpload.addEventListener('change', function(e) {
                    if (e.target.files.length) {
                        const file = e.target.files[0];
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                editCoverPreview.src = e.target.result;
                            };
                            reader.readAsDataURL(file);
                        }
                    }
                });
            }

            // Artist search event listeners
            const artistSearch = document.getElementById('artistSearch');
            if (artistSearch) {
                artistSearch.addEventListener('input', function(e) {
                    filterArtistOptions('artistOptions', e.target.value);
                });
                
                artistSearch.addEventListener('focus', function() {
                    closeOtherDropdowns('artistOptions');
                    document.getElementById('artistOptions').classList.add('active');
                });
            }

            const editArtistSearch = document.getElementById('editArtistSearch');
            if (editArtistSearch) {
                editArtistSearch.addEventListener('input', function(e) {
                    filterArtistOptions('editArtistOptions', e.target.value);
                });
                
                editArtistSearch.addEventListener('focus', function() {
                    closeOtherDropdowns('editArtistOptions');
                    document.getElementById('editArtistOptions').classList.add('active');
                });
            }

            // Close dropdowns when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.custom-select-container') && 
                    !e.target.closest('.add-new-option')) {
                    closeAllDropdowns();
                }
            });

            // Keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeAllDropdowns();
                }
            });
        }

        // ============ ADD ALBUM ============ //
        function addAlbum() {
            const popup = document.querySelector('.addAlbumPopup');
            const popupContent = popup.querySelector('.popup-content');
            var isMobile = isTrueMobile();

            // Reset form
            resetAddAlbumForm();
            
            // Load artists data
            loadArtistsData();

            if (isMobile) {
                popup.style.display = 'block';
                setTimeout(() => {
                    popup.classList.add('active');
                    if (popupContent) {
                        popupContent.style.transform = 'translateY(0)';
                    }
                }, 10);
            } else {
                $(".addAlbumPopup").show();
                $(".addAlbumPopup").addClass("active");
                $(".addAlbumPopup .popup-overlay").removeClass("fadeOut").addClass("fadeIn");
            }
        }

        function resetAddAlbumForm() {
            selectedArtist = null;
            document.getElementById('albumName').value = '';
            document.getElementById('albumNameCounter').textContent = '0';
            document.getElementById('albumNameError').textContent = '';
            document.getElementById('albumCoverPreview').src = '/uploads/undefine.jpg';
            document.getElementById('albumCoverUpload').value = '';
            document.getElementById('artistSearch').value = '';
            document.getElementById('artistTag').innerHTML = '';
            document.getElementById('addNewArtist').style.display = 'none';
            document.getElementById('newArtistName').value = '';
            hideArtistMessage();
            closeAllDropdowns();
        }

        async function loadArtistsData() {
            try {
                // Show loading state
                const artistOptions = document.getElementById('artistOptions');
                artistOptions.innerHTML = '<div class="select-option loading-option"><i class="fas fa-spinner fa-spin"></i> Loading artists...</div>';
                artistOptions.classList.add('active');

                const response = await fetch('/admin/album/get-artists', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                if (!response.ok) {
                    throw new Error('Failed to load artists');
                }
                
                const data = await response.json();
                
                if (data.success) {
                    artistsData = data.artists || [];
                    populateArtistOptions();
                } else {
                    throw new Error(data.message || 'Failed to load artists');
                }
            } catch (error) {
                console.error('Error loading artists:', error);
                showArtistErrorMessage('Failed to load artists. Please try again.');
                document.getElementById('artistOptions').innerHTML = `
                    <div class="select-option error-option">
                        <i class="fas fa-exclamation-circle"></i> Failed to load artists
                    </div>
                `;
            }
        }

        function populateArtistOptions() {
            const artistOptions = document.getElementById('artistOptions');
            artistOptions.innerHTML = '';
            
            if (artistsData && artistsData.length > 0) {
                artistsData.forEach(artist => {
                    const isSelected = selectedArtist && selectedArtist.id === artist.id_artist;
                    const option = document.createElement('div');
                    option.className = 'select-option';
                    if (isSelected) option.classList.add('selected');
                    option.dataset.value = artist.id_artist;
                    option.dataset.name = artist.artist_name;
                    option.innerHTML = `
                        <i class="fas fa-check option-check"></i>
                        ${artist.artist_name}
                    `;
                    option.onclick = () => selectArtist(artist.id_artist, artist.artist_name);
                    artistOptions.appendChild(option);
                });
            } else {
                artistOptions.innerHTML = `
                    <div class="select-option no-data">
                        No artists found
                    </div>
                `;
            }
            
            // Add "Add New Artist" option
            const newArtistOption = document.createElement('div');
            newArtistOption.className = 'select-option add-new-option';
            newArtistOption.innerHTML = '<i class="fas fa-plus"></i> Add New Artist';
            newArtistOption.onclick = () => showNewArtistInput();
            artistOptions.appendChild(newArtistOption);
        }

        function selectArtist(artistId, artistName) {
            selectedArtist = { id: artistId, name: artistName };
            updateArtistTag();
            updateArtistOption(artistId);
            document.getElementById('artistSearch').value = artistName;
            document.getElementById('artistOptions').classList.remove('active');
        }

        function updateArtistTag() {
            const artistContainer = document.getElementById('artistTag');
            artistContainer.innerHTML = '';
            
            if (selectedArtist) {
                const artist = document.createElement('div');
                artist.className = 'selected-artist';
                artist.innerHTML = `
                    ${selectedArtist.name}
                    <span class="artist-remove" onclick="removeArtist()">
                        <i class="fas fa-times"></i>
                    </span>
                `;
                artistContainer.appendChild(artist);
            }
        }

        function updateArtistOption(artistId) {
            document.querySelectorAll('#artistOptions .select-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            
            const option = document.querySelector(`#artistOptions .select-option[data-value="${artistId}"]`);
            if (option) {
                option.classList.add('selected');
            }
        }

        function removeArtist() {
            selectedArtist = null;
            updateArtistTag();
            document.querySelectorAll('#artistOptions .select-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            document.getElementById('artistSearch').value = '';
        }

        function filterArtistOptions(containerId, searchTerm) {
            const options = document.querySelectorAll(`#${containerId} .select-option`);
            searchTerm = searchTerm.toLowerCase();
            
            options.forEach(option => {
                const text = option.textContent.toLowerCase();
                if (text.includes(searchTerm) || option.classList.contains('add-new-option')) {
                    option.style.display = 'block';
                } else {
                    option.style.display = 'none';
                }
            });
        }

        function closeOtherDropdowns(currentDropdownId) {
            const dropdowns = ['artistOptions', 'editArtistOptions'];
            dropdowns.forEach(dropdownId => {
                if (dropdownId !== currentDropdownId) {
                    const dropdown = document.getElementById(dropdownId);
                    dropdown.classList.remove('active');
                }
            });
        }

        function closeAllDropdowns() {
            document.getElementById('artistOptions').classList.remove('active');
            document.getElementById('editArtistOptions').classList.remove('active');
        }

        function showNewArtistInput() {
            document.getElementById('artistOptions').classList.remove('active');
            document.getElementById('addNewArtist').style.display = 'flex';
            document.getElementById('newArtistName').focus();
            hideArtistMessage();
        }

        function cancelNewArtist() {
            document.getElementById('addNewArtist').style.display = 'none';
            document.getElementById('newArtistName').value = '';
            hideArtistMessage();
        }

async function addNewArtist() {
    const newName = document.getElementById('newArtistName').value.trim();
    
    if (!newName) {
        showArtistErrorMessage('Please enter artist name');
        return;
    }
    
    if (newName.length > 30) {
        showArtistErrorMessage('Artist name must be 30 characters or less');
        return;
    }
    
    try {
        showArtistLoadingMessage('Adding artist "' + newName + '"...');
        
        console.log('Sending artist data:', { artist_name: newName });
        
        const response = await fetch('/admin/album/add-artist', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ artist_name: newName })
        });
        
        console.log('Response status:', response.status);
        
        let result;
        try {
            result = await response.json();
        } catch (parseError) {
            console.error('Error parsing JSON:', parseError);
            const text = await response.text();
            console.error('Raw response:', text);
            throw new Error('Invalid response from server: ' + text);
        }
        
        console.log('Response data:', result);
        
        if (result.success) {
            // Clear and hide input
            cancelNewArtist();
            
            // Refresh artists data
            await refreshArtistsData();
            
            // Select the new artist - pastikan data artist ada
            if (result.artist) {
                selectArtist(result.artist.id_artist, result.artist.artist_name);
            } else {
                // Jika artist tidak ada di response, coba refresh dan pilih yang terbaru
                await refreshArtistsData();
                // Ambil artist terbaru dari data yang sudah direfresh
                if (artistsData && artistsData.length > 0) {
                    const latestArtist = artistsData[artistsData.length - 1];
                    if (latestArtist.artist_name === newName) {
                        selectArtist(latestArtist.id_artist, latestArtist.artist_name);
                    }
                }
            }
            
            // Show success message
            showArtistSuccessMessage(result.message || 'Artist added successfully!');
            
            // Hide message after 3 seconds
            setTimeout(() => {
                hideArtistMessage();
            }, 3000);
        } else {
            showArtistErrorMessage(result.message || 'Failed to add artist');
        }
    } catch (error) {
        console.error('Error adding artist:', error);
        console.error('Error details:', error.message, error.stack);
        showArtistErrorMessage('Failed to add artist: ' + error.message);
    }
}

        async function refreshArtistsData() {
            try {
                const response = await fetch('/admin/album/get-artists', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                if (!response.ok) {
                    throw new Error('Failed to refresh artists');
                }
                
                const data = await response.json();
                
                if (data.success) {
                    artistsData = data.artists || [];
                    populateArtistOptions();
                }
            } catch (error) {
                console.error('Error refreshing artists:', error);
            }
        }

        function showArtistErrorMessage(message) {
            const messageContainer = document.getElementById('artistMessageContainer');
            messageContainer.className = 'artist-message error';
            messageContainer.innerHTML = `
                <i class="fas fa-exclamation-circle"></i>
                <span>${message}</span>
            `;
            messageContainer.style.display = 'flex';
        }

        function showArtistLoadingMessage(message) {
            const messageContainer = document.getElementById('artistMessageContainer');
            messageContainer.className = 'artist-message info';
            messageContainer.innerHTML = `
                <i class="fas fa-spinner fa-spin"></i>
                <span>${message}</span>
            `;
            messageContainer.style.display = 'flex';
        }

        function showArtistSuccessMessage(message) {
            const messageContainer = document.getElementById('artistMessageContainer');
            messageContainer.className = 'artist-message info';
            messageContainer.innerHTML = `
                <i class="fas fa-check-circle"></i>
                <span>${message}</span>
            `;
            messageContainer.style.display = 'flex';
        }

        function hideArtistMessage() {
            const messageContainer = document.getElementById('artistMessageContainer');
            messageContainer.style.display = 'none';
        }

        async function submitAddAlbum(event) {
            event.preventDefault();
            
            // Validation
            const albumName = document.getElementById('albumName').value.trim();
            if (!albumName) {
                document.getElementById('albumNameError').textContent = 'Album name is required';
                return false;
            }

            if (!selectedArtist) {
                showArtistErrorMessage('Please select an artist');
                return false;
            }

            // Prepare form data
            const formData = new FormData();
            formData.append('album_name', albumName);
            formData.append('id_artist', selectedArtist.id);

            // Add cover image
            const coverFile = document.getElementById('albumCoverUpload').files[0];
            if (coverFile) {
                formData.append('cover', coverFile);
            }

            try {
                const response = await fetch('/admin/album/add', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showNotification('Album added successfully!', 'success');
                    closeAddAlbumPopup();
                    window.location.reload();
                } else {
                    showNotification(result.message || 'Failed to add album', 'error');
                }
            } catch (error) {
                console.error('Error adding album:', error);
                showNotification('Failed to add album. Please try again.', 'error');
            }
            
            return false;
        }

        function closeAddAlbumPopup() {
            const popup = document.querySelector('.addAlbumPopup');
            popup.classList.remove('active');
            
            setTimeout(() => {
                popup.style.display = 'none';
                resetAddAlbumForm();
            }, 300);
        }

        // ============ EDIT ALBUM ============ //
        async function editAlbum(albumId) {
            try {
                console.log('Opening edit popup for album:', albumId);
                
                const popup = document.querySelector('.editAlbumPopup');
                const popupContent = popup.querySelector('.popup-content');
                const isMobile = isTrueMobile();

                // Reset form edit terlebih dahulu
                resetEditAlbumForm();
                
                // Set album ID
                document.getElementById('editAlbumId').value = albumId;
                
                console.log('Loading album data...');
                // Load album data
                await loadAlbumDataForEdit(albumId);
                
                console.log('Loading artists data for edit...');
                // Load artists data for edit
                await loadArtistsDataForEdit();

                console.log('Setting up event listeners...');
                // Setup edit event listeners
                setupEditAlbumEventListeners();

                // Tampilkan popup
                if (isMobile) {
                    popup.style.display = 'block';
                    setTimeout(() => {
                        popup.classList.add('active');
                        if (popupContent) {
                            popupContent.style.transform = 'translateY(0)';
                        }
                    }, 10);
                } else {
                    // Untuk desktop
                    popup.style.display = 'flex';
                    setTimeout(() => {
                        popup.classList.add('active');
                    }, 10);
                }

                console.log('Edit popup opened successfully');

            } catch (error) {
                console.error('Error opening edit popup:', error);
                console.error('Error details:', error.message, error.stack);
                showNotification('Failed to load album data for editing: ' + error.message, 'error');
                
                // Tutup popup jika ada error
                const popup = document.querySelector('.editAlbumPopup');
                if (popup) {
                    popup.style.display = 'none';
                    popup.classList.remove('active');
                }
            }
        }

        async function loadAlbumDataForEdit(albumId) {
            try {
                console.log('Fetching album data for ID:', albumId);
                
                const response = await fetch(`/admin/album/get/${albumId}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                console.log('Response status:', response.status);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                console.log('Album data received:', data);
                
                if (data.success) {
                    const album = data.album;
                    
                    // Isi form dengan data yang ada
                    document.getElementById('editAlbumName').value = album.album_name || '';
                    document.getElementById('editAlbumCoverPreview').src = album.album_cover || '/uploads/undefine.jpg';
                    
                    // Update character counter
                    document.getElementById('editAlbumNameCounter').textContent = album.album_name?.length || 0;
                    
                    // Set selected artist
                    if (album.id_artist) {
                        editSelectedArtist = {
                            id: album.id_artist,
                            name: album.artist_name || 'Unknown Artist'
                        };
                        updateEditArtistTag();
                    } else {
                        editSelectedArtist = null;
                        updateEditArtistTag();
                    }
                    
                    console.log('Form populated with album data');
                    
                } else {
                    throw new Error(data.message || 'Failed to load album data');
                }
                
            } catch (error) {
                console.error('Error loading album data:', error);
                throw error;
            }
        }

        async function loadArtistsDataForEdit() {
            try {
                console.log('Loading artists for edit popup...');
                
                const response = await fetch('/admin/album/get-artists', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                if (!response.ok) {
                    throw new Error('Failed to load artists');
                }
                
                const data = await response.json();
                console.log('Artists data received:', data.artists?.length || 0, 'artists');
                
                if (data.success) {
                    editArtistsData = data.artists || [];
                    populateEditArtistOptions();
                } else {
                    throw new Error(data.message || 'Failed to load artists');
                }
                
            } catch (error) {
                console.error('Error loading artists for edit:', error);
                // Tetap lanjutkan, jangan throw error di sini
                editArtistsData = [];
                populateEditArtistOptions();
            }
        }

        function populateEditArtistOptions() {
            const artistOptions = document.getElementById('editArtistOptions');
            artistOptions.innerHTML = '';
            
            if (editArtistsData && editArtistsData.length > 0) {
                editArtistsData.forEach(artist => {
                    const isSelected = editSelectedArtist && editSelectedArtist.id === artist.id_artist;
                    const option = document.createElement('div');
                    option.className = 'select-option';
                    if (isSelected) option.classList.add('selected');
                    option.dataset.value = artist.id_artist;
                    option.dataset.name = artist.artist_name;
                    option.innerHTML = `
                        <i class="fas fa-check option-check"></i>
                        ${artist.artist_name}
                    `;
                    option.onclick = () => selectEditArtist(artist.id_artist, artist.artist_name);
                    artistOptions.appendChild(option);
                });
            } else {
                artistOptions.innerHTML = `
                    <div class="select-option no-data">
                        No artists found
                    </div>
                `;
            }
            
            // Add "Add New Artist" option
            const newArtistOption = document.createElement('div');
            newArtistOption.className = 'select-option add-new-option';
            newArtistOption.innerHTML = '<i class="fas fa-plus"></i> Add New Artist';
            newArtistOption.onclick = () => showNewArtistInputForEdit();
            artistOptions.appendChild(newArtistOption);
        }

        function selectEditArtist(artistId, artistName) {
            editSelectedArtist = { id: artistId, name: artistName };
            updateEditArtistTag();
            updateEditArtistOption(artistId);
            document.getElementById('editArtistSearch').value = artistName;
            document.getElementById('editArtistOptions').classList.remove('active');
        }

        function updateEditArtistTag() {
            const artistContainer = document.getElementById('editArtistTag');
            artistContainer.innerHTML = '';
            
            if (editSelectedArtist) {
                const artist = document.createElement('div');
                artist.className = 'selected-artist';
                artist.innerHTML = `
                    ${editSelectedArtist.name}
                    <span class="artist-remove" onclick="removeEditArtist()">
                        <i class="fas fa-times"></i>
                    </span>
                `;
                artistContainer.appendChild(artist);
            }
        }

        function updateEditArtistOption(artistId) {
            document.querySelectorAll('#editArtistOptions .select-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            
            const option = document.querySelector(`#editArtistOptions .select-option[data-value="${artistId}"]`);
            if (option) {
                option.classList.add('selected');
            }
        }

        function removeEditArtist() {
            editSelectedArtist = null;
            updateEditArtistTag();
            document.querySelectorAll('#editArtistOptions .select-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            document.getElementById('editArtistSearch').value = '';
        }

