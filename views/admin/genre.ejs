<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genre Management - Admin Panel</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200;0,300;0,400;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,600;1,700;1,800;1,900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin/css/dashboard.css">
    <link rel="stylesheet" href="/css/popup.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="/js/main.js" defer></script>

    <style>
        /* Genre Management Styles */
        .genre-management-container {
            padding: 20px;
        }

        .genre-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .genre-header h1 {
            font-size: 28px;
            font-weight: 800;
            color: white;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .genre-header h1 i {
            color: var(--primary-color);
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-secondary {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-primary);
            font-weight: 600;
            font-size: 14px;
            padding: 12px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(139, 92, 246, 0.05);
        }

        /* Filters */
        .genre-filters {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
        }

        .filter-row {
            display: flex;
            gap: 16px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .filter-group {
            flex: 1;
            min-width: 300px;
        }

        .filter-group label {
            display: block;
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .filter-input {
            width: 100%;
            padding: 10px 16px;
            background: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            font-size: 14px;
        }

        .filter-input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .clear-search {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 5px;
            border-radius: 50%;
            transition: all 0.2s;
        }

        .filter-loading {
            padding: 10px;
            text-align: center;
            color: var(--primary-color);
            font-size: 14px;
            display: none;
        }

        /* Genre List Container */
        .genre-list-container {
            background: transparent;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .genre-list-body {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            padding: 20px;
            max-height: none;
            overflow-y: visible;
        }

        /* Genre Item */
        .genre-item {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .genre-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            border-color: var(--primary-color);
        }

        .genre-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .genre-item:hover::before {
            opacity: 1;
        }

        /* Genre Header */
        .genre-header-info {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .genre-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
            position: relative;
            border: 3px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        }

        .genre-item:hover .genre-icon {
            transform: scale(1.05);
            border-color: var(--primary-color);
        }

        .genre-icon i {
            font-size: 24px;
            color: white;
        }

        .genre-details {
            flex: 1;
            margin-left: 15px;
            overflow: hidden;
        }

        .genre-details h4 {
            color: white;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 5px 0;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .genre-details p {
            color: var(--text-secondary);
            font-size: 13px;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .genre-details p i {
            font-size: 12px;
        }

        /* Genre Content */
        .genre-content {
            margin-bottom: 15px;
            flex: 1;
        }

        .genre-stats {
            display: flex;
            gap: 15px;
            margin-bottom: 12px;
        }

        .stat-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .genre-item:hover .stat-item {
            border-color: rgba(139, 92, 246, 0.3);
            background: rgba(139, 92, 246, 0.1);
        }

        .stat-value {
            color: white;
            font-size: 20px;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .genre-description {
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 15px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            font-style: italic;
            opacity: 0.8;
        }

        /* Genre Footer */
        .genre-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 15px;
            margin-top: auto;
        }

        .genre-date {
            color: var(--text-secondary);
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        @media (min-width: 769px) {
            .genre-date {
                margin-right: 15px;
                padding: 8px 12px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 6px;
                border: 1px solid rgba(255, 255, 255, 0.1);
            }
        }

        .genre-date i {
            font-size: 11px;
        }

        .genre-actions {
            display: flex;
            gap: 8px;
            margin-left: auto;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid var(--border-color);
            background: var(--sidebar-bg);
            color: var(--text-secondary);
            position: relative;
            overflow: hidden;
        }

        .action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: currentColor;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .action-btn i {
            position: relative;
            z-index: 1;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .action-btn:hover::before {
            opacity: 0.1;
        }

        .action-view:hover {
            border-color: var(--info-color);
            color: var(--info-color);
        }

        .action-edit:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .action-delete:hover {
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

        .action-btn .btn-tooltip {
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 100;
        }

        .action-btn:hover .btn-tooltip {
            opacity: 1;
            visibility: visible;
            bottom: -25px;
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: var(--card-bg);
            border-radius: 12px;
            border: 2px dashed var(--border-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 400px;
            animation: fadeIn 0.5s ease;
        }

        .empty-state i {
            font-size: 64px;
            color: var(--primary-color);
            margin-bottom: 20px;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .empty-state h3 {
            color: var(--text-primary);
            font-size: 24px;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .empty-state p {
            color: var(--text-secondary);
            font-size: 16px;
            margin-bottom: 24px;
            max-width: 400px;
            line-height: 1.5;
        }

        /* Pagination */
        .genre-pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.03);
        }

        .pagination-info {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pagination-btn {
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background: var(--sidebar-bg);
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pagination-btn:hover:not(:disabled) {
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(139, 92, 246, 0.05);
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .page-numbers {
            display: flex;
            gap: 4px;
        }

        .page-number {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: var(--sidebar-bg);
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .page-number:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(139, 92, 246, 0.05);
        }

        .page-number.active {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .genre-list-body {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }
        }

        @media (max-width: 992px) {
            .genre-list-body {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 15px;
                padding: 15px;
            }
            
            .genre-item {
                padding: 15px;
            }
            
            .genre-stats {
                gap: 10px;
            }
            
            .stat-value {
                font-size: 18px;
            }
        }

        @media (max-width: 768px) {
            .genre-header {
                flex-direction: column;
                text-align: center;
                margin-bottom: 20px;
                gap: 16px;
            }
            
            .header-actions {
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
            }
            
            .filter-group {
                min-width: 100%;
            }
            
            .genre-header-info {
                flex-direction: column;
                text-align: center;
                gap: 15px;
            }
            
            .genre-icon {
                width: 80px;
                height: 80px;
            }
            
            .genre-details {
                margin-left: 0;
                width: 100%;
            }
            
            .genre-stats {
                flex-direction: row;
                gap: 8px;
            }
            
            .stat-item {
                padding: 8px;
            }
            
            .stat-value {
                font-size: 16px;
            }
            
            .stat-label {
                font-size: 10px;
            }
            
            .genre-footer {
                flex-direction: column;
                gap: 15px;
            }
            
            .genre-date {
                margin-right: 0;
                justify-content: center;
            }
            
            .genre-actions {
                width: 100%;
                justify-content: center;
            }
        }

        @media (max-width: 576px) {
            .genre-list-body {
                grid-template-columns: 1fr;
                gap: 12px;
                padding: 12px;
            }
            
            .genre-item {
                padding: 15px;
            }
            
            .empty-state {
                padding: 40px 15px;
                min-height: 300px;
            }
            
            .empty-state i {
                font-size: 48px;
            }
            
            .empty-state h3 {
                font-size: 20px;
            }
            
            .empty-state p {
                font-size: 14px;
            }
            
            .genre-pagination {
                flex-direction: column;
                gap: 16px;
                padding: 16px;
                text-align: center;
            }
            
            .pagination-info {
                order: 2;
                font-size: 12px;
            }
            
            .pagination-controls {
                order: 1;
                width: 100%;
                justify-content: center;
            }
            
            .pagination-btn {
                padding: 8px 12px;
                font-size: 13px;
            }
            
            .page-numbers {
                display: none;
            }
        }

        /* Loader animation */
        .genre-item.loading {
            animation: loadingPulse 1.5s infinite;
        }

        @keyframes loadingPulse {
            0% { opacity: 0.6; }
            50% { opacity: 1; }
            100% { opacity: 0.6; }
        }

        /* Popup Styles for Genre */
        .genre-creator {
            display: flex;
            gap: 20px;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .genre-icon-container {
            width: 150px;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
        }

        .genre-icon-preview {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border: 3px dashed #444;
            transition: all 0.3s ease;
        }

        .genre-icon-preview i {
            font-size: 48px;
            color: white;
        }

        .genre-info {
            flex: 1;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #eee;
            font-size: 14px;
            font-weight: 600;
        }

        .form-group input[type="text"] {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #444;
            border-radius: 6px;
            background-color: #2a2a2a;
            color: white;
            font-size: 15px;
            box-sizing: border-box;
        }

        .form-group input[type="text"]:focus {
            border-color: var(--primary-color);
            outline: none;
        }

        .character-count {
            text-align: right;
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

        .error-message {
            color: #ff6b6b;
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }

        .error-message.show {
            display: block;
        }

        /* Delete Confirmation Popup */
        .delete-confirm-content {
            text-align: center;
            padding: 20px 0;
        }

        .delete-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(239, 68, 68, 0.2));
            border: 2px solid rgba(239, 68, 68, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            animation: pulseWarning 2s infinite;
        }

        @keyframes pulseWarning {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
            }
            50% {
                box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
            }
        }

        .delete-icon i {
            font-size: 36px;
            color: var(--danger-color);
        }

        .delete-confirm-content h4 {
            color: white;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 15px;
            line-height: 1.3;
        }

        .delete-confirm-content p {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.5;
            margin-bottom: 25px;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }

        .delete-details {
            background: rgba(42, 42, 42, 0.5);
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .delete-detail-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .delete-detail-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .delete-detail-item:first-child {
            padding-top: 0;
        }

        .delete-detail-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--card-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .delete-detail-icon i {
            font-size: 16px;
            color: var(--primary-color);
        }

        .delete-detail-content {
            flex: 1;
            text-align: left;
        }

        .delete-detail-title {
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .delete-detail-value {
            color: white;
            font-size: 15px;
            font-weight: 600;
        }

        .warning-message {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 10px;
            padding: 15px;
            margin-top: 25px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: fadeIn 0.5s ease;
        }

        .warning-message i {
            color: var(--danger-color);
            font-size: 18px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .warning-message span {
            color: #ff8a8a;
            font-size: 14px;
            line-height: 1.5;
            font-weight: 500;
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--danger-color), #dc2626);
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(239, 68, 68, 0.3);
        }

        .btn-danger:active {
            transform: translateY(0);
        }

        .btn-danger::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(rgba(255, 255, 255, 0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .btn-danger:hover::before {
            opacity: 1;
        }

        /* Responsive for mobile popups */
        @media (max-width: 768px) {
            .genre-creator {
                flex-direction: column;
                align-items: center !important;
                text-align: center;
                gap: 20px;
            }
            
            .genre-icon-container {
                width: 100%;
                display: flex;
                justify-content: center;
            }
            
            .genre-info {
                width: 100%;
            }
            
            .delete-confirm-content {
                padding: 15px 0;
            }
            
            .delete-icon {
                width: 60px;
                height: 60px;
                margin-bottom: 20px;
            }
            
            .delete-icon i {
                font-size: 28px;
            }
            
            .delete-confirm-content h4 {
                font-size: 20px;
            }
            
            .delete-confirm-content p {
                font-size: 14px;
            }
            
            .delete-details {
                padding: 15px;
            }
            
            .delete-detail-item {
                gap: 12px;
                padding: 10px 0;
            }
            
            .delete-detail-icon {
                width: 36px;
                height: 36px;
            }
            
            .delete-detail-icon i {
                font-size: 14px;
            }
            
            .delete-detail-title {
                font-size: 12px;
            }
            
            .delete-detail-value {
                font-size: 14px;
            }
            
            .warning-message {
                padding: 12px;
                font-size: 13px;
            }
            
            .warning-message i {
                font-size: 16px;
            }
        }
    </style>
</head>
<body>
