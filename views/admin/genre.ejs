                <div class="top-left">
                    <div class="greeting">
                        <h1>Genre Management</h1>
                        <div class="pro-badge">
                            <i class="fas fa-crown"></i>
                            <span>Admin</span>
                        </div>
                    </div>
                    <div class="date-info">
                        <i class="fas fa-calendar-alt"></i>
                        <span id="currentDate">Loading...</span>
                    </div>
                </div>
                
                <div class="top-right">
                    <button class="notification-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notification-indicator">3</span>
                    </button>
                    <button class="sidebar-toggle" id="sidebarToggleBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>

            <!-- Genre Management Content -->
            <div class="genre-management-container">
                <!-- Header dengan Actions -->
                <div class="genre-header">
                    <h1><i class="fas fa-tags"></i> Genre Library</h1>
                    <div class="header-actions">
                        <button class="btn-primary" onclick="addGenre()">
                            <i class="fas fa-plus"></i>
                            Add Genre
                        </button>
                    </div>
                </div>

                <!-- Filters -->
                <div class="genre-filters">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label><i class="fas fa-search"></i> Search Genres</label>
                            <div class="search-container" style="position: relative;">
                                <input type="text" class="filter-input" placeholder="Search genres..." id="quickSearch" onkeyup="applyFilters()">
                                <button class="clear-search" onclick="clearSearch()" style="display: none;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Loading indicator -->
                    <div id="filterLoading" class="filter-loading" style="display: none;">
                        <i class="fas fa-spinner fa-spin"></i> Loading...
                    </div>
                </div>

                <!-- Genre List -->
                <div class="genre-list-container">
                    <!-- Body -->
                    <div class="genre-list-body" id="genreList">
                        <% if (genreList && genreList.length > 0) { %>
                            <% genreList.forEach((genre, index) => { %>
                                <div class="genre-item" data-id="<%= genre.id_genre %>">
                                    <div class="genre-header-info">
                                        <div class="genre-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <div class="genre-details">
                                            <h4><%= genre.genre_name %></h4>
                                            <p><i class="fas fa-calendar"></i> Added <%= genre.formatted_date %></p>
                                        </div>
                                    </div>
                                    
                                    <div class="genre-content">
                                        <div class="genre-stats">
                                            <div class="stat-item">
                                                <div class="stat-value"><%= genre.total_songs %></div>
                                                <div class="stat-label">Songs</div>
                                            </div>
                                            <div class="stat-item">
                                                <div class="stat-value"><%= genre.total_playlists %></div>
                                                <div class="stat-label">Playlists</div>
                                            </div>
                                        </div>
                                        
                                        <div class="genre-description">
                                            <% if (genre.total_songs > 0) { %>
                                                <%= genre.genre_name %> has <%= genre.total_songs %> songs in <%= genre.total_playlists %> playlists
                                            <% } else { %>
                                                No songs yet
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="genre-footer">
                                        <div class="genre-date">
                                            <i class="fas fa-clock"></i>
                                            <%= genre.formatted_date %>
                                        </div>
                                        <div class="genre-actions">
                                            <button class="action-btn action-edit" title="Edit" onclick="editGenre('<%= genre.id_genre %>')">
                                                <i class="fas fa-edit"></i>
                                                <span class="btn-tooltip">Edit</span>
                                            </button>
                                            <button class="action-btn action-delete" title="Delete" onclick="deleteGenre('<%= genre.id_genre %>', '<%= genre.genre_name %>')">
                                                <i class="fas fa-trash"></i>
                                                <span class="btn-tooltip">Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-tags"></i>
                                <h3>No Genres Found</h3>
                                <p>
                                    <% if (currentFilters.search) { %>
                                        No genres found for "<%= currentFilters.search %>"
                                    <% } else { %>
                                        Start by adding your first genre!
                                    <% } %>
                                </p>
                                <button class="btn btn-primary" onclick="addGenre()">
                                    Add Genre
                                </button>
                            </div>
                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <div class="genre-pagination">
                        <div class="pagination-info">
                            <% if (genreList && genreList.length > 0) { %>
                                Showing <span id="startItem"><%= (currentPage - 1) * 20 + 1 %></span>-<span id="endItem"><%= Math.min(currentPage * 20, totalGenres) %></span> 
                                of <span id="totalItems"><%= totalGenres %></span> genres
                            <% } else { %>
                                Showing 0-0 of 0 genres
                            <% } %>
                        </div>
                        
                        <% if (totalPages > 1) { %>
                            <div class="pagination-controls">
                                <!-- Previous Button -->
                                <button class="pagination-btn <%= currentPage === 1 ? 'disabled' : '' %>" 
                                        id="prevPage" 
                                        onclick="<%= currentPage > 1 ? 'changePage(' + (currentPage - 1) + ')' : '' %>"
                                        <%= currentPage === 1 ? 'disabled' : '' %>>
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                
                                <!-- Page Numbers -->
                                <div class="page-numbers" id="pageNumbers">
                                    <% 
                                    let startPage = Math.max(1, currentPage - 2);
                                    let endPage = Math.min(totalPages, startPage + 4);
                                    
                                    if (endPage - startPage < 4) {
                                        startPage = Math.max(1, endPage - 4);
                                    }
                                    
                                    for (let i = startPage; i <= endPage; i++) { 
                                    %>
                                        <button class="page-number <%= i === currentPage ? 'active' : '' %>" 
                                                onclick="changePage(<%= i %>)">
                                            <%= i %>
                                        </button>
                                    <% } %>
                                </div>
                                
                                <!-- Next Button -->
                                <button class="pagination-btn <%= currentPage === totalPages ? 'disabled' : '' %>" 
                                        id="nextPage" 
                                        onclick="<%= currentPage < totalPages ? 'changePage(' + (currentPage + 1) + ')' : '' %>"
                                        <%= currentPage === totalPages ? 'disabled' : '' %>>
                                    Next <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Genre Popup -->
    <div style="display: none;" class="popup addGenrePopup bigPopup">
        <div class="popup-overlay"></div>
        <div class="popup-content">
            <form id="addGenreForm" onsubmit="return submitAddGenre(event)" autocomplete="off" style="display: contents">
                <div class="drag-handle">
                    <div class="drag-handle-line"></div>
                </div>

                <div class="popup-header">
                    <h3>Add Genre</h3>
                    <i onclick="closeAddGenrePopup()" class="fa-solid fa-xmark"></i>
                </div>

                <div class="popup-body-scroll">
                    <div class="genre-creator">
                        <div class="genre-icon-container">
                            <div class="genre-icon-preview">
                                <i class="fas fa-tag"></i>
                            </div>
                        </div>

                        <div class="genre-info">
