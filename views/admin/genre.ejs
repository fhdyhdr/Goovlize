                                <input type="text" id="genreName" name="genre_name" maxlength="50" placeholder="Enter genre name" required>
                                <div class="character-count"><span id="genreNameCounter">0</span>/50</div>
                                <div class="error-message" id="genreNameError"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="popup-actions">
                    <button type="button" onclick="closeAddGenrePopup()" class="btn btn-secondary">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Genre</button>
