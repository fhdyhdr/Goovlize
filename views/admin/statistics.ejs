                                <% statistics.recentUploads.forEach((activity, index) => { %>
                                    <div class="activity-item activity-music">
                                        <div class="activity-icon">
                                            <i class="fas fa-plus"></i>
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title">New Music Added</div>
                                            <div class="activity-desc"><%= activity.title %> by <%= activity.artist %></div>
                                        </div>
                                        <div class="activity-time"><%= activity.date %></div>
