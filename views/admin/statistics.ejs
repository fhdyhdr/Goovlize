<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music Dashboard - Statistics</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200;0,300;0,400;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,600;1,700;1,800;1,900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin/css/dashboard.css">
    <link rel="stylesheet" href="/css/popup.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.3/dist/Chart.min.js"></script>
    <script src="/js/main.js" defer></script>
    
    <style>
        /* Styles for statistics page */
        .statistics-container {
            padding: 20px;
        }

        .statistics-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .statistics-header h1 {
            font-size: 28px;
            font-weight: 800;
            color: white;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .statistics-header h1 i {
            color: var(--primary-color);
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-secondary {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-primary);
            font-weight: 600;
            font-size: 14px;
            padding: 12px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(139, 92, 246, 0.05);
        }

        /* Dashboard Overview */
        .dashboard-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary-color);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--primary-color);
        }

        .stat-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-info h3 {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            color: white;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .stat-change {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 14px;
            font-weight: 500;
        }

        .stat-change.positive {
            color: var(--success-color);
        }

        .stat-change.negative {
            color: var(--danger-color);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .stat-music .stat-icon {
            background: rgba(139, 92, 246, 0.1);
            color: var(--primary-color);
        }

        .stat-artists .stat-icon {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .stat-albums .stat-icon {
            background: rgba(59, 130, 246, 0.1);
            color: #3B82F6;
        }

        .stat-plays .stat-icon {
            background: rgba(245, 158, 11, 0.1);
            color: #F59E0B;
        }

        /* Charts Container */
        .charts-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border-color);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .chart-header h3 {
            color: white;
            font-size: 18px;
            font-weight: 600;
        }

        .chart-actions {
            display: flex;
            gap: 8px;
        }

        .chart-action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--sidebar-bg);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .chart-action-btn:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(139, 92, 246, 0.05);
        }

        .chart-wrapper {
            position: relative;
            height: 300px;
        }

        /* Recent Activity */
        .recent-activity {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border-color);
        }

        .activity-header {
            margin-bottom: 20px;
        }

        .activity-header h3 {
            color: white;
            font-size: 18px;
            font-weight: 600;
        }

        .activity-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .activity-list::-webkit-scrollbar {
            width: 6px;
        }

        .activity-list::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 3px;
        }

        .activity-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }

        .activity-item:hover {
            background: rgba(139, 92, 246, 0.05);
        }

        .activity-item:last-child {
            border-bottom: none;
        }

        .activity-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 16px;
            flex-shrink: 0;
        }

        .activity-music .activity-icon {
            background: rgba(139, 92, 246, 0.1);
            color: var(--primary-color);
        }

        .activity-artist .activity-icon {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .activity-album .activity-icon {
            background: rgba(59, 130, 246, 0.1);
            color: #3B82F6;
        }

        .activity-content {
            flex: 1;
        }

        .activity-title {
            color: white;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .activity-desc {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .activity-time {
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
        }

        /* Top Lists */
        .top-lists {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .top-list-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border-color);
        }

        .top-list-header {
            margin-bottom: 20px;
        }

        .top-list-header h3 {
            color: white;
            font-size: 18px;
            font-weight: 600;
        }

        .top-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .top-list::-webkit-scrollbar {
            width: 4px;
        }

        .top-list::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 2px;
        }

        .top-item {
            display: flex;
            align-items: center;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 8px;
            background: rgba(255, 255, 255, 0.02);
            transition: all 0.3s ease;
        }

        .top-item:hover {
            background: rgba(139, 92, 246, 0.1);
        }

        .top-rank {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(139, 92, 246, 0.2);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .top-rank.top-1 {
            background: rgba(245, 158, 11, 0.2);
            color: #F59E0B;
        }

        .top-rank.top-2 {
            background: rgba(107, 114, 128, 0.2);
            color: #6B7280;
        }

        .top-rank.top-3 {
            background: rgba(125, 28, 141, 0.2);
            color: #7D1C8D;
        }

        .top-info {
            flex: 1;
        }

        .top-title {
            color: white;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .top-subtitle {
            color: var(--text-secondary);
            font-size: 13px;
        }

        .top-value {
            color: white;
            font-weight: 700;
            font-size: 14px;
            margin-left: 12px;
        }

        /* Time Filters */
        .time-filters {
            display: flex;
            gap: 10px;
            background: var(--sidebar-bg);
            padding: 8px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .time-filter {
            padding: 8px 16px;
            border-radius: 6px;
            background: transparent;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .time-filter:hover {
            color: white;
            background: rgba(255, 255, 255, 0.05);
        }

        .time-filter.active {
            background: var(--primary-color);
            color: white;
        }

      
        /* Responsive */
        @media (max-width: 1200px) {
            .charts-container {
                grid-template-columns: 1fr;
            }
            
            .top-lists {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .statistics-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }
            
            .header-actions {
                width: 100%;
                flex-wrap: wrap;
            }
            
            .dashboard-overview {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .stat-value {
                font-size: 24px;
            }
            
            .chart-card {
                padding: 15px;
            }
            
            .chart-wrapper {
                height: 250px;
            }
        }

        @media (max-width: 480px) {
            .dashboard-overview {
                grid-template-columns: 1fr;
            }
            
            .statistics-container {
                padding: 15px;
            }
            
            .time-filters {
                flex-wrap: wrap;
                justify-content: center;
            }
            
            .chart-card {
                padding: 12px;
            }
            
            .chart-wrapper {
                height: 200px;
            }
        }

        /* Empty State */
        .empty-state {
            padding: 40px 20px;
            text-align: center;
        }

        .empty-state i {
            font-size: 48px;
            color: var(--border-color);
            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: var(--text-primary);
            font-size: 18px;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: var(--text-secondary);
            font-size: 14px;
        }





.stat-content {
    display: flex;
    justify-content: space-between; 
    align-items: center;
    width: 100%; 
}


.top-activity-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
}

/* Responsif untuk tablet dan mobile */
@media (max-width: 1024px) {
    .top-activity-container {
        grid-template-columns: 1fr;
        gap: 25px;
    }
    
    /* Pastikan kedua card memiliki tinggi yang sesuai */
    .top-list-card, .recent-activity {
        min-height: auto;
    }
}


/* Untuk mobile sangat kecil */
@media (max-width: 480px) {
    .top-activity-container {
        gap: 15px;
    }
    
    .top-list-card, .recent-activity {
        padding: 15px 12px;
    }
}

    
    </style>
</head>
<body>
    <div class="music-dashboard-container">


                  <div class="music-sidebar" id="musicSidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <div class="music-icon-container">
                        <i class="fas fa-music"></i>
                    </div>
                    <span class="logo-text">Goovlize</span>
                </div>
                <button class="sidebar-close-btn" id="sidebarCloseBtn">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="sidebar-card">
                <div class="card-content">
                    <div class="card-icon">
                        <i class="fas fa-headphones-alt"></i>
                    </div>
                    <div class="card-text">
                        <h3>Music Studio</h3>
                        <p>Admin Panel</p>
                    </div>
                    <div class="card-arrow">
                        <i class="fas fa-chevron-right"></i>
                    </div>
                </div>
            </div>

            <!-- Menu Items -->
            <div class="menu-section">
                <div onclick="window.location.href='/admin/dashboard'" class="menu-item">
                    <div class="menu-icon">
                        <i class="fas fa-tachometer-alt"></i>
                    </div>
                    <span class="menu-text">Dashboard</span>
                </div>

                <div onclick="window.location.href='/admin/music'" class="menu-item">
                    <div class="menu-icon">
                       <i class="fa-regular fa-file-audio"></i>
                    </div>
                    <span class="menu-text">Music</span>
                </div>

                 <div onclick="window.location.href='/admin/artist'" class="menu-item">
                    <div class="menu-icon">
                       <i class="fa-solid fa-user-check"></i>
                    </div>
                    <span class="menu-text">Artist</span>
                </div>

                <div onclick="window.location.href='/admin/playlist'" class="menu-item notification">
                    <div class="menu-icon">
                       <i class="fa-regular fa-circle-play"></i>
                    </div>
                    <span class="menu-text">Playlist</span>
                </div>

                <div onclick="window.location.href='/admin/album'" class="menu-item">
                    <div class="menu-icon">
                       <i class="fa-solid fa-compact-disc"></i>
                    </div>
                    <span class="menu-text">Album</span>
                </div>

                <div onclick="window.location.href='/admin/music-genre'" class="menu-item">
                    <div class="menu-icon">
                         <i class="fas fa-tags"></i>
                    </div>
                    <span class="menu-text">Genre</span>
                </div>

                <div onclick="window.location.href='/admin/music-playlist'" class="menu-item">
                    <div class="menu-icon">
                         <i class="fas fa-link"></i>
                    </div>
                    <span class="menu-text">Music in Playlists</span>
                </div>

                <div onclick="window.location.href='/admin/music-album'" class="menu-item">
                    <div class="menu-icon">
                         <i class="fas fa-link"></i>
                    </div>
                    <span class="menu-text">Music in Album</span>
                </div>
                


            </div>

            <div class="menu-section shortcuts">
                <div class="section-title">=====================</div>
                
                <div onclick="window.location.href='/admin/statistics'" class="menu-item active">
                    <div class="menu-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <span class="menu-text">Analytics</span>
                            <span class="notification-badge"></span>
                    </div>

                <div onclick="window.location.href='/admin/logout'" class="menu-item">
                    <div class="menu-icon">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </div>
                    <span class="menu-text">Logout</span>
                </div>
            </div>

            <!-- Storage Usage -->
            <div style="background: transparent; border:none; box-shadow:none" class="storage-card">
                <div style="display: none;" class="storage-content">
                    <h4><i class="fas fa-database"></i> Storage Usage</h4>
                    <p>Audio Files: 45.2 GB / 100 GB</p>
                    <div class="storage-percentage">45%</div>
                    <div class="storage-bar">
                        <div class="storage-bar-bg"></div>
                        <div class="storage-bar-fill" style="width: 45%"></div>
                    </div>
                    <div class="storage-details">
                        <span>Albums: 12 GB</span>
                        <span>Songs: 28 GB</span>
                        <span>Other: 5.2 GB</span>
                    </div>
                </div>
            </div>

            <!-- Admin Profile -->
            <div class="admin-profile">
                <img src="/uploads/profile/default/default_pp.jpg" alt="Admin" class="admin-avatar">
                <div class="admin-info">
                    <% if (typeof admin !== 'undefined' && admin) { %>
        
                            <span class="admin-name"><%= admin.admin_name || 'Admin' %></span>
                     <% } %>

                    <span class="admin-role">Music Admin</span>
                </div>
                <div style="display: none;" class="admin-options">
                    <i class="fas fa-ellipsis-v"></i>
                </div>
            </div>
        </div>





        <div class="music-main-content">
            <!-- Statistics Content -->
            <div class="statistics-container">
                <!-- Header -->
                <div class="statistics-header">
                    <h1><i class="fas fa-chart-line"></i> Analytics Dashboard</h1>
                    <div class="header-actions">
                        <button class="btn-primary" onclick="exportPdfStatistics()">
                            <i class="fas fa-download"></i>
                            Export Report
                        </button>
                        <button class="btn-secondary" onclick="refreshStatistics()">
                            <i class="fas fa-sync-alt"></i>
                            Refresh
                        </button>
                    </div>
                </div>

                <!-- Time Filters -->
      <div class="time-filters">
    <button class="time-filter" onclick="filterTime('today')">Today</button>
    <button class="time-filter" onclick="filterTime('week')">This Week</button>
    <button class="time-filter active" onclick="filterTime('month')">This Month</button>
    <button class="time-filter" onclick="filterTime('year')">This Year</button>
    <button class="time-filter" onclick="filterTime('all')">All Time</button>
</div>
                <!-- Dashboard Overview -->
                <div class="dashboard-overview">
                    <div class="stat-card stat-music">
                        <div class="stat-content">
                            <div class="stat-info">
                                <h3>Total Music</h3>
                                <div class="stat-value" id="totalMusic">
                                    <% if (statistics) { %>
                                        <%= statistics.totalMusic || 0 %>
                                    <% } else { %>
                                        0
                                    <% } %>
                                </div>
                                
                            </div>
                            <div class="stat-icon">
                                <i class="fas fa-music"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card stat-artists">
                        <div class="stat-content">
                            <div class="stat-info">
                                <h3>Total Artists</h3>
                                <div class="stat-value" id="totalArtists">
                                    <% if (statistics) { %>
                                        <%= statistics.totalArtists || 0 %>
                                    <% } else { %>
                                        0
                                    <% } %>
                                </div>
                               
                            </div>
                            <div class="stat-icon">
                                <i class="fas fa-user-check"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card stat-albums">
                        <div class="stat-content">
                            <div class="stat-info">
                                <h3>Total Albums</h3>
                                <div class="stat-value" id="totalAlbums">
                                    <% if (statistics) { %>
                                        <%= statistics.totalAlbums || 0 %>
                                    <% } else { %>
                                        0
                                    <% } %>
                                </div>
                              
                            </div>
                            <div class="stat-icon">
                                <i class="fas fa-compact-disc"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card stat-plays">
                        <div class="stat-content">
                            <div class="stat-info">
                                <h3>Total Plays</h3>
                                <div class="stat-value" id="totalPlays">
                                    <% if (statistics) { %>
                                        <%= statistics.totalPlays?.toLocaleString() || 0 %>
                                    <% } else { %>
                                        0
                                    <% } %>
                                </div>
                                
                            </div>
                            <div class="stat-icon">
                                <i class="fas fa-play"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Container -->
                <div class="charts-container">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Plays Over Time</h3>
                            <div class="chart-actions">
                                <button class="chart-action-btn active" onclick="toggleChartType('playsChart', 'line')" title="Line Chart">
                                    <i class="fas fa-chart-line"></i>
                                </button>
                                <button class="chart-action-btn" onclick="toggleChartType('playsChart', 'bar')" title="Bar Chart">
                                    <i class="fas fa-chart-bar"></i>
                                </button>
                               
                            </div>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="playsChart"></canvas>
                        </div>
                        <div class="chart-footer">
                            <small>Data Source: Music Database</small>
                        </div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Genre Distribution</h3>
                            <div class="chart-actions">
                                <button class="chart-action-btn" onclick="toggleChartType('genreChart', 'doughnut')" title="Doughnut Chart">
                                    <i class="fas fa-chart-pie"></i>
                                </button>
                                <button class="chart-action-btn" onclick="toggleChartType('genreChart', 'pie')" title="Pie Chart">
                                    <i class="fas fa-chart-pie"></i>
                                </button>
                                <button class="chart-action-btn active" onclick="toggleChartType('genreChart', 'polarArea')" title="Polar Area Chart">
                                    <i class="fas fa-bullseye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="genreChart"></canvas>
                        </div>
                        <div class="chart-footer">
                            <small>Based on music categorization</small>
                        </div>
                    </div>
                </div>

                <!-- Top Lists and Recent Activity -->
                <div  class="top-activity-container">
                    <div class="top-lists">
                        <div class="top-list-card">
                            <div class="top-list-header">
                                <h3>Top Played Music</h3>
                            </div>
                            <div class="top-list" id="topPlayedList">
                                <% if (statistics && statistics.topPlayed && statistics.topPlayed.length > 0) { %>
                                    <% statistics.topPlayed.forEach((music, index) => { %>
                                        <div class="top-item">
                                            <div class="top-rank <%= 'top-' + (index + 1) %>"><%= index + 1 %></div>
                                            <div class="top-info">
                                                <div class="top-title"><%= music.title %></div>
                                                <div class="top-subtitle"><%= music.artist %></div>
                                            </div>
                                            <div class="top-value"><%= music.plays.toLocaleString() %> plays</div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="empty-state">
                                        <i class="fas fa-music"></i>
                                        <h3>No Top Music</h3>
                                        <p>No music data available</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
