let musicPlayer = {
    audio: null,
    currentMusicId: null,
    currentIndex: -1,
    playlist: [],
    isPlaying: false,
    isShuffled: false,
    isRepeating: false,
    volume: 0.8,
    isMuted: false,
    
    // Initialize
    init: function() {
        this.setupEventListeners();
    },
    
    // Setup event listeners
    setupEventListeners: function() {
        // Progress bar click
        document.getElementById('progressBar').addEventListener('click', (e) => {
            this.seekTo(e);
        });
        
        // Volume slider click
        document.getElementById('volumeSlider').addEventListener('click', (e) => {
            this.setVolume(e);
        });
        
        // Spacebar to play/pause
        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !e.target.matches('input, textarea')) {
                e.preventDefault();
                this.togglePlayPause();
            }
        });
        
        // Keyboard shortcuts for player
        document.addEventListener('keydown', (e) => {
            if (e.altKey && e.code === 'ArrowLeft') this.playPrevious();
            if (e.altKey && e.code === 'ArrowRight') this.playNext();
            if (e.altKey && e.code === 'KeyM') this.toggleMute();
        });
    },
    
// Play music with popup
playMusic: function(musicId, audioFile, title, artists, cover, duration, event) {
    const playBtn = event?.currentTarget;
    
    // Jika memutar musik yang sama dan audio masih ada (popup ditutup sebelumnya)
    if (this.audio && this.currentMusicId === musicId) {
        // Jika sedang pause, lanjutkan play
        if (!this.isPlaying) {
            this.showPlayer();
            this.play();
        } else {
            // Jika sedang play, toggle pause
            this.togglePlayPause();
        }
        return;
    }
    
    // Jika memutar musik yang berbeda, stop yang lama
    if (this.audio && this.currentMusicId !== musicId) {
        this.stop();
        this.audio = null;
    }
    
    // Jika audio belum ada, buat baru
    if (!this.audio) {
        this.audio = new Audio(audioFile);
        this.setupAudioEvents();
    }
    
    this.currentMusicId = musicId;
    
    // Set volume
    this.audio.volume = this.isMuted ? 0 : this.volume;
    
    // Update UI
    this.updatePlayerUI(title, artists, cover, duration);
    
    // Show player popup
    this.showPlayer();
    
    // Play audio
    this.play();
    
    // Update play count
    this.incrementPlayCount(musicId);
    
    // Build playlist from current page
    this.buildPlaylist();
    
    // Find current index in playlist
    this.currentIndex = this.playlist.findIndex(item => item.id === musicId);
},
    
    // Build playlist from current page
    buildPlaylist: function() {
        this.playlist = [];
        const musicItems = document.querySelectorAll('.music-item');
        
        musicItems.forEach((item, index) => {
            const id = item.dataset.id;
            const audio = item.dataset.audio;
            const title = item.querySelector('.music-details h4').textContent;
            const artist = item.querySelector('.music-artist').textContent;
            const cover = item.querySelector('.music-cover img').src;
            const duration = item.querySelector('.music-duration').textContent;
            
            this.playlist.push({
                id: id,
                audio: audio,
                title: title,
                artist: artist,
                cover: cover,
                duration: duration,
                index: index
            });
        });
        
        // Update queue display
        this.updateQueueDisplay();
    },
    
    // Update queue display
    updateQueueDisplay: function() {
        const queueList = document.getElementById('queueList');
        queueList.innerHTML = '';
        
        this.playlist.forEach((item, index) => {
            const isActive = item.id === this.currentMusicId;
            const queueItem = document.createElement('div');
            queueItem.className = `queue-item ${isActive ? 'active' : ''}`;
            queueItem.innerHTML = `
                <div class="queue-item-cover">
                    <img src="${item.cover}" alt="${item.title}" onerror="this.src='/uploads/undefine.jpg'">
                </div>
                <div class="queue-item-info">
                    <div class="queue-item-title">${item.title}</div>
                    <div class="queue-item-artist">${item.artist}</div>
                </div>
                <div class="queue-item-duration">${item.duration}</div>
            `;
            queueItem.addEventListener('click', () => {
                this.playFromQueue(index);
            });
            queueList.appendChild(queueItem);
        });
    },
    
    // Play from queue
    playFromQueue: function(index) {
        const item = this.playlist[index];
        if (item) {
            this.currentIndex = index;
            this.playMusic(item.id, item.audio, item.title, item.artist, item.cover, item.duration, null);
        }
    },
    
    // Play previous song
    playPrevious: function() {
        if (this.playlist.length === 0) return;
        
        let newIndex = this.currentIndex - 1;
        if (newIndex < 0) {
            newIndex = this.playlist.length - 1; // Loop to last song
        }
        
        const item = this.playlist[newIndex];
        if (item) {
            this.playFromQueue(newIndex);
        }
    },
    
    // Play next song
    playNext: function() {
        if (this.playlist.length === 0) return;
        
        let newIndex = this.currentIndex + 1;
        if (newIndex >= this.playlist.length) {
            newIndex = 0; // Loop to first song
        }
        
        const item = this.playlist[newIndex];
        if (item) {
            this.playFromQueue(newIndex);
        }
    },
    
    // Setup audio event listeners
    setupAudioEvents: function() {
        if (!this.audio) return;
        
        // Time update for progress bar
        this.audio.ontimeupdate = () => {
            this.updateProgress();
        };
        
        // Audio ended
        this.audio.onended = () => {
            if (this.isRepeating) {
                // Repeat current song
                this.audio.currentTime = 0;
                this.play();
            } else {
                // Play next song
                this.playNext();
            }
        };
        
        // Audio play
        this.audio.onplay = () => {
            this.isPlaying = true;
            this.updatePlayButton();
            document.getElementById('coverSpin').classList.add('playing');
        };
        
        // Audio pause
        this.audio.onpause = () => {
            this.isPlaying = false;
            this.updatePlayButton();
            document.getElementById('coverSpin').classList.remove('playing');
        };
        
        // Audio error
        this.audio.onerror = () => {
            console.error('Error playing audio');
            showNotification('Failed to play audio', 'error');
            this.stop();
        };
    },
    
    // Update player UI
    updatePlayerUI: function(title, artist, cover, duration) {
        document.getElementById('playerSongTitle').textContent = title;
        document.getElementById('playerSongArtist').textContent = artist;
        document.getElementById('playerCover').src = cover;
        document.getElementById('totalTime').textContent = duration || '0:00';
    },
    
    // Update progress bar
    updateProgress: function() {
        if (!this.audio) return;
        
        const current = this.audio.currentTime;
        const duration = this.audio.duration || 1;
        const percent = (current / duration) * 100;
        
        // Update progress fill
        document.getElementById('progressFill').style.width = `${percent}%`;
        document.getElementById('progressHandle').style.left = `${percent}%`;
        
        // Update time display
        document.getElementById('currentTime').textContent = this.formatTime(current);
        
        // Update total time if not set
        if (duration && duration !== Infinity) {
            document.getElementById('totalTime').textContent = this.formatTime(duration);
        }
    },
    
    // Seek to position
    seekTo: function(e) {
        if (!this.audio) return;
        
        const progressBar = e.currentTarget;
        const rect = progressBar.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const percent = (x / rect.width) * 100;
        const time = (percent / 100) * this.audio.duration;
        
        this.audio.currentTime = time;
    },
    
    // Set volume
    setVolume: function(e) {
        const volumeSlider = e.currentTarget;
        const rect = volumeSlider.getBoundingClientRect();
        const x = e.clientX - rect.left;
        let percent = (x / rect.width) * 100;
        
        // Clamp between 0 and 100
        percent = Math.max(0, Math.min(100, percent));
        
        this.volume = percent / 100;
        
        if (this.audio) {
            this.audio.volume = this.volume;
        }
        
        // Update UI
        document.getElementById('volumeFill').style.width = `${percent}%`;
        document.getElementById('volumeHandle').style.left = `${percent}%`;
        
        // Update volume button icon
        this.updateVolumeButton();
    },
    
    // Update volume button
    updateVolumeButton: function() {
        const volumeBtn = document.getElementById('volumeBtn');
        let icon = 'fa-volume-up';
        
        if (this.isMuted || this.volume === 0) {
            icon = 'fa-volume-mute';
        } else if (this.volume < 0.5) {
            icon = 'fa-volume-down';
        }
        
        volumeBtn.innerHTML = `<i class="fas ${icon}"></i>`;
    },
    
    // Toggle mute
    toggleMute: function() {
        this.isMuted = !this.isMuted;
        
        if (this.audio) {
            this.audio.volume = this.isMuted ? 0 : this.volume;
        }
        
        this.updateVolumeButton();
    },
    
    // Toggle shuffle
    toggleShuffle: function() {
        this.isShuffled = !this.isShuffled;
        const shuffleBtn = document.querySelector('.shuffle-btn');
        
        if (this.isShuffled) {
            shuffleBtn.style.color = '#1db954';
            // Shuffle playlist
            this.shufflePlaylist();
        } else {
            shuffleBtn.style.color = '';
            // Restore original order
            this.buildPlaylist();
        }
    },
    
    // Shuffle playlist
    shufflePlaylist: function() {
        // Create a copy of playlist
        let shuffled = [...this.playlist];
        
        // Fisher-Yates shuffle algorithm
        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        
        this.playlist = shuffled;
        this.updateQueueDisplay();
    },
    
    // Toggle repeat
    toggleRepeat: function() {
        this.isRepeating = !this.isRepeating;
        const repeatBtn = document.querySelector('.repeat-btn');
        
        if (this.isRepeating) {
            repeatBtn.style.color = '#1db954';
        } else {
            repeatBtn.style.color = '';
        }
    },
    
    // Toggle play/pause
    togglePlayPause: function() {
        if (!this.audio) return;
        
        if (this.isPlaying) {
            this.pause();
        } else {
            this.play();
        }
    },
    
    // Play audio
    play: function() {
        if (!this.audio) return;
        
        this.audio.play().catch(error => {
            console.error('Error playing audio:', error);
            showNotification('Failed to play audio', 'error');
        });
    },
    
    // Pause audio
    pause: function() {
        if (!this.audio) return;
        this.audio.pause();
    },
    
    // Stop audio
    stop: function() {
        if (this.audio) {
            this.audio.pause();
            this.audio.currentTime = 0;
            // Jangan set this.audio = null di sini
            // Biarkan audio object tetap ada untuk bisa dilanjutkan
        }
        this.isPlaying = false;
        this.updatePlayButton();
        document.getElementById('coverSpin').classList.remove('playing');
    },

    cleanupAudio: function() {
    if (this.audio) {
        this.audio.pause();
        this.audio.src = '';
        this.audio = null;
    }
    this.currentMusicId = null;
    this.isPlaying = false;
},
    
    // Update play button
    updatePlayButton: function() {
        const playBtn = document.getElementById('playerPlayBtn');
        const icon = this.isPlaying ? 'fa-pause' : 'fa-play';
        playBtn.innerHTML = `<i class="fas ${icon}"></i>`;
        playBtn.title = this.isPlaying ? 'Pause' : 'Play';
    },
    
    // Show player popup
    showPlayer: function() {
        const popup = document.querySelector('.musicPlayerPopup');
        const popupContent = popup.querySelector('.popup-content');
        const isMobile = isTrueMobile();

        if (isMobile) {
            popup.style.display = 'block';
            setTimeout(() => {
                popup.classList.add('active');
                if (popupContent) {
                    popupContent.style.transform = 'translateY(0)';
                }
            }, 10);
        } else {
            $(".musicPlayerPopup").show();
            $(".musicPlayerPopup").addClass("active");
            $(".musicPlayerPopup .popup-overlay").removeClass("fadeOut").addClass("fadeIn");
        }
    },
    
closePlayer: function() {
    const popup = document.querySelector('.musicPlayerPopup');
    const popupOverlay = popup.querySelector('.popup-overlay');
    const popupContent = popup.querySelector('.popup-content');
    
    // Mulai animasi keluar
    popup.classList.remove('active');
    popupOverlay.classList.remove('fadeIn');
    popupOverlay.classList.add('fadeOut');
    
    // Jika mobile, animasi slide down
    if (isTrueMobile() && popupContent) {
        popupContent.style.transform = 'translateY(100%)';
    }
    
    setTimeout(() => {
        popup.style.display = 'none';
    }, 300);
    
    // Jangan stop audio, cukup pause saja
    if (this.audio) {
        this.pause();
    }
},
    // Format time (seconds to MM:SS)
    formatTime: function(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
    },
    
    // Increment play count
    incrementPlayCount: function(musicId) {
        fetch(`/admin/music/increment-play/${musicId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                this.updatePlayCountDisplay(musicId);
            }
        })
        .catch(error => console.error('Error incrementing play count:', error));
    },
    
    // Update play count display
    updatePlayCountDisplay: function(musicId) {
        const musicItem = document.querySelector(`[data-id="${musicId}"]`);
        if (musicItem) {
            const playsElement = musicItem.querySelector('.music-plays');
            if (playsElement) {
                const currentText = playsElement.textContent.trim();
                const match = currentText.match(/(\d+(\.\d+)?[KMB]?)/);
                if (match) {
                    let currentCount = match[0];
                    if (currentCount.includes('K')) {
                        currentCount = parseFloat(currentCount) * 1000;
                    } else if (currentCount.includes('M')) {
                        currentCount = parseFloat(currentCount) * 1000000;
                    } else {
                        currentCount = parseFloat(currentCount);
                    }
                    
                    const newCount = currentCount + 1;
                    let displayCount = newCount;
                    if (newCount >= 1000000) {
                        displayCount = (newCount / 1000000).toFixed(1) + 'M';
                    } else if (newCount >= 1000) {
                        displayCount = (newCount / 1000).toFixed(1) + 'K';
                    }
                    
                    playsElement.innerHTML = `<i class="fas fa-play"></i> ${displayCount}`;
                }
            }
        }
    }
};

