// Function untuk handle audio file select di edit form
function handleEditAudioFileSelect(file) {
    const validTypes = ['.mp3', '.wav', '.flac', '.aac', '.m4a'];
    const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
    
    if (!validTypes.includes(fileExtension)) {
        document.getElementById('editAudioError').textContent = 'Invalid file type. Please upload an audio file (MP3, WAV, FLAC, AAC, M4A)';
        return;
    }
    
    const maxSize = 50 * 1024 * 1024;
    if (file.size > maxSize) {
        document.getElementById('editAudioError').textContent = 'File size exceeds 50MB limit';
        return;
    }
    
    document.getElementById('editAudioError').textContent = '';
    document.getElementById('editAudioFileName').textContent = file.name;
    document.getElementById('editAudioFileSize').textContent = formatFileSize(file.size);
    document.getElementById('editAudioFileInfo').style.display = 'block';
    document.getElementById('editAudioUploadArea').style.display = 'none';
    document.getElementById('currentAudioFileInfo').style.display = 'none';
}

