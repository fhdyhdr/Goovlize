 <script src="/admin/js/dashboard.js"></script>
<script>


  // Di bagian atas atau dalam <script> tags di music.ejs
document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const action = urlParams.get('action');
    
    if (action === 'upload') {
        setTimeout(() => {
            addMusic();
        }, 300); 
    }

});



// Global variables
let artistsData = [];
let albumsData = [];
let genresData = [];
let selectedArtists = [];
let selectedAlbum = null;
let selectedGenres = []; 
let activeDropdown = null;

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  setupEventListeners();
});


let editEventListeners = {
    artistSearch: null,
    albumSearch: null,
    genreSearch: null
};


function setupEventListeners() {
  // Artist search
  const artistSearch = document.getElementById('artistSearch');
  artistSearch.addEventListener('input', function(e) {
    filterOptions('artistOptions', e.target.value);
  });
  
  artistSearch.addEventListener('focus', function() {
    closeOtherDropdowns('artistOptions');
    document.getElementById('artistOptions').classList.add('active');
    activeDropdown = 'artistOptions';
  });

  const genreSearch = document.getElementById('genreSearch');
  if (genreSearch) {
      genreSearch.addEventListener('input', function(e) {
          filterOptions('genreOptions', e.target.value);
      });
      
      genreSearch.addEventListener('focus', function() {
          closeOtherDropdowns('genreOptions');
          document.getElementById('genreOptions').classList.add('active');
          activeDropdown = 'genreOptions';
      });
  }

  // Album search
  const albumSearch = document.getElementById('albumSearch');
  albumSearch.addEventListener('input', function(e) {
    filterOptions('albumOptions', e.target.value);
  });
  
  albumSearch.addEventListener('focus', function() {
    closeOtherDropdowns('albumOptions');
    document.getElementById('albumOptions').classList.add('active');
    activeDropdown = 'albumOptions';
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.custom-select-container') && 
        !e.target.closest('.add-new-option')) {
      closeAllDropdowns();
    }
  });

  // File upload
  const audioUploadArea = document.getElementById('audioUploadArea');
  const audioFileInput = document.getElementById('audioFile');
  
  audioUploadArea.addEventListener('click', () => audioFileInput.click());
  
  audioUploadArea.addEventListener('dragover', (e) => {
    e.preventDefault();
    audioUploadArea.classList.add('dragover');
  });
  
  audioUploadArea.addEventListener('dragleave', () => {
    audioUploadArea.classList.remove('dragover');
  });
  
  audioUploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    audioUploadArea.classList.remove('dragover');
    
    if (e.dataTransfer.files.length) {
      audioFileInput.files = e.dataTransfer.files;
      handleAudioFileSelect(e.dataTransfer.files[0]);
    }
  });

  audioFileInput.addEventListener('change', (e) => {
    if (e.target.files.length) {
      handleAudioFileSelect(e.target.files[0]);
    }
  });

  // Cover image upload
  const coverUpload = document.getElementById('playlistCoverUpload');
  const coverPreview = document.getElementById('musicCoverPreview');
  const coverUploadOverlay = document.querySelector('.cover-upload-overlay');
  
  coverUploadOverlay.addEventListener('click', () => coverUpload.click());
  
  coverUpload.addEventListener('change', function(e) {
    if (e.target.files.length) {
      const file = e.target.files[0];
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = function(e) {
          coverPreview.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }
    }
  });

  // Character counters
  const titleInput = document.getElementById('musicTitle');
  const lyricsTextarea = document.getElementById('musicLyrics');
  
  titleInput.addEventListener('input', function() {
    document.getElementById('titleCounter').textContent = this.value.length;
