// Function untuk toggle artist di edit form
function toggleEditArtist(artistId, artistName) {
    const index = editSelectedArtists.findIndex(a => a.id === artistId);
    
    if (index === -1) {
        // Add artist dengan role default 'main'
        editSelectedArtists.push({ 
            id: artistId, 
            name: artistName,
            role: 'main' // Default role
        });
        updateEditArtistTags();
        updateEditArtistOption(artistId, true);
        
        // Update album options
        populateEditAlbumOptions(true);
    } else {
        // Remove artist
        editSelectedArtists.splice(index, 1);
        updateEditArtistTags();
        updateEditArtistOption(artistId, false);
        
        // Update album options
        if (editSelectedArtists.length > 0) {
            populateEditAlbumOptions(true);
        } else {
            populateEditAlbumOptions(false);
            // Jika album yang dipilih dibuat oleh artist yang dihapus, hapus juga album
            if (editSelectedAlbum) {
                const albumArtistId = editAlbumsData.find(a => a.id_al === editSelectedAlbum.id)?.id_artist;
                if (albumArtistId === artistId) {
                    removeEditAlbum();
                }
            }
        }
    }
    
    updateEditArtistSearchInput();
}

// Function untuk select album di edit form
function selectEditAlbum(albumId, albumName) {
    editSelectedAlbum = { id: albumId, name: albumName };
    updateEditAlbumTag();
    updateEditAlbumOption(albumId);
    
    // Update search input
    document.getElementById('editAlbumSearch').value = albumName;
    document.getElementById('editAlbumOptions').classList.remove('active');
}

// Function untuk remove artist dari edit form
function removeEditArtist(artistId) {
    editSelectedArtists = editSelectedArtists.filter(a => a.id !== artistId);
    updateEditArtistTags();
    updateEditArtistOption(artistId, false);
    updateEditArtistSearchInput();
    
    // Update album options
    if (editSelectedArtists.length > 0) {
        populateEditAlbumOptions(true);
    } else {
        populateEditAlbumOptions(false);
        // Jika album yang dipilih dibuat oleh artist yang dihapus, hapus juga album
        if (editSelectedAlbum) {
            const albumArtistId = editAlbumsData.find(a => a.id_al === editSelectedAlbum.id)?.id_artist;
            if (albumArtistId === artistId) {
                removeEditAlbum();
            }
        }
    }
    
    document.getElementById('editArtistOptions').classList.remove('active');
}

// Function untuk remove album dari edit form
function removeEditAlbum() {
