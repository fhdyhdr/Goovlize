function toggleGenre(genreId, genreName) {
    const index = selectedGenres.findIndex(g => g.id === genreId);
    
    if (index === -1) {
        // Add genre
        selectedGenres.push({ id: genreId, name: genreName });
    } else {
        // Remove genre
        selectedGenres.splice(index, 1);
    }
    
    updateGenreTags();
    updateGenreOption(genreId, index === -1);
}

function updateGenreTags() {
    const tagsContainer = document.getElementById('genreTags');
    tagsContainer.innerHTML = '';
    
    selectedGenres.forEach(genre => {
        const tag = document.createElement('div');
        tag.className = 'selected-tag';
        tag.dataset.genreId = genre.id;
        tag.innerHTML = `
            ${genre.name}
            <span class="tag-remove">
                <i class="fas fa-times"></i>
            </span>
        `;
        
        // Tambah event listener langsung
        const removeBtn = tag.querySelector('.tag-remove');
        removeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            removeGenre(genre.id);
        });
        
        tagsContainer.appendChild(tag);
    });
}


function toggleEditGenre(genreId, genreName) {
    const index = editSelectedGenres.findIndex(g => g.id === genreId);
    
    if (index === -1) {
        // Add genre
        editSelectedGenres.push({ id: genreId, name: genreName });
    } else {
        // Remove genre
        editSelectedGenres.splice(index, 1);
    }
    
