async function addNewArtistForEdit() {
    const newName = document.getElementById('editNewArtistName').value.trim();
    if (!newName) {
        showEditArtistErrorMessage('Please enter artist name');
        return;
    }
    
    try {
        const response = await fetch('/admin/music/add-artist', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ artist_name: newName })
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Clear and hide input
            cancelNewArtistForEdit();
            
            // Refresh data artist dari server
            await loadArtistAndAlbumDataForEdit();
            
            // Select the new artist hanya jika bukan duplicate
            if (result.artist && result.artist.id_artist) {
                const alreadySelected = editSelectedArtists.some(a => a.id === result.artist.id_artist);
                if (!alreadySelected) {
                    toggleEditArtist(result.artist.id_artist, result.artist.artist_name);
                }
            }
            
            // Tampilkan notifikasi sukses
            showNotification('Artist ' + (result.message === 'Artist already exists' ? 'already exists' : 'added successfully') + '!', 'success');
        } else {
            showEditArtistErrorMessage(result.message || 'Failed to add artist');
        }
    } catch (error) {
        console.error('Error adding artist:', error);
        showEditArtistErrorMessage('Failed to add artist. Please try again.');
    }
}



