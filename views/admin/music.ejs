// Global variables for filtering
let currentFilters = {
    dateFilter: '',
    sortFilter: 'date_desc',
    searchQuery: '',
    page: 1,
    limit: 20
};

let filterTimeout = null;
let isFiltering = false;

// Initialize filter values from URL or defaults
function initializeFilters() {
    const urlParams = new URLSearchParams(window.location.search);
    
    // Set filter values from URL parameters
    currentFilters.dateFilter = urlParams.get('date') || '';
    currentFilters.sortFilter = urlParams.get('sort') || 'date_desc';
    currentFilters.searchQuery = urlParams.get('search') || '';
    currentFilters.page = parseInt(urlParams.get('page')) || 1;
    
    // Update UI elements
    document.getElementById('dateFilter').value = currentFilters.dateFilter;
    document.getElementById('sortFilter').value = currentFilters.sortFilter;
    document.getElementById('quickSearch').value = currentFilters.searchQuery;
    
    // Show/hide clear search button
    const clearSearchBtn = document.querySelector('.clear-search');
    clearSearchBtn.style.display = currentFilters.searchQuery ? 'block' : 'none';
}

// Apply filters function
function applyFilters() {
    // Clear previous timeout
    if (filterTimeout) {
        clearTimeout(filterTimeout);
    }
    
    // Set new timeout for search (debouncing)
    filterTimeout = setTimeout(() => {
        // Update current filters
        currentFilters.dateFilter = document.getElementById('dateFilter').value;
        currentFilters.sortFilter = document.getElementById('sortFilter').value;
        currentFilters.searchQuery = document.getElementById('quickSearch').value.trim();
        currentFilters.page = 1; // Reset to page 1 when filtering
        
        // Show/hide clear search button
        const clearSearchBtn = document.querySelector('.clear-search');
        clearSearchBtn.style.display = currentFilters.searchQuery ? 'block' : 'none';
        
        // Load filtered data
        loadFilteredData();
    }, currentFilters.searchQuery ? 500 : 300); // Longer delay for search
}

// Clear search function
function clearSearch() {
    document.getElementById('quickSearch').value = '';
    document.querySelector('.clear-search').style.display = 'none';
    applyFilters();
}

// Load filtered data from server
async function loadFilteredData() {
    if (isFiltering) return;
    
    isFiltering = true;

    
    try {
        // Build query parameters
        const params = new URLSearchParams();
        
        if (currentFilters.dateFilter) {
            params.append('date', currentFilters.dateFilter);
        }
        
        if (currentFilters.sortFilter) {
            params.append('sort', currentFilters.sortFilter);
        }
        
        if (currentFilters.searchQuery) {
            params.append('search', currentFilters.searchQuery);
        }
        
        if (currentFilters.page > 1) {
            params.append('page', currentFilters.page);
        }
        
        // Show loading state on music items
        const musicItems = document.querySelectorAll('.music-item');
        musicItems.forEach(item => {
            item.classList.add('loading');
        });
        
        // Send request to server
        const response = await fetch(`/admin/music/filter?${params.toString()}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        if (!response.ok) {
            throw new Error('Failed to fetch filtered data');
        }
        
        const data = await response.json();
        
        if (data.success) {
            // Update URL without reloading page
            updateURL();
            
            // Update music list
            updateMusicList(data.musicList, data.totalMusic, data.currentPage, data.totalPages);
            
            // Show notification if search returned no results
            if (currentFilters.searchQuery && data.musicList.length === 0) {
                showNotification(`No songs found for "${currentFilters.searchQuery}"`, 'info');
            }
        } else {
            throw new Error(data.message || 'Failed to load filtered data');
        }
    } catch (error) {
        console.error('Error loading filtered data:', error);

    } finally {
        isFiltering = false;
  
        
        // Remove loading state
        const musicItems = document.querySelectorAll('.music-item');
        musicItems.forEach(item => {
            item.classList.remove('loading');
        });
    }
}

// Update URL with current filters
function updateURL() {
    const params = new URLSearchParams();
    
    if (currentFilters.dateFilter) {
        params.append('date', currentFilters.dateFilter);
    }
    
    if (currentFilters.sortFilter && currentFilters.sortFilter !== 'date_desc') {
        params.append('sort', currentFilters.sortFilter);
    }
    
    if (currentFilters.searchQuery) {
        params.append('search', currentFilters.searchQuery);
    }
    
    if (currentFilters.page > 1) {
        params.append('page', currentFilters.page);
    }
    
    const newUrl = `${window.location.pathname}${params.toString() ? '?' + params.toString() : ''}`;
    window.history.pushState({ path: newUrl }, '', newUrl);
}

function updateMusicList(musicList, totalMusic, currentPage, totalPages) {
    const musicListBody = document.getElementById('musicList');
    const paginationInfo = document.querySelector('.pagination-info');
    
    // Clear existing content
    musicListBody.innerHTML = '';
    
    if (musicList && musicList.length > 0) {
        // Generate new music items
        musicList.forEach((music, index) => {
            const musicItem = document.createElement('div');
            musicItem.className = 'music-item';
            musicItem.dataset.id = music.id_music;
            musicItem.dataset.duration = music.duration_seconds || 0;
            musicItem.dataset.audio = music.audio_file;
            
            // Calculate item number - HARUS SAMA dengan EJS
            const itemNumber = (currentPage - 1) * 20 + index + 1;
            
            // Format date - HARUS SAMA dengan EJS
            let formattedDate = 'Unknown';
            if (music.created_at) {
                try {
                    const date = new Date(music.created_at);
                    formattedDate = date.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                    });
                } catch (dateErr) {
                    console.error('Error formatting date:', dateErr);
                }
            }
            
            // Format play count - HARUS SAMA dengan EJS
            let playCountDisplay = '0';
            const playCount = music.play_count_raw || music.play_count || music.playing || 0;
            
            if (playCount > 0) {
                if (playCount >= 1000) {
                    const thousands = playCount / 1000;
                    playCountDisplay = thousands.toFixed(1) + 'K';
                } else {
                    playCountDisplay = playCount.toString();
                }
            }
            
            // Format artists dengan role - HARUS SAMA dengan EJS
            let artistsHtml = 'No artist';
            if (music.artists && music.artists.trim() !== '') {
                try {
                    const artistsArray = music.artists.split(', ').filter(artist => artist.trim() !== '');
                    artistsHtml = artistsArray.map((artist, idx) => {
                        const hasFt = artist.includes('(ft)');
                        const artistName = artist.replace(/\s*\(ft\)$/, '').trim();
                        const isFeat = hasFt;
                        const roleClass = isFeat ? 'feat-artist' : 'main-artist';
                        
                        return `
                            <span class="music-artist-with-role ${roleClass}">
                                ${artistName}
                                ${isFeat ? 
                                    '<span class="artist-role-badge short-ft" title="feat">ft</span>' 
                                    : ''}
                                ${idx < artistsArray.length - 1 ? ', ' : ''}
                            </span>
                        `;
                    }).join('');
                } catch (error) {
                    console.error('Error parsing artists:', error);
                    artistsHtml = music.artists;
                }
            }
            
            // Format genres - HARUS SAMA dengan EJS
            let genresHtml = '';
            if (music.all_genres && music.all_genres.trim() !== '') {
                try {
                    const genreArray = music.all_genres.split(', ').filter(genre => genre.trim() !== '');
                    if (genreArray.length > 0) {
                        // Tampilkan maksimal 2 genre pertama - SAMA dengan EJS
                        const displayGenres = genreArray.slice(0, 2);
                        genresHtml = displayGenres.map((genre, idx) => {
                            const genreClass = 'genre-' + (genre ? genre.toLowerCase().replace(/\s+/g, '-') : 'other');
                            return `
                                <span class="genre-badge ${genreClass}">
                                    ${genre ? genre.toUpperCase() : 'OTHER'}
                                    ${idx < displayGenres.length - 1 ? '+' : ''}
                                </span>
                            `;
                        }).join('');
                        
                        // Jika ada lebih dari 2 genre, tambahkan indikator
                        if (genreArray.length > 2) {
                            genresHtml += `
                                <span class="genre-more" title="${genreArray.slice(2).join(', ')}">
                                    +${genreArray.length - 2} more
                                </span>
                            `;
                        }
                    } else {
                        genresHtml = '<span class="genre-badge genre-other">OTHER</span>';
                    }
                } catch (error) {
                    console.error('Error parsing genres:', error);
                    genresHtml = '<span class="genre-badge genre-other">OTHER</span>';
                }
            } else {
                genresHtml = '<span class="genre-badge genre-other">OTHER</span>';
            }
            
            // Format album - SAMA dengan EJS
            let albumHtml = 'No album';
            if (music.albums && music.albums.trim() !== '') {
                albumHtml = music.albums.length > 20 ? 
                    music.albums.substring(0, 20) + '...' : 
                    music.albums;
            }
            
            // Escape quotes untuk atribut onclick
            const safeTitle = music.title_music ? music.title_music.replace(/'/g, "\\'") : '';
            const safeArtists = music.artists ? music.artists.replace(/'/g, "\\'") : '';
            
            // Gunakan format HTML yang SAMA PERSIS dengan EJS
            musicItem.innerHTML = `
                <div class="music-number">${itemNumber}</div>
                <div class="music-info">
                    <div class="music-cover">
                        <img src="${music.cover_music || '/uploads/undefine.jpg'}" 
                             alt="${music.title_music}"
                             onerror="this.src='/uploads/undefine.jpg'">
                    </div>
                    <div class="music-details">
                        <h4>${music.title_music}</h4>
                        <p>
                            ${music.duration || '0:00'} • 
                            Added ${formattedDate}
                        </p>
                    </div>
                </div>
                <div class="music-artist" title="${music.artists || 'No artist'}">
                    ${artistsHtml}
                </div>
                <div class="music-album" title="${music.albums || 'No album'}">
                    ${albumHtml}
                </div>
                <div class="music-duration">${music.duration || '0:00'}</div>
                <div class="music-genre">
                    ${genresHtml}
                </div>
                <div class="music-plays">
                    <i class="fas fa-play"></i>
                    ${playCountDisplay}
                </div>
                <div class="music-actions">
                    <button class="action-btn action-play" title="Play" 
                            onclick="playMusic('${music.id_music}', '${music.audio_file}', '${safeTitle}', '${safeArtists}', event)">
                        <i class="fas fa-play"></i>
                    </button>
                    <button class="action-btn action-edit" title="Edit" onclick="editMusic('${music.id_music}')">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="action-btn action-delete" title="Delete" onclick="deleteMusic('${music.id_music}', '${safeTitle}')">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `;
            
            musicListBody.appendChild(musicItem);
        });
        
        // Update pagination info
        const startItem = (currentPage - 1) * 20 + 1;
        const endItem = Math.min(currentPage * 20, totalMusic);
        
        paginationInfo.innerHTML = `
            Showing <span id="startItem">${startItem}</span>-<span id="endItem">${endItem}</span> 
            of <span id="totalItems">${totalMusic}</span> songs
        `;
        
        // Update pagination controls
        updatePaginationControls(currentPage, totalPages);
    } else {
        // Show empty state
        musicListBody.innerHTML = `
            <div class="no-music-found">
                <i class="fas fa-music"></i>
                <p>No music found</p>
                ${currentFilters.searchQuery ? 
                    `<p class="search-message">No results for "${currentFilters.searchQuery}"</p>` : 
                    ''}
            </div>
        `;
        
        paginationInfo.innerHTML = 'Showing 0-0 of 0 songs';
        document.querySelector('.pagination-controls').innerHTML = '';
    }
    
    // Reinitialize music player playlist
    if (musicPlayer) {
        musicPlayer.buildPlaylist();
    }
    
    // Reinitialize event listeners
    setTimeout(() => {
        reinitializeEventListeners();
    }, 100);
}


// Update pagination controls
function updatePaginationControls(currentPage, totalPages) {
    const paginationControls = document.querySelector('.pagination-controls');
    
    if (totalPages <= 1) {
        paginationControls.innerHTML = '';
        return;
    }
    
    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, startPage + 4);
    
    if (endPage - startPage < 4) {
        startPage = Math.max(1, endPage - 4);
    }
    
    let pageNumbersHTML = '';
    for (let i = startPage; i <= endPage; i++) {
        pageNumbersHTML += `
            <button class="page-number ${i === currentPage ? 'active' : ''}" 
                    onclick="changePage(${i})">
                ${i}
            </button>
        `;
    }
    
    paginationControls.innerHTML = `
        <button class="pagination-btn ${currentPage === 1 ? 'disabled' : ''}" 
                id="prevPage" 
                onclick="${currentPage > 1 ? `changePage(${currentPage - 1})` : ''}"
                ${currentPage === 1 ? 'disabled' : ''}>
            <i class="fas fa-chevron-left"></i> Previous
        </button>
        
        <div class="page-numbers" id="pageNumbers">
            ${pageNumbersHTML}
            <span class="mobile-page-info">Page ${currentPage} of ${totalPages}</span>
        </div>
        
        <button class="pagination-btn ${currentPage === totalPages ? 'disabled' : ''}" 
                id="nextPage" 
                onclick="${currentPage < totalPages ? `changePage(${currentPage + 1})` : ''}"
                ${currentPage === totalPages ? 'disabled' : ''}>
            Next <i class="fas fa-chevron-right"></i>
        </button>
    `;
}

// Change page function (for pagination)
function changePage(page) {
    currentFilters.page = page;
    loadFilteredData();
}

// Reset all filters
function resetFilters() {
    document.getElementById('dateFilter').value = '';
    document.getElementById('sortFilter').value = 'date_desc';
    document.getElementById('quickSearch').value = '';
    document.querySelector('.clear-search').style.display = 'none';
    
    currentFilters = {
        dateFilter: '',
        sortFilter: 'date_desc',
        searchQuery: '',
        page: 1,
        limit: 20
    };
    
    loadFilteredData();
}

// Add reset filters button to header actions (optional)
function addResetButton() {
    const headerActions = document.querySelector('.header-actions');
    if (headerActions) {
        const resetBtn = document.createElement('button');
        resetBtn.className = 'btn-secondary';
        resetBtn.innerHTML = '<i class="fas fa-undo"></i> Reset Filters';
        resetBtn.onclick = resetFilters;
        headerActions.appendChild(resetBtn);
    }
}

// Initialize filters when page loads
document.addEventListener('DOMContentLoaded', function() {
    initializeFilters();
    addResetButton();
    
    // Add keyboard shortcut for clearing search (Esc key)
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && document.getElementById('quickSearch').value) {
