// Function untuk populate artist options di edit form
function populateEditArtistOptions() {
    const artistOptions = document.getElementById('editArtistOptions');
    artistOptions.innerHTML = '';
    
    if (editArtistsData && editArtistsData.length > 0) {
        editArtistsData.forEach(artist => {
            const isSelected = editSelectedArtists.some(a => a.id === artist.id_artist);
            const option = document.createElement('div');
            option.className = 'select-option';
            if (isSelected) option.classList.add('selected');
            option.dataset.value = artist.id_artist;
            option.dataset.name = artist.artist_name;
            option.innerHTML = `
                <i class="fas fa-check option-check"></i>
                ${artist.artist_name}
            `;
            option.onclick = () => toggleEditArtist(artist.id_artist, artist.artist_name);
            artistOptions.appendChild(option);
        });
    } else {
        artistOptions.innerHTML = `
            <div class="select-option no-data">
                No artists found
            </div>
        `;
    }
    
    // Add "Add New Artist" option
    const newArtistOption = document.createElement('div');
    newArtistOption.className = 'select-option add-new-option';
    newArtistOption.innerHTML = '<i class="fas fa-plus"></i> Add New Artist';
    newArtistOption.onclick = () => showNewArtistInputForEdit();
    artistOptions.appendChild(newArtistOption);
}

// Function untuk populate album options di edit form
function populateEditAlbumOptions(filtered = false) {
    const albumOptions = document.getElementById('editAlbumOptions');
    albumOptions.innerHTML = '';
    
    let albumsToShow = editAlbumsData || [];
    
    // Jika filtered = true, filter album berdasarkan artist yang dipilih
    if (filtered && editSelectedArtists.length > 0) {
        const selectedArtistIds = editSelectedArtists.map(a => a.id);
        albumsToShow = editAlbumsData.filter(album => 
            selectedArtistIds.includes(album.id_artist)
        );
    }
    
    if (albumsToShow.length > 0) {
        albumsToShow.forEach(album => {
            const artistName = editArtistsData.find(a => a.id_artist === album.id_artist)?.artist_name || 'Unknown Artist';
            const isSelected = editSelectedAlbum && editSelectedAlbum.id === album.id_al;
            const option = document.createElement('div');
            option.className = 'select-option album-option';
            if (isSelected) option.classList.add('selected');
            option.dataset.value = album.id_al;
            option.dataset.name = album.album_name;
            option.dataset.artistId = album.id_artist;
            option.innerHTML = `
                <i class="fas fa-check option-check"></i>
                ${album.album_name} <span style="color: #888; font-size: 12px;">- ${artistName}</span>
            `;
            option.onclick = () => selectEditAlbum(album.id_al, album.album_name);
            albumOptions.appendChild(option);
        });
    } else {
        const message = filtered && editSelectedArtists.length > 0 
            ? 'No albums found for selected artists' 
            : 'No albums found';
        albumOptions.innerHTML = `
            <div class="select-option no-data">
                ${message}
            </div>
        `;
    }
    
    // Add "Add New Album" option
    const newAlbumOption = document.createElement('div');
    newAlbumOption.className = 'select-option add-new-option';
    newAlbumOption.innerHTML = '<i class="fas fa-plus"></i> Add New Album';
    newAlbumOption.onclick = () => showNewAlbumInputForEdit();
    albumOptions.appendChild(newAlbumOption);
}




