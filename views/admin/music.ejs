// Fungsi untuk populate album options dari data yang ada
function populateAlbumOptions(filtered = false) {
  const albumOptions = document.getElementById('albumOptions');
  albumOptions.innerHTML = '';
  
  let albumsToShow = albumsData || [];
  
  // Jika filtered = true, filter album berdasarkan artist yang dipilih
  if (filtered && selectedArtists.length > 0) {
    const selectedArtistIds = selectedArtists.map(a => a.id);
    albumsToShow = albumsData.filter(album => 
      selectedArtistIds.includes(album.id_artist)
    );
  }
  
  console.log('Populating album options. Total albums:', albumsToShow.length);
  
  if (albumsToShow.length > 0) {
    albumsToShow.forEach(album => {
      const artistName = artistsData.find(a => a.id_artist === album.id_artist)?.artist_name || 'Unknown Artist';
      const isSelected = selectedAlbum && selectedAlbum.id === album.id_al;
      const option = document.createElement('div');
      option.className = 'select-option album-option';
      if (isSelected) option.classList.add('selected');
      option.dataset.value = album.id_al;
      option.dataset.name = album.album_name;
      option.dataset.artistId = album.id_artist;
      option.innerHTML = `
        <i class="fas fa-check option-check"></i>
        ${album.album_name} <span style="color: #888; font-size: 12px;">- ${artistName}</span>
      `;
      option.onclick = () => selectAlbum(album.id_al, album.album_name);
      albumOptions.appendChild(option);
    });
  } else {
    const message = filtered && selectedArtists.length > 0 
      ? 'No albums found for selected artists' 
      : 'No albums found';
    albumOptions.innerHTML = `
      <div class="select-option no-data">
        ${message}
      </div>
    `;
  }
  
  // Add "Add New Album" option
  const newAlbumOption = document.createElement('div');
  newAlbumOption.className = 'select-option add-new-option';
  newAlbumOption.innerHTML = '<i class="fas fa-plus"></i> Add New Album';
  newAlbumOption.onclick = () => showNewAlbumInput();
  albumOptions.appendChild(newAlbumOption);
}

