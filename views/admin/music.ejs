function closeEditOtherDropdowns(currentDropdownId) {
    const dropdowns = ['editArtistOptions', 'editAlbumOptions', 'editGenreOptions'];
    dropdowns.forEach(dropdownId => {
        if (dropdownId !== currentDropdownId) {
            const dropdown = document.getElementById(dropdownId);
            if (dropdown) {
                dropdown.classList.remove('active');
                // Reset search input saat dropdown ditutup
                const searchInput = document.getElementById(dropdownId.replace('Options', 'Search'));
                if (searchInput) {
                    searchInput.value = '';
                    // Trigger filter untuk reset tampilan
                    filterEditOptions(dropdownId, '');
                }
            }
        }
    });
}

function filterEditOptions(containerId, searchTerm) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    const options = container.querySelectorAll('.select-option');
    searchTerm = searchTerm.toLowerCase();
    
    // Jika search kosong, tampilkan semua option kecuali yang sedang dipilih
    if (searchTerm === '') {
        options.forEach(option => {
            // Tampilkan semua option
            option.style.display = 'block';
            
            // Jangan tampilkan option yang sudah dipilih (untuk multiple select)
            if (option.classList.contains('selected') && containerId !== 'editAlbumOptions') {
                option.style.display = 'none';
            }
        });
        return;
    }
    
    // Filter berdasarkan search term
    options.forEach(option => {
        const text = option.textContent.toLowerCase();
        const isAddNewOption = option.classList.contains('add-new-option');
        
        // Tampilkan jika mengandung search term atau adalah "Add New" option
        if (text.includes(searchTerm) || isAddNewOption) {
            option.style.display = 'block';
        } else {
            option.style.display = 'none';
        }
    });
}



