function setupSearchInputClearing() {
    const searchInputs = [
        'editArtistSearch',
        'editAlbumSearch', 
        'editGenreSearch'
    ];
    
    searchInputs.forEach(inputId => {
        const input = document.getElementById(inputId);
        if (input) {
            // Clear input saat focus (kecuali jika sudah ada value yang valid)
            input.addEventListener('focus', function() {
                // Hanya clear jika value kosong atau tidak ada item yang dipilih
                if (this.value === '' || this.value === this.placeholder) {
                    this.value = '';
                    // Trigger search untuk menampilkan semua option
                    const containerId = inputId.replace('Search', 'Options');
                    filterEditOptions(containerId, '');
                }
            });
            
            // Select all text saat focus (untuk kemudahan clear)
            input.addEventListener('click', function() {
                this.select();
            });
        }
    });
}


function setupEditFileUploadListeners() {
    const audioUploadArea = document.getElementById('editAudioUploadArea');
    const audioFileInput = document.getElementById('editAudioFile');
    
    if (audioUploadArea && audioFileInput) {
        // Reset event listeners dengan clone dan replace
        const newAudioUploadArea = audioUploadArea.cloneNode(true);
        const newAudioFileInput = audioFileInput.cloneNode(true);
        
        audioUploadArea.parentNode.replaceChild(newAudioUploadArea, audioUploadArea);
        audioFileInput.parentNode.replaceChild(newAudioFileInput, audioFileInput);
        
        // Setup handlers
        const newUploadArea = document.getElementById('editAudioUploadArea');
        const newFileInput = document.getElementById('editAudioFile');
        
        const handleUploadAreaClick = () => newFileInput.click();
        const handleDragOver = (e) => {
            e.preventDefault();
            newUploadArea.classList.add('dragover');
        };
        const handleDragLeave = () => {
            newUploadArea.classList.remove('dragover');
        };
        const handleDrop = (e) => {
            e.preventDefault();
            newUploadArea.classList.remove('dragover');
            
            if (e.dataTransfer.files.length) {
                newFileInput.files = e.dataTransfer.files;
                handleEditAudioFileSelect(e.dataTransfer.files[0]);
            }
        };
        const handleFileChange = (e) => {
            if (e.target.files.length) {
                handleEditAudioFileSelect(e.target.files[0]);
            }
        };
        
        // Tambah event listener sekali saja
        newUploadArea.addEventListener('click', handleUploadAreaClick);
        newUploadArea.addEventListener('dragover', handleDragOver);
        newUploadArea.addEventListener('dragleave', handleDragLeave);
        newUploadArea.addEventListener('drop', handleDrop);
        newFileInput.addEventListener('change', handleFileChange);
    }
}

function setupEditCoverUploadListeners() {
    const coverUpload = document.getElementById('editCoverUpload');
    const coverPreview = document.getElementById('editCoverPreview');
    const coverUploadOverlay = document.querySelector('.editMusicPopup .cover-upload-overlay');
    
    if (coverUpload && coverPreview && coverUploadOverlay) {
        // Reset dengan clone
        const newCoverUpload = coverUpload.cloneNode(true);
        const newCoverPreview = coverPreview.cloneNode(true);
        const newCoverUploadOverlay = coverUploadOverlay.cloneNode(true);
        
        coverUpload.parentNode.replaceChild(newCoverUpload, coverUpload);
        coverPreview.parentNode.replaceChild(newCoverPreview, coverPreview);
        coverUploadOverlay.parentNode.replaceChild(newCoverUploadOverlay, coverUploadOverlay);
        
        // Setup handlers
        const newCoverInput = document.getElementById('editCoverUpload');
        const newPreview = document.getElementById('editCoverPreview');
        const newOverlay = document.querySelector('.editMusicPopup .cover-upload-overlay');
        
        const handleCoverUploadClick = () => newCoverInput.click();
        const handleCoverChange = (e) => {
            if (e.target.files.length) {
                const file = e.target.files[0];
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        newPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                } else {
                    showNotification('Please select an image file', 'error');
                    newCoverInput.value = '';
                }
            }
        };
        
        newOverlay.addEventListener('click', handleCoverUploadClick);
        newCoverInput.addEventListener('change', handleCoverChange);
    }
}


