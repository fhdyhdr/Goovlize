function toggleArtist(artistId, artistName) {
    const index = selectedArtists.findIndex(a => a.id === artistId);
    
    if (index === -1) {
        // Add artist dengan role default 'main'
        selectedArtists.push({ 
            id: artistId, 
            name: artistName,
            role: 'main' // Default role
        });
        updateArtistTags();
        updateArtistOption(artistId, true);
        
        // Hilangkan pesan error album jika ada
        hideAlbumErrorMessage();
        
        // Update album options berdasarkan artist yang dipilih
        populateAlbumOptions(true);
    } else {
        // Remove artist
        selectedArtists.splice(index, 1);
        updateArtistTags();
        updateArtistOption(artistId, false);
        
        // Update album options
        if (selectedArtists.length > 0) {
            populateAlbumOptions(true);
        } else {
            populateAlbumOptions(false);
            // Jika album yang dipilih dibuat oleh artist yang dihapus, hapus juga album
            if (selectedAlbum) {
                const albumArtistId = albumsData.find(a => a.id_al === selectedAlbum.id)?.id_artist;
                if (albumArtistId === artistId) {
                    removeAlbum();
                }
            }
        }
    }
    
    updateArtistSearchInput();
}

