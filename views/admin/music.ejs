// ================================== DELETE MUSIC ========================================== //






let musicToDelete = {
    id: null,
    title: null,
    artists: null,
    album: null,
    plays: null,
    dateAdded: null,
    cover: null
};

// Function to open delete confirmation
function deleteMusic(musicId, musicTitle) {
    // Get the music item element
    const musicItem = document.querySelector(`.music-item[data-id="${musicId}"]`);
    if (!musicItem) return;
    
    // Get music details
    const artist = musicItem.querySelector('.music-artist').textContent;
    const album = musicItem.querySelector('.music-album').textContent;
    const plays = musicItem.querySelector('.music-plays').textContent.trim();
    const dateAdded = musicItem.querySelector('.music-details p').textContent.split('Added ')[1];
    const cover = musicItem.querySelector('.music-cover img').src;
    
    // Store music data
    musicToDelete = {
        id: musicId,
        title: musicTitle,
        artists: artist,
        album: album,
        plays: plays,
        dateAdded: dateAdded,
        cover: cover
    };
    
    // Update popup content
    document.getElementById('deleteConfirmTitle').textContent = `Delete "${musicTitle}"`;
    document.getElementById('deleteConfirmMessage').textContent = `Are you sure you want to delete "${musicTitle}"? This action cannot be undone.`;
    
    // Update details section
    const detailsContainer = document.getElementById('deleteDetails');
    detailsContainer.innerHTML = `
        <div class="delete-detail-item">
            <div class="delete-detail-icon">
                <i class="fas fa-user"></i>
            </div>
            <div class="delete-detail-content">
                <div class="delete-detail-title">Artist</div>
                <div class="delete-detail-value">${artist || 'No artist'}</div>
            </div>
        </div>
        <div class="delete-detail-item">
            <div class="delete-detail-icon">
                <i class="fas fa-compact-disc"></i>
            </div>
            <div class="delete-detail-content">
                <div class="delete-detail-title">Album</div>
                <div class="delete-detail-value">${album || 'No album'}</div>
            </div>
        </div>
        <div class="delete-detail-item">
            <div class="delete-detail-icon">
                <i class="fas fa-play"></i>
            </div>
            <div class="delete-detail-content">
                <div class="delete-detail-title">Total Plays</div>
                <div class="delete-detail-value">${plays}</div>
            </div>
        </div>
        <div class="delete-detail-item">
            <div class="delete-detail-icon">
                <i class="fas fa-calendar"></i>
            </div>
            <div class="delete-detail-content">
                <div class="delete-detail-title">Date Added</div>
                <div class="delete-detail-value">${dateAdded}</div>
            </div>
        </div>
    `;
    
    // Show popup
    openDeletePopup();
}

// Function to open delete popup
function openDeletePopup() {
    const popup = document.querySelector('.deleteConfirmPopup');
    const popupContent = popup.querySelector('.popup-content');
    const isMobile = isTrueMobile();
    
    if (isMobile) {
        popup.style.display = 'block';
        setTimeout(() => {
            popup.classList.add('active');
            if (popupContent) {
                popupContent.style.transform = 'translateY(0)';
            }
        }, 10);
    } else {
        $(".deleteConfirmPopup").show();
        $(".deleteConfirmPopup").addClass("active");
        $(".deleteConfirmPopup .popup-overlay").removeClass("fadeOut").addClass("fadeIn");
    }
    
    // Focus on cancel button for accessibility
    setTimeout(() => {
        document.querySelector('.deleteConfirmPopup .btn-secondary').focus();
    }, 100);
}

// Function to close delete popup
function closeDeletePopup() {
    const popup = document.querySelector('.deleteConfirmPopup');
    const popupOverlay = popup.querySelector('.popup-overlay');
    const popupContent = popup.querySelector('.popup-content');
    
    // Mulai animasi keluar
    popup.classList.remove('active');
    popupOverlay.classList.remove('fadeIn');
    popupOverlay.classList.add('fadeOut');
    
    // Jika mobile, animasi slide down
    if (isTrueMobile() && popupContent) {
        popupContent.style.transform = 'translateY(100%)';
    }
    
    setTimeout(() => {
        popup.style.display = 'none';
        musicToDelete = { id: null, title: null, artists: null, album: null, plays: null };
    }, 300);
}

async function confirmDelete() {
    if (!musicToDelete.id) return;
    
    try {
        // Send delete request to server
        const response = await fetch(`/admin/music/delete/${musicToDelete.id}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Show success notification
            showNotification(`"${musicToDelete.title}" has been deleted successfully`, 'success');
            
            // Close popup
            closeDeletePopup();
            
            // Remove music item from list
            const musicItem = document.querySelector(`.music-item[data-id="${musicToDelete.id}"]`);
            if (musicItem) {
                // Add removal animation
                musicItem.style.transition = 'all 0.3s ease';
                musicItem.style.transform = 'translateX(-100%)';
                musicItem.style.opacity = '0';
                
                setTimeout(() => {
                    musicItem.remove();
                    
                    // Update music count
                    updateMusicCountAfterDelete();
                    
                    // Update playlist if music player is active
                    if (musicPlayer && musicPlayer.currentMusicId === musicToDelete.id) {
                        musicPlayer.stop();
                        musicPlayer.cleanupAudio();
                        closeMusicPlayer();
                    }
                }, 300);
            } else {
                // If item not found in current view, reload page
                window.location.reload();
            }
        } else {
            // Show error notification
            showNotification(result.message || 'Failed to delete music', 'error');
        }
    } catch (error) {
        console.error('Error deleting music:', error);
        showNotification('Failed to delete music. Please try again.', 'error');
    }
}


// Function to update music count after deletion
function updateMusicCountAfterDelete() {
    const musicItems = document.querySelectorAll('.music-item');
    const totalMusic = musicItems.length;
    
    // Update total count in pagination
    const totalItemsSpan = document.getElementById('totalItems');
    if (totalItemsSpan) {
        totalItemsSpan.textContent = totalMusic;
    }
    
    // Update pagination info
    const paginationInfo = document.querySelector('.pagination-info');
    if (paginationInfo && totalItemsSpan) {
        const startItem = parseInt(paginationInfo.querySelector('#startItem').textContent) || 1;
        const endItem = Math.min(startItem + musicItems.length - 1, totalMusic);
        
        paginationInfo.innerHTML = `
            Showing <span id="startItem">${startItem}</span>-<span id="endItem">${endItem}</span> 
            of <span id="totalItems">${totalMusic}</span> songs
        `;
    }
    
    // Show empty state if no music left
    if (totalMusic === 0) {
        const musicListBody = document.getElementById('musicList');
        musicListBody.innerHTML = `
            <div class="no-music-found">
                <i class="fas fa-music"></i>
                <p>No music found</p>
            </div>
        `;
    }
}







// ============ GENRE FUNCTIONS ============ //


function selectGenre(genreId, genreName) {
  selectedGenre = { id: genreId, name: genreName };
  updateGenreTag();
  updateGenreOption(genreId);
  
  // Update search input
  document.getElementById('genreSearch').value = genreName;
  document.getElementById('genreOptions').classList.remove('active');
  activeDropdown = null;
}

// Fungsi untuk update genre tag display
function updateGenreTag() {
  const tagContainer = document.getElementById('genreTag');
  tagContainer.innerHTML = '';
  
  if (selectedGenre) {
    const tag = document.createElement('div');
    tag.className = 'selected-tag';
    tag.innerHTML = `
      ${selectedGenre.name}
      <span class="tag-remove" onclick="removeGenre()">
        <i class="fas fa-times"></i>
      </span>
    `;
    tagContainer.appendChild(tag);
  }
}

function updateGenreOption(genreId, selected) {
    const option = document.querySelector(`#genreOptions .select-option[data-value="${genreId}"]`);
    if (option) {
        option.classList.toggle('selected', selected);
    }
}

// Fungsi untuk remove genre
function removeGenre(genreId) {
    selectedGenres = selectedGenres.filter(g => g.id !== genreId);
    updateGenreTags();
    updateGenreOption(genreId, false);
    
    if (activeDropdown === 'genreOptions') {
        document.getElementById('genreOptions').classList.remove('active');
        activeDropdown = null;
    }
}

// Fungsi untuk populate genre options dari data yang ada
function populateGenreOptions() {
    const genreOptions = document.getElementById('genreOptions');
    genreOptions.innerHTML = '';
    
    console.log('Populating genre options. Total genres:', genresData.length);
    
    if (genresData && genresData.length > 0) {
        genresData.forEach(genre => {
            const isSelected = selectedGenres.some(g => g.id == genre.id_genre);
            const option = document.createElement('div');
            option.className = 'select-option genre-option';
            if (isSelected) option.classList.add('selected');
            option.dataset.value = genre.id_genre;
            option.dataset.name = genre.genre_name;
            option.innerHTML = `
                <i class="fas fa-check option-check"></i>
                ${genre.genre_name}
            `;
            option.onclick = () => toggleGenre(genre.id_genre, genre.genre_name);
            genreOptions.appendChild(option);
        });
    } else {
        genreOptions.innerHTML = `
            <div class="select-option no-data">
                No genres found
            </div>
        `;
    }
}

