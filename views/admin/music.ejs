async function addNewAlbumForEdit() {
    const newName = document.getElementById('editNewAlbumName').value.trim();
    if (!newName) {
        showEditAlbumErrorMessage('Please enter album name');
        return;
    }
    
    if (editSelectedArtists.length === 0) {
        showEditAlbumErrorMessage('Please select at least one artist first');
        return;
    }
    
    // SELALU gunakan artist pertama yang dipilih
    const selectedArtistId = editSelectedArtists[0].id;
    const selectedArtistName = editSelectedArtists[0].name;
    
    // Jika lebih dari 1 artist dipilih, tampilkan alert seperti di add music
    if (editSelectedArtists.length > 1) {
        const message = `You have selected ${editSelectedArtists.length} artists.\n\nAlbum will be created for "${selectedArtistName}" only.\n\nOther selected artists will be ignored for this album.\n\nDo you want to continue?`;
        
        // Hapus confirm dialog dan ganti dengan alert
        const confirmed = confirm(message);
        
        if (!confirmed) {
            return;
        }
    }
    
    try {
        const response = await fetch('/admin/music/add-album', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ 
                album_name: newName, 
                id_artist: selectedArtistId 
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Clear and hide input
            cancelNewAlbumForEdit();
            
            // Hilangkan pesan error jika ada
            hideEditAlbumErrorMessage();
            
            // Refresh data album dari server
            await loadArtistAndAlbumDataForEdit();
            
            // Select the new album
            selectEditAlbum(result.album.id_al, result.album.album_name);
            
            // Tampilkan notifikasi sukses
            showNotification('Album added successfully!', 'success');
            
            // Sembunyikan pesan info
            hideEditAlbumInfoMessage();
        } else {
            showEditAlbumErrorMessage(result.message || 'Failed to add album');
        }
    } catch (error) {
        console.error('Error adding album:', error);
        showEditAlbumErrorMessage('Failed to add album. Please try again.');
    }
}


async function submitEditMusic(event) {
    event.preventDefault();
    
    // Hilangkan semua pesan error sebelumnya
    hideEditAlbumErrorMessage();
    hideEditArtistErrorMessage();
    document.getElementById('editTitleError').textContent = '';
    document.getElementById('editGenreError').textContent = '';
    
    // Validation
    const title = document.getElementById('editMusicTitle').value.trim();
    if (!title) {
        document.getElementById('editTitleError').textContent = 'Title is required';
        return false;
    }
    
    if (editSelectedArtists.length === 0) {
        showEditAlbumErrorMessage('Please select at least one artist');
        return false;
    }
    
    if (editSelectedGenres.length === 0) {
        document.getElementById('editGenreError').textContent = 'Please select at least one genre';
        return false;
    }
    
    // Prepare form data
    const formData = new FormData();
    formData.append('music_id', document.getElementById('editMusicId').value);
    formData.append('title', title);
    formData.append('lyrics', document.getElementById('editMusicLyrics').value);
    
    // Add artists as JSON string (termasuk role) - UPDATE INI
    const artistsData = editSelectedArtists.map(artist => ({
        id: artist.id,
        name: artist.name,
        role: artist.role || 'main' // Kirim role ke server
    }));
    formData.append('artists', JSON.stringify(artistsData));
    
    // Add genres as JSON string
    const genresData = editSelectedGenres.map(genre => ({
        id: genre.id,
        name: genre.name
    }));
    formData.append('genres', JSON.stringify(genresData));
    
    // Add album if selected
    if (editSelectedAlbum) {
        formData.append('album_id', editSelectedAlbum.id);
        formData.append('album_name', editSelectedAlbum.name);
    }
    
    // Add cover image if changed
    const coverFile = document.getElementById('editCoverUpload').files[0];
    if (coverFile) {
        formData.append('cover', coverFile);
    }
    
    // Add audio file if changed
    const audioFile = document.getElementById('editAudioFile').files[0];
    if (audioFile) {
        formData.append('audio', audioFile);
    }
    
    try {
        const response = await fetch('/admin/music/update', {
            method: 'POST',
            body: formData
        });
        
        const result = await response.json();
        
        if (result.success) {
            showNotification('Music updated successfully!', 'success');
            closeEditPopup();
            
            window.location.reload();
            
        } else {
            showNotification(result.message || 'Failed to update music', 'error');
        }
    } catch (error) {
        console.error('Error updating music:', error);
        showNotification('Failed to update music. Please try again.', 'error');
    }
    
    return false;
}


