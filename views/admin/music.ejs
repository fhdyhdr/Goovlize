  position: relative;
  width: 200px;
  height: 200px;
  margin: 0 auto 30px;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.player-album-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.album-cover-spin {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1));
  animation: spin 20s linear infinite;
  opacity: 0.3;
  display: none;
}

.album-cover-spin.playing {
  display: block;
}

.spin-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40px;
  height: 40px;
  background: #1a1a1a;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.2);
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Song Info */
.player-song-info {
  text-align: center;
  margin-bottom: 30px;
}

.player-song-info h2 {
  margin: 0 0 10px 0;
  font-size: 22px;
  color: #fff;
  font-weight: 600;
  line-height: 1.3;
}

.player-song-info p {
  margin: 0;
  color: #888;
  font-size: 15px;
}

/* Progress Bar */
.player-progress {
  margin-bottom: 30px;
}

.progress-time {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  color: #888;
  font-size: 13px;
  font-weight: 500;
}

.progress-bar-container {
  position: relative;
  height: 4px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  cursor: pointer;
}

.progress-bar {
  position: relative;
  height: 100%;
  width: 100%;
}

.progress-fill {
  position: absolute;
  height: 100%;
  background: #1db954;
  border-radius: 2px;
  width: 0%;
  transition: width 0.1s linear;
}

.progress-handle {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 12px;
  height: 12px;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  opacity: 0;
  transition: opacity 0.2s;
}

.progress-bar-container:hover .progress-handle {
  opacity: 1;
}

/* Controls */
.player-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 25px;
}

.control-btn {
  background: transparent;
  border: none;
  color: #fff;
  font-size: 20px;
  cursor: pointer;
  padding: 12px;
  border-radius: 50%;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(1.1);
}

.control-btn.play-btn {
  width: 60px;
  height: 60px;
  background: #1db954;
  font-size: 24px;
}

.control-btn.play-btn:hover {
  background: #1ed760;
  transform: scale(1.1);
}

.control-btn.play-btn i.fa-pause {
  position: relative;
  left: -1px;
}

/* Volume Control */
.player-volume {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.volume-btn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  cursor: pointer;
  padding: 8px;
  border-radius: 50%;
  transition: all 0.2s;
}

.volume-btn:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
}

.volume-slider-container {
  flex: 1;
  position: relative;
  height: 4px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  cursor: pointer;
}

.volume-slider {
  position: relative;
  height: 100%;
  width: 100%;
}

.volume-fill {
  position: absolute;
  height: 100%;
  background: #1db954;
  border-radius: 2px;
  width: 80%;
}

.volume-handle {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 12px;
  height: 12px;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  opacity: 0;
  transition: opacity 0.2s;
}

.volume-slider-container:hover .volume-handle {
  opacity: 1;
}

/* Queue */
.player-queue {
  padding: 20px 25px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(0, 0, 0, 0.2);
}

.player-queue h4 {
  margin: 0 0 15px 0;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
}

.queue-list {
  max-height: 150px;
  overflow-y: auto;
}

.queue-item {
  display: flex;
  align-items: center;
  padding: 10px;
  border-radius: 8px;
  margin-bottom: 8px;
  background: rgba(255, 255, 255, 0.05);
  cursor: pointer;
  transition: all 0.2s;
}

.queue-item:hover {
  background: rgba(255, 255, 255, 0.1);
}

.queue-item.active {
  background: rgba(29, 185, 84, 0.2);
  border-left: 3px solid #1db954;
}

.queue-item-cover {
  width: 40px;
  height: 40px;
  border-radius: 6px;
  overflow: hidden;
  margin-right: 12px;
  flex-shrink: 0;
}

.queue-item-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.queue-item-info {
  flex: 1;
  min-width: 0;
}

.queue-item-title {
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.queue-item-artist {
  color: #888;
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.queue-item-duration {
  color: #888;
  font-size: 12px;
  margin-left: 10px;
  flex-shrink: 0;
}

/* Responsive adjustments for music player */
@media (max-width: 768px) {
  .player-album-cover {
    width: 150px;
    height: 150px;
  }
  
  .player-song-info h2 {
    font-size: 18px;
  }
  
  .player-controls {
    gap: 15px;
  }
  
  .control-btn.play-btn {
    width: 50px;
    height: 50px;
    font-size: 20px;
  }
  
  /* Untuk mobile, sembunyikan queue section */
  .player-queue {
    display: none;
  }
}

@media (max-height: 700px) {
  .player-album-cover {
    width: 120px;
    height: 120px;
    margin-bottom: 20px;
  }
  
  .player-song-info {
    margin-bottom: 20px;
  }
  
  .player-progress {
    margin-bottom: 20px;
  }
}

.filter-select {
    appearance: none;
}


/* Di dalam style section */
.music-genre {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
}

.genre-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
}

.genre-pop { background: rgba(107, 141, 227, 0.2); color: #6B8DE3; }
.genre-rock { background: rgba(125, 28, 141, 0.2); color: #7D1C8D; }
.genre-hiphop { background: rgba(16, 185, 129, 0.2); color: #10B981; }
.genre-electronic { background: rgba(245, 158, 11, 0.2); color: #F59E0B; }
.genre-jazz { background: rgba(239, 68, 68, 0.2); color: #EF4444; }
.genre-rnb { background: rgba(168, 85, 247, 0.2); color: #A855F7; }
.genre-classical { background: rgba(59, 130, 246, 0.2); color: #3B82F6; }
.genre-country { background: rgba(34, 197, 94, 0.2); color: #22C55E; }
.genre-blues { background: rgba(99, 102, 241, 0.2); color: #6366F1; }
.genre-other { background: rgba(156, 163, 175, 0.2); color: #9CA3AF; }

.genre-more {
    font-size: 10px;
    color: var(--text-secondary);
    cursor: help;
    margin-left: 2px;
}

/* Responsive */
@media (max-width: 768px) {
    .music-genre {
        display: none; /* Sembunyikan di mobile untuk hemat space */
    }
}



.role-select {
    background-color: #1a1a1a;
    border: 1px solid #444;
    border-radius: 4px;
    color: white;
    padding: 4px 8px;
    font-size: 12px;
    cursor: pointer;
    min-width: 70px;
}

.role-select:focus {
    outline: none;
    border-color: #1db954;
}





















/* CSS untuk role badge dengan singkatan ft saja */
.artist-role-badge {
    display: inline-block;
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-left: 4px;
    vertical-align: middle;
    line-height: 1;
    min-width: 14px;
    text-align: center;
}

/* Style untuk main artist - tanpa badge */
.main-artist {
    color: #fff;
    font-weight: 500;
}

/* Style untuk feat artist dengan badge ft */
.feat-artist {
    color: #ccc;
}

.feat-artist .artist-role-badge.short-ft {
    background-color: #6366F1;
    color: white;
    border: 1px solid rgba(99, 102, 241, 0.5);
}

/* Hover effect untuk badge ft */
.artist-role-badge:hover {
    transform: scale(1.1);
    transition: transform 0.2s ease;
    background-color: #4F46E5 !important; /* Warna lebih gelap saat hover */
}

/* Tooltip styling untuk badge ft */
.artist-role-badge[title]:hover::after {
    content: attr(title);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    white-space: nowrap;
    z-index: 1000;
    margin-bottom: 5px;
}

.artist-role-badge {
    position: relative;
    cursor: help;
}

/* Responsive design */
@media (max-width: 768px) {
    .artist-role-badge {
        padding: 1px 3px;
        font-size: 8px;
        margin-left: 2px;
        min-width: 12px;
    }
    
    .music-artist-with-role {
        font-size: 13px;
    }
    
    .main-artist {
        font-size: 14px;
    }
    
    .feat-artist {
        font-size: 13px;
    }
}

/* Container untuk artists */
.music-artist {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
}

.music-artist-with-role {
    display: inline-flex;
    align-items: center;
    margin-right: 8px;
    padding: 2px 0;
}

/* Alternatif: badge ft dengan style berbeda */
.short-ft {
    background: linear-gradient(135deg, #6366F1, #4F46E5);
    box-shadow: 0 2px 4px rgba(99, 102, 241, 0.3);
    border-radius: 4px;
    padding: 1px 6px;
    font-weight: 800;
    letter-spacing: 0.5px;
}


