// Variables untuk edit popup
let editSelectedArtists = [];
let editSelectedAlbum = null;
let editSelectedGenres = [];
let editArtistsData = [];
let editAlbumsData = [];
let editGenresData = [];

async function editMusic(musicId) {
    try {
        const popup = document.querySelector('.editMusicPopup');
        const popupContent = popup.querySelector('.popup-content');
        var isMobile = isTrueMobile();

        // Reset form dan event listeners
        resetEditForm();
        
        // Clear existing event listeners
        clearEditEventListeners();
        
        // Set music ID
        document.getElementById('editMusicId').value = musicId;
        
        // Load data musik dari server
        await loadMusicDataForEdit(musicId);
        
        // Load data artist dan album
        await loadArtistAndAlbumDataForEdit();
        
        // Setup event listeners
        setupEditEventListeners();
        
        // Setup search input clearing
        setupSearchInputClearing();

        // Show popup
        if (isMobile) {
            popup.style.display = 'block';
            setTimeout(() => {
                popup.classList.add('active');
                if (popupContent) {
                    popupContent.style.transform = 'translateY(0)';
                }
            }, 10);
        } else {
            $(".editMusicPopup").show();
            $(".editMusicPopup").addClass("active");
            $(".editMusicPopup .popup-overlay").removeClass("fadeOut").addClass("fadeIn");
        }

    } catch (error) {
        console.error('Error opening edit popup:', error);
        showNotification('Failed to load music data for editing', 'error');
        closeEditPopup();
    }
}


async function loadMusicDataForEdit(musicId) {
    try {
        const response = await fetch(`/admin/music/get/${musicId}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        if (!response.ok) {
            throw new Error('Failed to fetch music data');
        }
        
        const data = await response.json();
        
        if (data.success) {
            const music = data.music;
            
            // Isi form dengan data yang ada
            document.getElementById('editMusicTitle').value = music.title_music || '';
            document.getElementById('editMusicLyrics').value = music.lyric || '';
            document.getElementById('editCoverPreview').src = music.cover_music || '/uploads/undefine.jpg';
            
            // Update character counters
            document.getElementById('editTitleCounter').textContent = music.title_music?.length || 0;
            document.getElementById('editLyricsCounter').textContent = music.lyric?.length || 0;
            
            // Set selected artists dengan role - URUTKAN: main dulu, kemudian feat
            if (music.artists && Array.isArray(music.artists)) {
                // Urutkan artist: main dulu, kemudian feat
                const sortedArtists = [...music.artists].sort((a, b) => {
                    // Jika a main dan b bukan main, a lebih dulu
                    if (a.role === 'main' && b.role !== 'main') return -1;
                    // Jika b main dan a bukan main, b lebih dulu
                    if (b.role === 'main' && a.role !== 'main') return 1;
                    // Jika sama, pertahankan urutan asli
                    return 0;
                });
                
                editSelectedArtists = sortedArtists.map(artist => ({
                    id: artist.id_artist,
                    name: artist.artist_name,
                    role: artist.role || 'main'
                }));
                
                updateEditArtistTags();
            }
            
            // Set selected album
            if (music.album && music.album.id_al) {
                editSelectedAlbum = {
                    id: music.album.id_al,
                    name: music.album.album_name
                };
                updateEditAlbumTag();
            }
            
            // Set selected genres
            if (music.genres && Array.isArray(music.genres)) {
                editSelectedGenres = music.genres.map(genre => ({
                    id: genre.id_genre,
                    name: genre.genre_name
                }));
                updateEditGenreTags();
            }
            
            // Show current audio file info
            if (music.audio_file) {
                document.getElementById('currentAudioFileInfo').style.display = 'flex';
            }
            
        } else {
            throw new Error(data.message || 'Failed to load music data');
        }
        
    } catch (error) {
        console.error('Error loading music data:', error);
        throw error;
    }
}

async function loadArtistAndAlbumDataForEdit() {
    try {
        const response = await fetch('/admin/music/get-data', { // GANTI ENDPOINT
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        if (!response.ok) {
            throw new Error('Failed to load data');
        }
        
        const data = await response.json();
        
        if (data.success) {
            editArtistsData = data.artists || [];
            editAlbumsData = data.albums || [];
            editGenresData = data.genres || []; // TAMBAH INI
            
            // Populate dropdowns
            populateEditArtistOptions();
            populateEditAlbumOptions();
            populateEditGenreOptions(); // TAMBAH INI
        }
        
    } catch (error) {
        console.error('Error loading data for edit:', error);
    }
}

function setupEditEventListeners() {
    // Clear existing event listeners pertama
    clearEditEventListeners();
    
    // Setup genre search dengan handler function yang terpisah
    const editGenreSearch = document.getElementById('editGenreSearch');
    if (editGenreSearch) {
        const handleEditGenreSearch = function(e) {
            filterEditOptions('editGenreOptions', e.target.value);
        };
        
        const handleEditGenreFocus = function() {
            closeEditOtherDropdowns('editGenreOptions');
            document.getElementById('editGenreOptions').classList.add('active');
        };
        
        // Hapus event listener lama jika ada
        editGenreSearch.removeEventListener('input', handleEditGenreSearch);
        editGenreSearch.removeEventListener('focus', handleEditGenreFocus);
        
        // Tambah event listener baru
        editGenreSearch.addEventListener('input', handleEditGenreSearch);
        editGenreSearch.addEventListener('focus', handleEditGenreFocus);
        
        // Simpan referensi untuk bisa di-clear nanti
        editEventListeners.genreSearch = {
            input: handleEditGenreSearch,
            focus: handleEditGenreFocus
        };
    }

    // Artist search dengan handler function yang sama
    const artistSearch = document.getElementById('editArtistSearch');
    if (artistSearch) {
        const handleArtistSearchInput = (e) => filterEditOptions('editArtistOptions', e.target.value);
        const handleArtistFocusFunc = () => {
            closeEditOtherDropdowns('editArtistOptions');
            document.getElementById('editArtistOptions').classList.add('active');
        };
        
        // Hapus event listener lama
        artistSearch.removeEventListener('input', handleArtistSearchInput);
        artistSearch.removeEventListener('focus', handleArtistFocusFunc);
        
        // Tambah event listener baru
        artistSearch.addEventListener('input', handleArtistSearchInput);
        artistSearch.addEventListener('focus', handleArtistFocusFunc);
        
        // Simpan referensi
        editEventListeners.artistSearch = {
            input: handleArtistSearchInput,
            focus: handleArtistFocusFunc
        };
    }

    // Album search dengan handler function yang sama
    const albumSearch = document.getElementById('editAlbumSearch');
    if (albumSearch) {
        const handleAlbumSearchInput = (e) => filterEditOptions('editAlbumOptions', e.target.value);
        const handleAlbumFocusFunc = () => {
            closeEditOtherDropdowns('editAlbumOptions');
            document.getElementById('editAlbumOptions').classList.add('active');
        };
        
        // Hapus event listener lama
        albumSearch.removeEventListener('input', handleAlbumSearchInput);
        albumSearch.removeEventListener('focus', handleAlbumFocusFunc);
        
        // Tambah event listener baru
        albumSearch.addEventListener('input', handleAlbumSearchInput);
        albumSearch.addEventListener('focus', handleAlbumFocusFunc);
        
        // Simpan referensi
        editEventListeners.albumSearch = {
            input: handleAlbumSearchInput,
            focus: handleAlbumFocusFunc
        };
    }

    // Tambahkan event listener untuk menutup dropdown saat klik di luar
    const handleClickOutside = (e) => {
        // Cek apakah klik di luar custom-select-container di popup edit
        if (!e.target.closest('.editMusicPopup .custom-select-container') && 
            !e.target.closest('.editMusicPopup .add-new-option')) {
            closeAllEditDropdowns();
        }
    };
    
    // Hapus listener lama jika ada
    document.removeEventListener('click', handleClickOutside);
    // Tambah listener baru
    document.addEventListener('click', handleClickOutside);
    
    // Tambahan: Close dropdowns dengan Escape key
    const handleEscapeKey = (e) => {
        if (e.key === 'Escape') {
            closeAllEditDropdowns();
        }
    };
    
    document.removeEventListener('keydown', handleEscapeKey);
    document.addEventListener('keydown', handleEscapeKey);

    // Setup file upload handlers (tidak perlu perubahan di sini)
    setupEditFileUploadListeners();
    
    // Setup cover upload listeners
    setupEditCoverUploadListeners();
    
    // Setup character counters
