// Fungsi untuk add new artist via AJAX
async function addNewArtist() {
    const newName = document.getElementById('newArtistName').value.trim();
    if (!newName) {
        // Tampilkan pesan error dalam popup
        showArtistErrorMessage('Please enter artist name');
        return;
    }
    
    try {
        const response = await fetch('/admin/music/add-artist', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ artist_name: newName })
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Clear and hide input
            cancelNewArtist();
            
            // Tampilkan notifikasi sukses
            showNotification('Artist ' + (result.message === 'Artist already exists' ? 'already exists' : 'added successfully') + '!', 'success');
            
            // Refresh data artist dari server
            await refreshArtistsData();
            
            // Select the new artist hanya jika bukan duplicate
            if (result.artist && result.artist.id_artist) {
                // Cek dulu apakah artist sudah dipilih
                const alreadySelected = selectedArtists.some(a => a.id === result.artist.id_artist);
                if (!alreadySelected) {
                    toggleArtist(result.artist.id_artist, result.artist.artist_name);
                }
            }
        } else {
            showArtistErrorMessage(result.message || 'Failed to add artist');
        }
    } catch (error) {
        console.error('Error adding artist:', error);
        showArtistErrorMessage('Failed to add artist. Please try again.');
    }
}

