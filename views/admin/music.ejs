// Fungsi untuk handle audio file select
function handleAudioFileSelect(file) {
  const validTypes = ['.mp3', '.wav', '.flac', '.aac', '.m4a'];
  const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
  
  if (!validTypes.includes(fileExtension)) {
    document.getElementById('audioError').textContent = 'Invalid file type. Please upload an audio file (MP3, WAV, FLAC, AAC, M4A)';
    return;
  }
  
  const maxSize = 50 * 1024 * 1024;
  if (file.size > maxSize) {
    document.getElementById('audioError').textContent = 'File size exceeds 50MB limit';
    return;
  }
  
  document.getElementById('audioError').textContent = '';
  document.getElementById('audioFileName').textContent = file.name;
  document.getElementById('audioFileSize').textContent = formatFileSize(file.size);
  document.getElementById('audioFileInfo').style.display = 'block';
  document.getElementById('audioUploadArea').style.display = 'none';
}

// Fungsi untuk remove audio file
function removeAudioFile() {
  document.getElementById('audioFile').value = '';
  document.getElementById('audioFileInfo').style.display = 'none';
  document.getElementById('audioUploadArea').style.display = 'block';
  document.getElementById('audioError').textContent = '';
}

// Fungsi untuk format file size
function formatFileSize(bytes) {
  if (bytes === 0) return '0 Bytes';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}
async function submitAddMusic(event) {
    event.preventDefault();
    
    closeAllDropdowns();
    
    // Validation
    const title = document.getElementById('musicTitle').value.trim();
    if (!title) {
        document.getElementById('titleError').textContent = 'Title is required';
        return false;
    }
    
    if (selectedArtists.length === 0) {
        showEditAlbumErrorMessage('Please select at least one artist');
        return false;
    }
    
    if (selectedGenres.length === 0) {
        document.getElementById('genreError').textContent = 'Please select at least one genre';
        return false;
    }
    
    const audioFile = document.getElementById('audioFile').files[0];
    if (!audioFile) {
        document.getElementById('audioError').textContent = 'Audio file is required';
        return false;
    }
    
    // Prepare form data
    const formData = new FormData();
    formData.append('title', title);
    formData.append('lyrics', document.getElementById('musicLyrics').value);
    
    // Add artists as JSON string (termasuk role) - UPDATE INI
    const artistsData = selectedArtists.map(artist => ({
        id: artist.id,
        name: artist.name,
        role: artist.role || 'main' // Kirim role ke server
    }));
    formData.append('artists', JSON.stringify(artistsData));
    
    // Add genres as JSON string
    const genresData = selectedGenres.map(genre => ({
        id: genre.id,
        name: genre.name
    }));
    formData.append('genres', JSON.stringify(genresData));
    
    // Add album if selected
    if (selectedAlbum) {
        formData.append('album_id', selectedAlbum.id);
        formData.append('album_name', selectedAlbum.name);
    }
    
    // Add cover image
    const coverFile = document.getElementById('playlistCoverUpload').files[0];
    if (coverFile) {
        formData.append('cover', coverFile);
    }
    
    // Add audio file
    formData.append('audio', audioFile);
    
    // Kirim ke server
    try {
        const response = await fetch('/admin/music/add', {
            method: 'POST',
            body: formData
        });
        
        const result = await response.json();
        
        if (result.success) {
            showNotification('Music added successfully!', 'success');
            closePopup();
            window.location.reload();
            
        } else {
            showNotification(result.message || 'Failed to add music', 'error');
        }
    } catch (error) {
        console.error('Error adding music:', error);
        showNotification('Failed to add music. Please try again.', 'error');
    }
    
    return false;
}


