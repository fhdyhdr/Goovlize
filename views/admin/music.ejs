// Fungsi untuk remove artist
function removeArtist(artistId) {
    selectedArtists = selectedArtists.filter(a => a.id !== artistId);
    updateArtistTags();
    updateArtistOption(artistId, false);
    updateArtistSearchInput();
    
    // Update album options
    if (selectedArtists.length > 0) {
