// Hapus atau ubah event listener untuk maxlength
document.addEventListener('DOMContentLoaded', function() {
  const lyricsTextarea = document.getElementById('musicLyrics');
  const editLyricsTextarea = document.getElementById('editMusicLyrics');
  const lyricsCounter = document.getElementById('lyricsCounter');
  const editLyricsCounter = document.getElementById('editLyricsCounter');
  
  if (lyricsTextarea) {
    // Hapus batasan maxlength
    lyricsTextarea.removeAttribute('maxlength');
    
    // Update counter tanpa batasan
    lyricsTextarea.addEventListener('input', function() {
      const length = this.value.length;
      lyricsCounter.textContent = length;
      
      // Optional: Tampilkan warna jika terlalu panjang (tidak wajib)
      if (length > 1000) {
        lyricsCounter.style.color = '#ff6b6b';
      } else if (length > 500) {
        lyricsCounter.style.color = '#ffa726';
      } else {
        lyricsCounter.style.color = '';
      }
    });
    
    // Initialize counter
    lyricsCounter.textContent = lyricsTextarea.value.length;
  }
  
  if (editLyricsTextarea) {
    // Hapus batasan maxlength
    editLyricsTextarea.removeAttribute('maxlength');
    
    // Update counter tanpa batasan
    editLyricsTextarea.addEventListener('input', function() {
      const length = this.value.length;
      editLyricsCounter.textContent = length;
      
      // Optional: Tampilkan warna jika terlalu panjang (tidak wajib)
      if (length > 1000) {
        editLyricsCounter.style.color = '#ff6b6b';
      } else if (length > 500) {
        editLyricsCounter.style.color = '#ffa726';
      } else {
        editLyricsCounter.style.color = '';
      }
    });
    
    // Initialize counter
    editLyricsCounter.textContent = editLyricsTextarea.value.length;
  }
});


