<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Admin Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .error-container {
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            text-align: center;
            max-width: 500px;
            width: 90%;
        }

        .error-icon {
            font-size: 60px;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .error-title {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 24px;
        }

        .error-message {
            color: #7f8c8d;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .error-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-block;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-primary:hover {
            background: #2980b9;
        }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .btn-secondary:hover {
            background: #7f8c8d;
        }

        .admin-info {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            color: #7f8c8d;
            font-size: 14px;
        }

        @media (max-width: 480px) {
            .error-container {
                padding: 20px;
            }
            
            .error-actions {
                flex-direction: column;
            }
            
            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-icon">⚠️</div>
        
        <h1 class="error-title">Oops! Something went wrong</h1>
        
        <% if (message) { %>
            <p class="error-message"><%= message %></p>
        <% } else { %>
            <p class="error-message">An unexpected error occurred while processing your request.</p>
        <% } %>
        
        <div class="error-actions">
            <% if (admin) { %>
                <a href="/admin/dashboard" class="btn btn-primary">Back to Dashboard</a>
            <% } else { %>
                <a href="/admin/login" class="btn btn-primary">Go to Login</a>
            <% } %>
            <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
        </div>
        
        <% if (admin) { %>
            <div class="admin-info">
                <p>Logged in as: <strong><%= admin.email %></strong></p>
                <p>If the problem persists, please contact technical support.</p>
            </div>
        <% } %>
    </div>
</body>
</html>