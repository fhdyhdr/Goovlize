    <script>
        // Global variables
let tagsData = [];
let selectedTag = null;
let editTagsData = [];
let editSelectedTag = null;
let playlistToDelete = null;

// Filter variables
let currentFilters = {
    search: '',
    tag: 'all',
    page: 1
};
let filterTimeout = null;
let isFiltering = false;

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
    initializeFilters();
    setupEventListeners();
});

function setupEventListeners() {
    // Character counter for playlist name
    const playlistNameInput = document.getElementById('playlistName');
    if (playlistNameInput) {
        playlistNameInput.addEventListener('input', function() {
            document.getElementById('playlistNameCounter').textContent = this.value.length;
        });
    }

    // Edit playlist name character counter
    const editPlaylistNameInput = document.getElementById('editPlaylistName');
    if (editPlaylistNameInput) {
        editPlaylistNameInput.addEventListener('input', function() {
            document.getElementById('editPlaylistNameCounter').textContent = this.value.length;
        });
    }

    // Cover image upload
    const coverUpload = document.getElementById('playlistCoverUpload');
    const coverPreview = document.getElementById('playlistCoverPreview');
    const coverUploadOverlay = document.querySelector('.addPlaylistPopup .cover-upload-overlay');
    
    if (coverUpload && coverPreview && coverUploadOverlay) {
        coverUploadOverlay.addEventListener('click', () => coverUpload.click());
        
        coverUpload.addEventListener('change', function(e) {
            if (e.target.files.length) {
                const file = e.target.files[0];
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        coverPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            }
        });
    }

    // Edit cover image upload
    const editCoverUpload = document.getElementById('editPlaylistCoverUpload');
    const editCoverPreview = document.getElementById('editPlaylistCoverPreview');
    const editCoverUploadOverlay = document.querySelector('.editPlaylistPopup .cover-upload-overlay');
    
    if (editCoverUpload && editCoverPreview && editCoverUploadOverlay) {
        editCoverUploadOverlay.addEventListener('click', () => editCoverUpload.click());
        
        editCoverUpload.addEventListener('change', function(e) {
            if (e.target.files.length) {
                const file = e.target.files[0];
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        editCoverPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            }
        });
    }

    // Tag search event listeners
    const tagSearch = document.getElementById('tagSearch');
    if (tagSearch) {
        tagSearch.addEventListener('input', function(e) {
            filterTagOptions('tagOptions', e.target.value);
        });
        
        tagSearch.addEventListener('focus', function() {
            closeOtherDropdowns('tagOptions');
            document.getElementById('tagOptions').classList.add('active');
        });
    }

    const editTagSearch = document.getElementById('editTagSearch');
    if (editTagSearch) {
        editTagSearch.addEventListener('input', function(e) {
            filterTagOptions('editTagOptions', e.target.value);
        });
        
        editTagSearch.addEventListener('focus', function() {
            closeOtherDropdowns('editTagOptions');
            document.getElementById('editTagOptions').classList.add('active');
        });
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.custom-select-container') && 
            !e.target.closest('.add-new-option')) {
            closeAllDropdowns();
        }
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeAllDropdowns();
        }
    });
}

// ============ ADD PLAYLIST ============ //
function addPlaylist() {
    const popup = document.querySelector('.addPlaylistPopup');
    const popupContent = popup.querySelector('.popup-content');
    var isMobile = isTrueMobile();

    // Reset form
    resetAddPlaylistForm();
    
    // Load tags data
    loadTagsData();

    if (isMobile) {
        popup.style.display = 'block';
        setTimeout(() => {
            popup.classList.add('active');
            if (popupContent) {
                popupContent.style.transform = 'translateY(0)';
            }
        }, 10);
    } else {
        $(".addPlaylistPopup").show();
        $(".addPlaylistPopup").addClass("active");
        $(".addPlaylistPopup .popup-overlay").removeClass("fadeOut").addClass("fadeIn");
    }
}

function resetAddPlaylistForm() {
    selectedTag = null;
    document.getElementById('playlistName').value = '';
    document.getElementById('playlistNameCounter').textContent = '0';
    document.getElementById('playlistNameError').textContent = '';
    document.getElementById('playlistCoverPreview').src = '/uploads/undefine.jpg';
    document.getElementById('playlistCoverUpload').value = '';
    document.getElementById('tagSearch').value = '';
    document.getElementById('tagTag').innerHTML = '';
    document.getElementById('addNewTag').style.display = 'none';
    document.getElementById('newTagName').value = '';
    hideTagMessage();
    closeAllDropdowns();
}

async function loadTagsData() {
    try {
        // Show loading state
        const tagOptions = document.getElementById('tagOptions');
        tagOptions.innerHTML = '<div class="select-option loading-option"><i class="fas fa-spinner fa-spin"></i> Loading tags...</div>';
        tagOptions.classList.add('active');

        const response = await fetch('/admin/playlist/get-tags', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        if (!response.ok) {
            throw new Error('Failed to load tags');
        }
        
        const data = await response.json();
        
        if (data.success) {
            tagsData = data.tags || [];
            populateTagOptions();
        } else {
            throw new Error(data.message || 'Failed to load tags');
        }
    } catch (error) {
        console.error('Error loading tags:', error);
        showTagErrorMessage('Failed to load tags. Please try again.');
        document.getElementById('tagOptions').innerHTML = `
            <div class="select-option error-option">
                <i class="fas fa-exclamation-circle"></i> Failed to load tags
            </div>
        `;
    }
}

function populateTagOptions() {
    const tagOptions = document.getElementById('tagOptions');
    tagOptions.innerHTML = '';
    
    if (tagsData && tagsData.length > 0) {
        tagsData.forEach(tag => {
            const isSelected = selectedTag && selectedTag.id === tag.id_tag;
            const option = document.createElement('div');
            option.className = 'select-option';
            if (isSelected) option.classList.add('selected');
            option.dataset.value = tag.id_tag;
            option.dataset.name = tag.tag_name;
            option.innerHTML = `
                <i class="fas fa-check option-check"></i>
                ${tag.tag_name}
            `;
            option.onclick = () => selectTag(tag.id_tag, tag.tag_name);
            tagOptions.appendChild(option);
        });
    } else {
        tagOptions.innerHTML = `
            <div class="select-option no-data">
                No tags found
            </div>
        `;
    }
    
    // Add "Add New Tag" option
    const newTagOption = document.createElement('div');
    newTagOption.className = 'select-option add-new-option';
