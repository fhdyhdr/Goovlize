async function loadPlaylistDataForEdit(playlistId) {
    try {
        console.log('Fetching playlist data for ID:', playlistId);
        
        const response = await fetch(`/admin/playlist/get/${playlistId}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        console.log('Response status:', response.status);
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        console.log('Playlist data received:', data);
        
        if (data.success) {
            const playlist = data.playlist;
            
            // Isi form dengan data yang ada
            document.getElementById('editPlaylistName').value = playlist.playlist_name || '';
            document.getElementById('editPlaylistCoverPreview').src = playlist.playlist_cover || '/uploads/undefine.jpg';
            
            // Update character counter
            document.getElementById('editPlaylistNameCounter').textContent = playlist.playlist_name?.length || 0;
            
            // Set selected tag
            if (playlist.id_tag) {
                editSelectedTag = {
                    id: playlist.id_tag,
                    name: playlist.tag_name || 'Untagged'
                };
                updateEditTagTag();
            } else {
                editSelectedTag = null;
                updateEditTagTag();
            }
            
            console.log('Form populated with playlist data');
            
        } else {
            throw new Error(data.message || 'Failed to load playlist data');
        }
        
    } catch (error) {
        console.error('Error loading playlist data:', error);
        throw error;
    }
}


