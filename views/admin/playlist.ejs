function populateEditTagOptions() {
    const tagOptions = document.getElementById('editTagOptions');
    tagOptions.innerHTML = '';
    
    if (editTagsData && editTagsData.length > 0) {
        editTagsData.forEach(tag => {
            const isSelected = editSelectedTag && editSelectedTag.id === tag.id_tag;
            const option = document.createElement('div');
            option.className = 'select-option';
            if (isSelected) option.classList.add('selected');
            option.dataset.value = tag.id_tag;
            option.dataset.name = tag.tag_name;
            option.innerHTML = `
                <i class="fas fa-check option-check"></i>
                ${tag.tag_name}
            `;
            option.onclick = () => selectEditTag(tag.id_tag, tag.tag_name);
            tagOptions.appendChild(option);
        });
    } else {
        tagOptions.innerHTML = `
            <div class="select-option no-data">
                No tags found
            </div>
        `;
    }
    
    // Add "Add New Tag" option
    const newTagOption = document.createElement('div');
    newTagOption.className = 'select-option add-new-option';
    newTagOption.innerHTML = '<i class="fas fa-plus"></i> Add New Tag';
    newTagOption.onclick = () => showNewTagInputForEdit();
    tagOptions.appendChild(newTagOption);
